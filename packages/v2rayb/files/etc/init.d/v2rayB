#!/bin/sh /etc/rc.common

START=99
STOP=10
EXTRA_COMMANDS="status running suspend resume recover"

CTL="/usr/libexec/v2rayB/v2rayBctl"
RUNTIME="/tmp/v2rayB"
PID_DIR="$RUNTIME/pids"
DNS_BACKUP="$RUNTIME/dnsmasq-before"
SUSPEND_PENDING="$RUNTIME/suspend-pending"
LOCK_DIR="$RUNTIME/lock"
DNSMASQ_SECTION='dhcp.@dnsmasq[0]'
DNSMASQ_DIR="/etc/dnsmasq.d"
MOSDNS_FORWARD_FILE="$DNSMASQ_DIR/90-v2rayB-mosdns.conf"
MOSDNS_FORWARD_EXPECTED="$RUNTIME/dnsmasq-mosdns-expected"
BOOTSTRAP_DNS_FILE="$DNSMASQ_DIR/90-v2rayB-bootstrap.conf"
BOOTSTRAP_DNS_EXPECTED="$RUNTIME/dnsmasq-bootstrap-expected"
SUBSCRIPTION_DNS_FILE="$DNSMASQ_DIR/89-v2rayB-subscriptions.conf"
SUBSCRIPTION_DNS_EXPECTED="$RUNTIME/dnsmasq-subscriptions-expected"
FORCE_PROXY_DNS_FILE="$DNSMASQ_DIR/88-v2rayB-force-proxy.conf"
FORCE_PROXY_DNS_EXPECTED="$RUNTIME/dnsmasq-force-proxy-expected"
LEGACY_FORCE_PROXY_FILE="$DNSMASQ_DIR/v2rayB-force-proxy.conf"
V2RAY_USER="${V2RAYB_V2RAY_USER:-nobody}"
V2RAY_GROUP="${V2RAYB_V2RAY_GROUP:-nogroup}"
V2RAY_BIN="${V2RAYB_V2RAY_BIN:-/usr/bin/v2ray}"
XRAY_BIN="${V2RAYB_XRAY_BIN:-/usr/bin/xray}"
HEALTH_PROBE_URL="${V2RAYB_HEALTH_PROBE_URL:-https://www.gstatic.com/generate_204}"
TPROXY_RULE_PREF=5642
TPROXY_ROUTE_TABLE=164
TPROXY_FWMARK=0x5642
LOCK_INHERITED=0

log() {
	logger -t v2rayB "$*"
}

mark_suspend_pending() {
	mkdir -p "$RUNTIME" || return 1
	: > "$SUSPEND_PENDING"
}

clear_suspend_pending() {
	rm -f "$SUSPEND_PENDING"
}

is_pid() {
	case "$1" in
		''|*[!0-9]*|0) return 1 ;;
		*) return 0 ;;
	esac
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

acquire_lock() {
	if [ "${V2RAYB_LOCK_HELD:-0}" = 1 ]; then
		LOCK_INHERITED=1
		return 0
	fi
	mkdir -p "$RUNTIME"
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		printf '%s\n' "$$" > "$LOCK_DIR/pid"
	export V2RAYB_LOCK_HELD=1
		return 0
	fi
	old_pid="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
	if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
		return 1
	fi
	rm -rf "$LOCK_DIR"
	mkdir "$LOCK_DIR" 2>/dev/null || return 1
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
	export V2RAYB_LOCK_HELD=1
}

release_lock() {
	[ "$LOCK_INHERITED" = 0 ] || return 0
	rm -rf "$LOCK_DIR"
	unset V2RAYB_LOCK_HELD 2>/dev/null || :
}

dnsmasq_ready() {
	n=0
	while [ "$n" -lt 20 ]; do
		if netstat -ln 2>/dev/null | grep -Eq '[:.]53[[:space:]]'; then
			return 0
		fi
		n=$((n + 1))
		sleep 1
	done
	return 1
}

dnsmasq_restart_config() {
	# conf-dir is not guaranteed to be reparsed by a HUP reload. Restart so
	# newly written nftset/server files take effect immediately, then wait for
	# the DNS socket before callers continue importing traffic policy.
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || return 1
	dnsmasq_ready
}

udp_tproxy_enabled() {
	[ -n "$(dns_policy_value transparent_proxy_udp_ports)" ]
}

udp_tproxy_cleanup() {
	command -v ip >/dev/null 2>&1 || return 0
	while ip rule del pref "$TPROXY_RULE_PREF" 2>/dev/null; do :; done
	while ip -6 rule del pref "$TPROXY_RULE_PREF" 2>/dev/null; do :; done
	ip route flush table "$TPROXY_ROUTE_TABLE" 2>/dev/null || :
	ip -6 route flush table "$TPROXY_ROUTE_TABLE" 2>/dev/null || :
	return 0
}

udp_tproxy_setup() {
	if ! udp_tproxy_enabled; then
		udp_tproxy_cleanup
		return 0
	fi
	command -v ip >/dev/null 2>&1 || {
		log "iproute2 is required for UDP transparent proxy"
		return 1
	}
	modprobe nft_tproxy >/dev/null 2>&1 || {
		log "nft_tproxy kernel module is unavailable"
		return 1
	}
	modprobe nf_socket_ipv4 >/dev/null 2>&1 || {
		log "nf_socket_ipv4 kernel module is unavailable"
		return 1
	}
	modprobe nf_socket_ipv6 >/dev/null 2>&1 || {
		log "nf_socket_ipv6 kernel module is unavailable"
		return 1
	}
	udp_tproxy_cleanup
	ip rule add pref "$TPROXY_RULE_PREF" fwmark "$TPROXY_FWMARK" lookup "$TPROXY_ROUTE_TABLE" || return 1
	ip route add local default dev lo table "$TPROXY_ROUTE_TABLE" || return 1
	ip -6 rule add pref "$TPROXY_RULE_PREF" fwmark "$TPROXY_FWMARK" lookup "$TPROXY_ROUTE_TABLE" || {
		udp_tproxy_cleanup
		return 1
	}
	ip -6 route add local default dev lo table "$TPROXY_ROUTE_TABLE" || {
		udp_tproxy_cleanup
		return 1
	}
}

apply_takeover_rules() {
	udp_tproxy_setup || return 1
	"$CTL" apply-nft || {
		udp_tproxy_cleanup
		return 1
	}
}

remove_legacy_force_proxy_rule() {
	[ -e "$LEGACY_FORCE_PROXY_FILE" ] || return 0
	normalized="$RUNTIME/legacy-force-proxy.normalized"
	expected="$RUNTIME/legacy-force-proxy.expected"
	tr -d '\r' < "$LEGACY_FORCE_PROXY_FILE" > "$normalized" 2>/dev/null || return 0
	cat > "$expected" <<'EOF'
# Google Play's China-market control endpoint must use the proxy even though
# its DNS answer belongs to a China IP range.
nftset=/services.googleapis.cn/4#inet#v2rayB#force_proxy

# Do not add xn--ngstr-lra8j.com here. Its mainland GGC download answers must
# remain direct and are already covered by the normal cn address set.
EOF
	if cmp -s "$normalized" "$expected"; then
		rm -f "$LEGACY_FORCE_PROXY_FILE" "$normalized" "$expected" || return 0
		dnsmasq_restart_config || :
		log "removed legacy force-proxy dnsmasq rule"
	else
		rm -f "$normalized" "$expected"
		log "refusing to remove modified $LEGACY_FORCE_PROXY_FILE"
	fi
}

uci_list_lines() {
	tr ' \t' '\n\n' | awk 'NF { print }'
}

load_dns_policy() {
	"$CTL" dns-settings > "$RUNTIME/dns-policy" || return 1
	[ -s "$RUNTIME/dns-policy" ]
}

dns_policy_value() {
	sed -n "s/^$1=//p" "$RUNTIME/dns-policy" | sed -n '1p'
}

write_mosdns_forward_expected() {
	mosdns_listen="$(dns_policy_value mosdns_listen)"
	mosdns_domains="$(dns_policy_value mosdns_domains)"
	[ -n "$mosdns_listen" ] && [ -n "$mosdns_domains" ] || return 1
	{
		printf '%s\n' '# Managed by v2rayB; removed when proxy mode stops.'
		printf '%s\n' "$mosdns_domains" | tr ',' '\n' | while IFS= read -r domain; do
			[ -n "$domain" ] || continue
			printf 'server=/%s/%s\n' "$domain" "$mosdns_listen"
		done
	} > "$MOSDNS_FORWARD_EXPECTED"
}

write_dns_domain_rules() {
	_dns_rule_domain="$1"
	_dns_rule_upstreams="$2"
	case "$_dns_rule_domain" in
		''|*[!A-Za-z0-9._-]*|.*|*.) return 0 ;;
	esac
	printf '%s\n' "$_dns_rule_upstreams" | tr ',' '\n' | while IFS= read -r _dns_rule_upstream; do
		_dns_rule_upstream="$(printf '%s' "$_dns_rule_upstream" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
		[ -n "$_dns_rule_upstream" ] || continue
		_dns_rule_server="$(printf '%s\n' "$_dns_rule_upstream" | sed 's/:\([0-9][0-9]*\)$/#\1/')"
		printf 'server=/%s/%s\n' "$_dns_rule_domain" "$_dns_rule_server"
	done
	printf 'nftset=/%s/4#inet#v2rayB#pass\n' "$_dns_rule_domain"
	printf 'nftset=/%s/6#inet#v2rayB#pass6\n' "$_dns_rule_domain"
}

direct_dns_upstreams() {
	_direct_dns_value="$(dns_policy_value direct_dns_upstreams)"
	[ -n "$_direct_dns_value" ] || _direct_dns_value="$(dns_policy_value direct_dns)"
	[ -n "$_direct_dns_value" ] || _direct_dns_value='223.5.5.5:53'
	printf '%s\n' "$_direct_dns_value"
}

write_bootstrap_dns_expected() {
	direct_dns="$(direct_dns_upstreams)"
	bootstrap_domain="$(dns_policy_value bootstrap_domain)"
	[ -n "$direct_dns" ] || return 1
	{
		printf '%s\n' '# Managed by v2rayB; removed when proxy mode stops.'
		write_dns_domain_rules "$bootstrap_domain" "$direct_dns"
	} > "$BOOTSTRAP_DNS_EXPECTED"
}

write_subscription_dns_expected() {
	direct_dns="$(direct_dns_upstreams)"
	subscription_domains="$(dns_policy_value subscription_domains)"
	[ -n "$direct_dns" ] || return 1
	{
		printf '%s\n' '# Managed by v2rayB; removed when proxy mode stops.'
		printf '%s\n' "$subscription_domains" | tr ',' '\n' | while IFS= read -r domain; do
			write_dns_domain_rules "$domain" "$direct_dns"
		done
	} > "$SUBSCRIPTION_DNS_EXPECTED"
}

write_force_proxy_dns_expected() {
	force_domains="$(dns_policy_value force_proxy_domains)"
	if [ -z "$force_domains" ]; then
		: > "$FORCE_PROXY_DNS_EXPECTED"
		return 0
	fi
	{
		printf '%s\n' '# Managed by v2rayB; removed when proxy mode stops.'
		printf '%s\n' "$force_domains" | tr ',' '\n' | while IFS= read -r domain; do
			[ -n "$domain" ] || continue
			printf 'nftset=/%s/4#inet#v2rayB#force_proxy4\n' "$domain"
			printf 'nftset=/%s/6#inet#v2rayB#force_proxy6\n' "$domain"
		done
	} > "$FORCE_PROXY_DNS_EXPECTED"
}

set_bootstrap_dns() {
	write_bootstrap_dns_expected || return 1
	write_subscription_dns_expected || return 1
	for rule in \
		"$BOOTSTRAP_DNS_FILE:$BOOTSTRAP_DNS_EXPECTED" \
		"$SUBSCRIPTION_DNS_FILE:$SUBSCRIPTION_DNS_EXPECTED"; do
		target="${rule%%:*}"
		expected="${rule#*:}"
		if [ -e "$target" ] && ! cmp -s "$target" "$expected"; then
			log "refusing to overwrite existing $target"
			return 1
		fi
		cp "$expected" "$target.tmp.$$" || return 1
		mv "$target.tmp.$$" "$target" || return 1
	done
}

capture_dnsmasq_baseline() {
	[ -f "$DNS_BACKUP/server" ] && return 0
	mkdir -p "$DNS_BACKUP" || return 1
	: > "$DNS_BACKUP/server" || { rm -rf "$DNS_BACKUP"; return 1; }
	: > "$DNS_BACKUP/noresolv" || { rm -rf "$DNS_BACKUP"; return 1; }
	uci -q get "${DNSMASQ_SECTION}.server" 2>/dev/null | uci_list_lines > "$DNS_BACKUP/server" || :
	uci -q get "${DNSMASQ_SECTION}.noresolv" > "$DNS_BACKUP/noresolv" 2>/dev/null || :
	[ -f "$DNS_BACKUP/server" ] && [ -f "$DNS_BACKUP/noresolv" ] || {
		rm -rf "$DNS_BACKUP"
		return 1
	}
	servers="$(cat "$DNS_BACKUP/server" 2>/dev/null || true)"
	noresolv="$(cat "$DNS_BACKUP/noresolv" 2>/dev/null || true)"
	if [ "$noresolv" = 1 ] && printf '%s\n' "$servers" | grep -Eq '^127\.0\.0\.1#535[34]$'; then
		printf '%s\n' 1 > "$DNS_BACKUP/stale"
	else
		printf '%s\n' 0 > "$DNS_BACKUP/stale"
	fi
}

set_proxy_dns() {
	load_dns_policy || return 1
	default_upstream="$(dns_policy_value dnsmasq_default)"
	mosdns_enabled="$(dns_policy_value mosdns_enabled)"
	[ -n "$default_upstream" ] || return 1
	uci -q show "$DNSMASQ_SECTION" >/dev/null 2>&1 || return 1
	[ -d "$DNSMASQ_DIR" ] || return 1
	[ "$(uci -q get "${DNSMASQ_SECTION}.confdir" 2>/dev/null || true)" = "$DNSMASQ_DIR" ] || {
		log "dnsmasq is not configured to read $DNSMASQ_DIR"
		return 1
	}
	if [ "$mosdns_enabled" = 1 ]; then
		write_mosdns_forward_expected || return 1
		if [ -e "$MOSDNS_FORWARD_FILE" ] && ! cmp -s "$MOSDNS_FORWARD_FILE" "$MOSDNS_FORWARD_EXPECTED"; then
			log "refusing to overwrite existing $MOSDNS_FORWARD_FILE"
			return 1
		fi
		cp "$MOSDNS_FORWARD_EXPECTED" "$MOSDNS_FORWARD_FILE.tmp.$$" || return 1
		mv "$MOSDNS_FORWARD_FILE.tmp.$$" "$MOSDNS_FORWARD_FILE" || return 1
		printf '%s\n' managed > "$RUNTIME/dnsmasq-mosdns-rule"
	else
		rm -f "$MOSDNS_FORWARD_EXPECTED"
	fi
	set_bootstrap_dns || return 1
	write_force_proxy_dns_expected || return 1
	if [ -z "$(dns_policy_value force_proxy_domains)" ]; then
		if [ -e "$FORCE_PROXY_DNS_FILE" ] && ! cmp -s "$FORCE_PROXY_DNS_FILE" "$FORCE_PROXY_DNS_EXPECTED"; then
			log "refusing to overwrite existing $FORCE_PROXY_DNS_FILE"
			return 1
		fi
		rm -f "$FORCE_PROXY_DNS_FILE" || return 1
	else
		if [ -e "$FORCE_PROXY_DNS_FILE" ] && ! cmp -s "$FORCE_PROXY_DNS_FILE" "$FORCE_PROXY_DNS_EXPECTED"; then
			log "refusing to overwrite existing $FORCE_PROXY_DNS_FILE"
			return 1
		fi
		cp "$FORCE_PROXY_DNS_EXPECTED" "$FORCE_PROXY_DNS_FILE.tmp.$$" || return 1
		mv "$FORCE_PROXY_DNS_FILE.tmp.$$" "$FORCE_PROXY_DNS_FILE" || return 1
	fi
	: > "$RUNTIME/proxy-server.expected"
	uci -q delete "${DNSMASQ_SECTION}.server" || true
	while IFS= read -r server; do
		case "$server" in
			/*/*)
				uci -q add_list "${DNSMASQ_SECTION}.server=$server" || return 1
				printf '%s\n' "$server" >> "$RUNTIME/proxy-server.expected"
				;;
		esac
	done < "$DNS_BACKUP/server"
	uci -q add_list "${DNSMASQ_SECTION}.server=$default_upstream" || return 1
	printf '%s\n' "$default_upstream" >> "$RUNTIME/proxy-server.expected"
	uci -q set "${DNSMASQ_SECTION}.noresolv=1" || return 1
	uci -q get "${DNSMASQ_SECTION}.server" 2>/dev/null | uci_list_lines > "$RUNTIME/proxy-server" || :
	uci -q get "${DNSMASQ_SECTION}.noresolv" > "$RUNTIME/proxy-noresolv" 2>/dev/null || :
	printf '%s\n' '1' > "$RUNTIME/proxy-noresolv.expected"
	cmp -s "$RUNTIME/proxy-server" "$RUNTIME/proxy-server.expected" || return 1
	cmp -s "$RUNTIME/proxy-noresolv" "$RUNTIME/proxy-noresolv.expected" || return 1
	uci commit dhcp || return 1
	dnsmasq_restart_config
}

restore_dnsmasq() {
	[ -f "$DNS_BACKUP/server" ] || {
		log "dnsmasq baseline backup is missing; refusing to stop local DNS safely"
		return 1
	}
	uci -q show "$DNSMASQ_SECTION" >/dev/null 2>&1 || return 1
	uci -q delete "${DNSMASQ_SECTION}.server" || true
	if [ -f "$DNS_BACKUP/stale" ] && [ "$(cat "$DNS_BACKUP/stale")" = 1 ]; then
		: > "$RUNTIME/restore-server.expected"
		while IFS= read -r server; do
			[ -n "$server" ] || continue
			case "$server" in
				127.0.0.1#5353|127.0.0.1#5354) continue ;;
			esac
			uci -q add_list "${DNSMASQ_SECTION}.server=$server" || return 1
			printf '%s\n' "$server" >> "$RUNTIME/restore-server.expected"
		done < "$DNS_BACKUP/server"
		uci -q delete "${DNSMASQ_SECTION}.noresolv" || true
		: > "$RUNTIME/restore-noresolv.expected"
	else
		while IFS= read -r server; do
			[ -n "$server" ] || continue
			uci -q add_list "${DNSMASQ_SECTION}.server=$server" || return 1
		done < "$DNS_BACKUP/server" 2>/dev/null || true
		cp "$DNS_BACKUP/server" "$RUNTIME/restore-server.expected" || return 1
		if [ -s "$DNS_BACKUP/noresolv" ]; then
			noresolv="$(sed -n '1p' "$DNS_BACKUP/noresolv")"
			uci -q set "${DNSMASQ_SECTION}.noresolv=$noresolv" || return 1
			cp "$DNS_BACKUP/noresolv" "$RUNTIME/restore-noresolv.expected" || return 1
		else
			uci -q delete "${DNSMASQ_SECTION}.noresolv" || true
			: > "$RUNTIME/restore-noresolv.expected"
		fi
	fi
	if [ -e "$MOSDNS_FORWARD_FILE" ]; then
		if [ ! -f "$MOSDNS_FORWARD_EXPECTED" ] || ! cmp -s "$MOSDNS_FORWARD_FILE" "$MOSDNS_FORWARD_EXPECTED"; then
			log "refusing to remove modified $MOSDNS_FORWARD_FILE"
			return 1
		fi
		rm -f "$MOSDNS_FORWARD_FILE" || return 1
	fi
	for rule in \
		"$FORCE_PROXY_DNS_FILE:$FORCE_PROXY_DNS_EXPECTED" \
		"$BOOTSTRAP_DNS_FILE:$BOOTSTRAP_DNS_EXPECTED" \
		"$SUBSCRIPTION_DNS_FILE:$SUBSCRIPTION_DNS_EXPECTED"; do
		target="${rule%%:*}"
		expected="${rule#*:}"
		if [ -e "$target" ]; then
			if [ -f "$expected" ] && cmp -s "$target" "$expected"; then
				rm -f "$target" || return 1
			elif [ "$target" = "$SUBSCRIPTION_DNS_FILE" ] &&
				[ "$(sed -n '1p' "$target" 2>/dev/null)" = '# Managed by v2rayB; removed when proxy mode stops.' ] &&
				! sed -n '2,$p' "$target" | grep -Eqv '^(server=/[A-Za-z0-9._:-]+/[A-Za-z0-9._:#-]+|nftset=/[A-Za-z0-9._:-]+/[46]#inet#v2rayB#pass6?)$'; then
				rm -f "$target" || return 1
			else
				log "refusing to remove modified $target"
				return 1
			fi
		fi
	done
	rm -f "$RUNTIME/dnsmasq-mosdns-rule" "$MOSDNS_FORWARD_EXPECTED" "$FORCE_PROXY_DNS_EXPECTED" "$BOOTSTRAP_DNS_EXPECTED" "$SUBSCRIPTION_DNS_EXPECTED"
	uci commit dhcp || {
		log "dnsmasq baseline could not be committed"
		return 1
	}
	dnsmasq_restart_config || {
		log "dnsmasq restart failed while restoring its baseline"
		return 1
	}
	uci -q show "$DNSMASQ_SECTION" >/dev/null 2>&1 || return 1
	uci -q get "${DNSMASQ_SECTION}.server" 2>/dev/null | uci_list_lines > "$RUNTIME/restore-server" || :
	uci -q get "${DNSMASQ_SECTION}.noresolv" > "$RUNTIME/restore-noresolv" 2>/dev/null || :
	cmp -s "$RUNTIME/restore-server" "$RUNTIME/restore-server.expected" || return 1
	cmp -s "$RUNTIME/restore-noresolv" "$RUNTIME/restore-noresolv.expected" || return 1
}

cleanup_legacy_procd() {
	output="$(ubus call service list '{"name":"v2rayB"}' 2>/dev/null)" || return 0
	printf '%s\n' "$output" | grep -q '"v2rayB"' || return 0
	ubus call service delete '{"name":"v2rayB"}' >/dev/null 2>&1 || return 1
}

process_alive() {
	pid="$(sed -n '1p' "$PID_DIR/$1.pid" 2>/dev/null || true)"
	is_pid "$pid" && kill -0 "$pid" 2>/dev/null
}

managed_processes_alive() {
	process_alive v2ray || return 1
	if [ -f "$PID_DIR/mosdns.pid" ]; then
		process_alive mosdns || return 1
	fi
}

stop_pid() {
	name="$1"
	pidfile="$PID_DIR/$name.pid"
	[ -f "$pidfile" ] || return 0
	pid="$(sed -n '1p' "$pidfile" 2>/dev/null || true)"
	if is_pid "$pid" && kill -0 "$pid" 2>/dev/null; then
		kill "$pid" 2>/dev/null || return 1
		n=0
		while kill -0 "$pid" 2>/dev/null; do
			[ "$n" -lt 10 ] || {
				kill -9 "$pid" 2>/dev/null || return 1
				break
			}
			n=$((n + 1))
			sleep 1
		done
	fi
	rm -f "$pidfile"
}

stop_instances() {
	cleanup_legacy_procd || return 1
	stop_pid watchdog || return 1
	stop_pid mosdns || return 1
	stop_pid v2ray || return 1
}

stop_engine_only() {
	stop_pid v2ray
}

port_ready() {
	port="$1"
	n=0
	while [ "$n" -lt 20 ]; do
		if netstat -ln 2>/dev/null | grep -Eq "[.:]${port}[[:space:]]"; then
			return 0
		fi
		n=$((n + 1))
		sleep 1
	done
	return 1
}

proxy_connected() {
	probe_port="$1"
	is_uint "$probe_port" || return 1
	command -v curl >/dev/null 2>&1 || return 1
	curl --socks5-hostname "127.0.0.1:$probe_port" \
		--fail --silent --show-error --output /dev/null \
		--connect-timeout 8 --max-time 15 "$HEALTH_PROBE_URL"
}

selected_engine() {
	_engine="$("$CTL" get-active-engine 2>/dev/null || printf v2ray)"
	case "$_engine" in
		v2ray|xray) printf '%s\n' "$_engine" ;;
		*) printf '%s\n' v2ray ;;
	esac
}

start_engine() {
	mkdir -p "$PID_DIR" || return 1
	max_fd="$(ulimit -Hn 2>/dev/null || true)"
	is_pid "$max_fd" && ulimit -n "$max_fd" 2>/dev/null || true
	engine_user="$V2RAY_USER"
	engine_group="$V2RAY_GROUP"
	if udp_tproxy_enabled; then
		# IP_TRANSPARENT is required by the TPROXY inbound. OpenWrt's
		# start-stop-daemon cannot grant CAP_NET_ADMIN to an unprivileged user.
		engine_user=root
		engine_group=root
	fi
	for log_name in v2ray.log v2ray-error.log; do
		touch "$RUNTIME/$log_name" || return 1
		chown "$engine_user:$engine_group" "$RUNTIME/$log_name" || return 1
		chmod 600 "$RUNTIME/$log_name" || return 1
	done
	rm -f "$PID_DIR/v2ray.pid"
	engine="$(selected_engine)"
	case "$engine" in
		xray)
			engine_bin="$XRAY_BIN"
			engine_env="XRAY_LOCATION_ASSET=/usr/share/v2ray"
			;;
		*)
			engine_bin="$V2RAY_BIN"
			engine_env="v2ray.local.asset=/usr/share/v2ray V2RAY_CONF_GEOLOADER=memconservative"
			;;
	esac
	[ -x "$engine_bin" ] || {
		log "selected engine binary is missing: $engine_bin"
		return 1
	}
	# shellcheck disable=SC2086
	if [ "$engine_user" = root ]; then
		env $engine_env start-stop-daemon -S -b \
			-x "$engine_bin" -O "$RUNTIME/v2ray.log" \
			-m -p "$PID_DIR/v2ray.pid" -- \
			run -c "$RUNTIME/active/v2ray.json" || return 1
	else
		env $engine_env start-stop-daemon -S -b -c "$engine_user:$engine_group" \
			-x "$engine_bin" -O "$RUNTIME/v2ray.log" \
			-m -p "$PID_DIR/v2ray.pid" -- \
			run -c "$RUNTIME/active/v2ray.json" || return 1
	fi
	is_pid "$(sed -n '1p' "$PID_DIR/v2ray.pid" 2>/dev/null || true)"
}

restart_engine() {
	stop_pid v2ray || return 1
	start_engine
}

prepare_engine_config_access() {
	[ -d "$RUNTIME/active" ] || return 1
	chown root:"$V2RAY_GROUP" "$RUNTIME/active" || return 1
	chmod 750 "$RUNTIME/active" || return 1
	[ -f "$RUNTIME/active/v2ray.json" ] || return 1
	chown root:"$V2RAY_GROUP" "$RUNTIME/active/v2ray.json" || return 1
	chmod 640 "$RUNTIME/active/v2ray.json" || return 1
}

start_mosdns() {
	mkdir -p "$PID_DIR" || return 1
	/usr/bin/mosdns start -c "$RUNTIME/active/mosdns.yaml" \
		>>"$RUNTIME/mosdns.log" 2>&1 &
	printf '%s\n' "$!" > "$PID_DIR/mosdns.pid"
}

start_watchdog() {
	[ "$("$CTL" get-setting watchdog_enabled 2>/dev/null || printf 0)" = 1 ] || return 0
	[ "$(dns_policy_value probe_enabled)" = 1 ] || return 0
	probe_port="$(dns_policy_value probe_port)"
	is_uint "$probe_port" || return 1
	mkdir -p "$PID_DIR" || return 1
	HEALTH_PROBE_PORT="$probe_port" /usr/bin/v2rayB-watchdog >>"$RUNTIME/watchdog.log" 2>&1 &
	printf '%s\n' "$!" > "$PID_DIR/watchdog.pid"
}

rollback_start() {
	final_state="${1:-normal}"
	case "$final_state" in normal|suspended) ;; *) final_state=normal ;; esac
	log "start failed; rolling back traffic and DNS imports"
	if [ -d "$DNS_BACKUP" ] && ! restore_dnsmasq; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "rollback paused: DNS baseline could not be restored; keeping local services alive"
		release_lock
		return 1
	fi
	if ! "$CTL" delete-nft >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "rollback paused: nftables rules could not be removed; keeping local services alive"
		release_lock
		return 1
	fi
	udp_tproxy_cleanup
	if [ "$final_state" = suspended ]; then
		if ! stop_pid mosdns; then
			"$CTL" set-state degraded >/dev/null 2>&1 || true
			log "rollback incomplete: MosDNS did not stop"
			release_lock
			return 1
		fi
	else
		if ! stop_instances; then
			"$CTL" set-state degraded >/dev/null 2>&1 || true
			log "rollback incomplete: managed processes did not stop"
			release_lock
			return 1
		fi
	fi
	if ! "$CTL" set-setting proxy_mode normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	if ! "$CTL" set-state "$final_state" >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	rm -rf "$RUNTIME/active"
	rm -rf "$DNS_BACKUP"
	release_lock
	return 1
}

start_service() {
	acquire_lock || return 1
	"$CTL" init-db >/dev/null 2>&1 || { release_lock; return 1; }
	remove_legacy_force_proxy_rule
	if [ "$("$CTL" get-setting service_enabled 2>/dev/null)" != 1 ]; then
		release_lock
		return 0
	fi
	current_state="$("$CTL" status 2>/dev/null | sed -n 's/^state=//p' | head -n1)"
	if [ "$current_state" = proxy ] && managed_processes_alive; then
		release_lock
		return 0
	fi
	if [ "$current_state" = suspended ]; then
		log "proxy is suspended; restart, reload, or resume is required"
		release_lock
		return 0
	fi
	if [ "$current_state" != normal ] || managed_processes_alive || [ -d "$DNS_BACKUP" ] || [ -f "$RUNTIME/nft-managed" ]; then
		release_lock
		stop_service || return 1
		start_service
		return $?
	fi
	"$CTL" set-state starting >/dev/null 2>&1 || { release_lock; return 1; }
	"$CTL" render-all || { rollback_start; return 1; }
	prepare_engine_config_access || { rollback_start; return 1; }
	"$CTL" test-v2ray || { rollback_start; return 1; }
	capture_dnsmasq_baseline || { rollback_start; return 1; }
	load_dns_policy || { rollback_start; return 1; }
	if [ "$(cat "$DNS_BACKUP/stale" 2>/dev/null || printf 0)" = 1 ]; then
		set_bootstrap_dns || { rollback_start; return 1; }
		dnsmasq_restart_config || { rollback_start; return 1; }
	fi
	start_engine
	port_ready 5353 || { rollback_start; return 1; }
	probe_enabled="$(dns_policy_value probe_enabled)"
	probe_port="$(dns_policy_value probe_port)"
	if [ "$probe_enabled" = 1 ]; then
		is_uint "$probe_port" || { rollback_start; return 1; }
		port_ready "$probe_port" || { rollback_start; return 1; }
		proxy_connected "$probe_port" || {
			log "proxy connectivity probe failed; traffic and DNS were not imported"
			rollback_start suspended
			return 1
		}
	else
		log "connectivity probe disabled; importing traffic and DNS without verification"
	fi
	apply_takeover_rules || { rollback_start; return 1; }
	if [ "$(dns_policy_value mosdns_enabled)" = 1 ]; then
		start_mosdns
		port_ready 5354 || { rollback_start; return 1; }
	fi
	set_proxy_dns || { rollback_start; return 1; }
	start_watchdog || { rollback_start; return 1; }
	"$CTL" set-setting proxy_mode proxy >/dev/null 2>&1 || { rollback_start; return 1; }
	"$CTL" set-state proxy >/dev/null 2>&1 || { rollback_start; return 1; }
	clear_suspend_pending
	log "proxy mode started"
	release_lock
}

stop_service() {
	acquire_lock || return 1
	previous_state="$(sed -n '1p' "$RUNTIME/state" 2>/dev/null || printf normal)"
	"$CTL" set-state stopping >/dev/null 2>&1 || { release_lock; return 1; }
	if [ -d "$DNS_BACKUP" ]; then
		if ! restore_dnsmasq; then
			"$CTL" set-state degraded >/dev/null 2>&1 || true
			release_lock
			return 1
		fi
	elif [ "$previous_state" = proxy ] || [ "$previous_state" = degraded ] || [ "$previous_state" = stopping ]; then
		log "DNS baseline backup is missing; refusing to stop managed processes"
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	if ! "$CTL" delete-nft >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "nftables cleanup failed; keeping managed processes alive"
		release_lock
		return 1
	fi
	udp_tproxy_cleanup
	if ! stop_instances; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "managed processes did not stop; retry stop after inspecting procd"
		release_lock
		return 1
	fi
	if ! "$CTL" set-setting proxy_mode normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "network mode stopped but database state update failed"
		release_lock
		return 1
	fi
	if ! "$CTL" set-state normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	rm -rf "$RUNTIME/active"
	rm -rf "$DNS_BACKUP"
	clear_suspend_pending
	log "proxy mode stopped; normal DNS restored"
	release_lock
}

suspend_service_locked() {
	mark_suspend_pending || return 1
	"$CTL" set-state stopping >/dev/null 2>&1 || { return 1; }
	if [ -d "$DNS_BACKUP" ] && ! restore_dnsmasq; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		return 1
	fi
	if ! "$CTL" delete-nft >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		return 1
	fi
	udp_tproxy_cleanup
	if ! stop_pid mosdns; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		return 1
	fi
	"$CTL" set-setting proxy_mode normal >/dev/null 2>&1 || {
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		return 1
	}
	"$CTL" set-state suspended >/dev/null 2>&1 || {
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		return 1
	}
	rm -rf "$DNS_BACKUP"
	clear_suspend_pending
	log "traffic and DNS imports withdrawn; proxy engine and watchdog remain active"
	return 0
}

suspend_service() {
	acquire_lock || return 1
	suspend_service_locked
	result=$?
	release_lock
	return "$result"
}

recovery_rollback() {
	mark_suspend_pending || log "could not mark fail-open cleanup for watchdog retry"
	if [ -d "$DNS_BACKUP" ] && ! restore_dnsmasq; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "recovery rollback could not restore DNS; proxy engine remains suspended"
		release_lock
		return 1
	fi
	if ! "$CTL" delete-nft >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "recovery rollback could not remove nftables imports"
		release_lock
		return 1
	fi
	udp_tproxy_cleanup
	if ! stop_pid mosdns; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "recovery rollback could not stop MosDNS; watchdog cleanup retry remains pending"
		release_lock
		return 1
	fi
	if ! "$CTL" set-setting proxy_mode normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "recovery rollback could not update proxy mode; watchdog cleanup retry remains pending"
		release_lock
		return 1
	fi
	if "$CTL" set-state suspended >/dev/null 2>&1; then
		clear_suspend_pending
	else
		"$CTL" set-state degraded >/dev/null 2>&1 || true
	fi
	rm -rf "$DNS_BACKUP"
	log "automatic recovery failed; proxy remains suspended"
	release_lock
	return 1
}

refresh_takeover() {
	apply_takeover_rules || return 1
	if [ "$(dns_policy_value mosdns_enabled)" = 1 ]; then
		stop_pid mosdns || return 1
		start_mosdns || return 1
		port_ready 5354 || return 1
	else
		stop_pid mosdns || return 1
	fi
	set_proxy_dns
}

restart_proxy_service() {
	restart_refresh_takeover=0
	[ "${1:-}" = refresh ] && restart_refresh_takeover=1
	[ "$("$CTL" get-setting service_enabled 2>/dev/null)" = 1 ] || {
		stop_service
		return $?
	}
	acquire_lock || return 1
	current_state="$("$CTL" status 2>/dev/null | sed -n 's/^state=//p' | head -n1)"
	case "$current_state" in
		suspended)
			release_lock
			recover_service
			return $?
			;;
		proxy) ;;
		normal)
			release_lock
			start_service
			return $?
			;;
		*)
			release_lock
			stop_service || return 1
			start_service
			return $?
			;;
	esac
	"$CTL" render-all || { release_lock; return 1; }
	prepare_engine_config_access || { release_lock; return 1; }
	"$CTL" test-v2ray || { release_lock; return 1; }
	load_dns_policy || { release_lock; return 1; }
	"$CTL" set-state starting >/dev/null 2>&1 || { release_lock; return 1; }
	if ! restart_engine || ! port_ready 5353; then
		log "engine restart failed; withdrawing traffic and DNS takeover"
		suspend_service_locked || :
		release_lock
		return 1
	fi
	probe_enabled="$(dns_policy_value probe_enabled)"
	probe_port="$(dns_policy_value probe_port)"
	if [ "$probe_enabled" = 1 ]; then
		if ! is_uint "$probe_port" || ! port_ready "$probe_port" || ! proxy_connected "$probe_port"; then
			log "engine health check failed after restart; withdrawing traffic and DNS takeover"
			suspend_service_locked || :
			release_lock
			return 1
		fi
	fi
	if [ "$restart_refresh_takeover" = 1 ]; then
		if ! refresh_takeover; then
			log "takeover refresh failed after engine restart; withdrawing traffic and DNS takeover"
			suspend_service_locked || :
			release_lock
			return 1
		fi
	fi
	"$CTL" set-setting proxy_mode proxy >/dev/null 2>&1 || {
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	}
	"$CTL" set-state proxy >/dev/null 2>&1 || {
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	}
	if [ "$restart_refresh_takeover" = 1 ]; then
		log "proxy engine restarted; traffic and DNS policy refreshed"
	else
		log "proxy engine restarted; existing traffic and DNS takeover retained"
	fi
	clear_suspend_pending
	release_lock
}

recover_service() {
	acquire_lock || return 1
	if [ "$("$CTL" get-setting service_enabled 2>/dev/null)" != 1 ]; then
		release_lock
		return 0
	fi
	current_state="$("$CTL" status 2>/dev/null | sed -n 's/^state=//p' | head -n1)"
	[ "$current_state" = suspended ] || { release_lock; return 1; }
	"$CTL" render-all || { release_lock; return 1; }
	prepare_engine_config_access || { release_lock; return 1; }
	"$CTL" test-v2ray >/dev/null 2>&1 || { release_lock; return 1; }
	load_dns_policy || { recovery_rollback; return 1; }
	capture_dnsmasq_baseline || { recovery_rollback; return 1; }
	if [ "$(cat "$DNS_BACKUP/stale" 2>/dev/null || printf 0)" = 1 ]; then
		set_bootstrap_dns || { recovery_rollback; return 1; }
		dnsmasq_restart_config || { recovery_rollback; return 1; }
	fi
	"$CTL" set-state starting >/dev/null 2>&1 || { recovery_rollback; return 1; }
	log "restarting the selected proxy engine from the current active configuration"
	restart_engine || { recovery_rollback; return 1; }
	port_ready 5353 || { recovery_rollback; return 1; }
	probe_enabled="$(dns_policy_value probe_enabled)"
	probe_port="$(dns_policy_value probe_port)"
	if [ "$probe_enabled" = 1 ]; then
		is_uint "$probe_port" || { recovery_rollback; return 1; }
		port_ready "$probe_port" || { recovery_rollback; return 1; }
		if ! proxy_connected "$probe_port"; then
			recovery_rollback
			return 1
		fi
	fi
	refresh_takeover || { recovery_rollback; return 1; }
	"$CTL" set-setting proxy_mode proxy >/dev/null 2>&1 || { recovery_rollback; return 1; }
	"$CTL" set-state proxy >/dev/null 2>&1 || { recovery_rollback; return 1; }
	clear_suspend_pending
	log "proxy connectivity recovered; traffic and DNS imports restored"
	release_lock
}

resume_service() {
	acquire_lock || return 1
	if [ "$("$CTL" get-setting service_enabled 2>/dev/null)" != 1 ]; then
		release_lock
		return 0
	fi
	current_state="$("$CTL" status 2>/dev/null | sed -n 's/^state=//p' | head -n1)"
	if [ "$current_state" = suspended ]; then
		release_lock
		recover_service
		return
	fi
	if [ "$current_state" != normal ] || managed_processes_alive ||
		[ -d "$DNS_BACKUP" ] || [ -f "$RUNTIME/nft-managed" ]; then
		release_lock
		stop_service || return 1
	else
		release_lock
	fi
	start_service
}

reload_service() {
	restart_proxy_service "$@"
}

status() {
	managed_processes_alive && echo running || echo inactive
}

start() {
	start_service "$@"
}

stop() {
	stop_service "$@"
}

reload() {
	reload_service "$@"
}

restart() {
	reload_service "$@"
}

suspend() {
	suspend_service "$@"
}

resume() {
	resume_service "$@"
}

recover() {
	recover_service "$@"
}

if command -v extra_command >/dev/null 2>&1; then
	extra_command "status" "Show service status"
	extra_command "running" "Check whether managed processes are running"
	extra_command "suspend" "Withdraw traffic and DNS imports while retaining proxy and watchdog"
	extra_command "resume" "Retry a suspended proxy service"
	extra_command "recover" "Restore imports for a running suspended proxy"
fi

running() {
	managed_processes_alive
}
