#!/bin/sh /etc/rc.common

START=99
STOP=10

CTL="/usr/libexec/v2rayB/v2rayBctl"
RUNTIME="/tmp/v2rayB"
PID_DIR="$RUNTIME/pids"
DNS_BACKUP="$RUNTIME/dnsmasq-before"
LOCK_DIR="$RUNTIME/lock"
DNSMASQ_SECTION='dhcp.@dnsmasq[0]'
DNSMASQ_DIR="/etc/dnsmasq.d"
MOSDNS_FORWARD_FILE="$DNSMASQ_DIR/90-v2rayB-mosdns.conf"
MOSDNS_FORWARD_EXPECTED="$RUNTIME/dnsmasq-mosdns-expected"
V2RAY_USER="${V2RAYB_V2RAY_USER:-nobody}"
V2RAY_GROUP="${V2RAYB_V2RAY_GROUP:-nogroup}"

log() {
	logger -t v2rayB "$*"
}

is_pid() {
	case "$1" in
		''|*[!0-9]*|0) return 1 ;;
		*) return 0 ;;
	esac
}

acquire_lock() {
	mkdir -p "$RUNTIME"
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		printf '%s\n' "$$" > "$LOCK_DIR/pid"
	export V2RAYB_LOCK_HELD=1
		return 0
	fi
	old_pid="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
	if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
		return 1
	fi
	rm -rf "$LOCK_DIR"
	mkdir "$LOCK_DIR" 2>/dev/null || return 1
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
	export V2RAYB_LOCK_HELD=1
}

release_lock() {
	rm -rf "$LOCK_DIR"
	unexport V2RAYB_LOCK_HELD 2>/dev/null || :
}

dnsmasq_reload() {
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || \
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

load_dns_policy() {
	"$CTL" dns-settings > "$RUNTIME/dns-policy" || return 1
	[ -s "$RUNTIME/dns-policy" ]
}

dns_policy_value() {
	sed -n "s/^$1=//p" "$RUNTIME/dns-policy" | sed -n '1p'
}

write_mosdns_forward_expected() {
	mosdns_listen="$(dns_policy_value mosdns_listen)"
	mosdns_domains="$(dns_policy_value mosdns_domains)"
	[ -n "$mosdns_listen" ] && [ -n "$mosdns_domains" ] || return 1
	{
		printf '%s\n' '# Managed by v2rayB; removed when proxy mode stops.'
		printf '%s\n' "$mosdns_domains" | tr ',' '\n' | while IFS= read -r domain; do
			[ -n "$domain" ] || continue
			printf 'server=/%s/%s\n' "$domain" "$mosdns_listen"
		done
	} > "$MOSDNS_FORWARD_EXPECTED"
}

capture_dnsmasq_baseline() {
	[ -f "$DNS_BACKUP/server" ] && return 0
	mkdir -p "$DNS_BACKUP" || return 1
	: > "$DNS_BACKUP/server" || { rm -rf "$DNS_BACKUP"; return 1; }
	: > "$DNS_BACKUP/noresolv" || { rm -rf "$DNS_BACKUP"; return 1; }
	: > "$DNS_BACKUP/allservers" || { rm -rf "$DNS_BACKUP"; return 1; }
	uci -q get "${DNSMASQ_SECTION}.server" > "$DNS_BACKUP/server" 2>/dev/null || :
	uci -q get "${DNSMASQ_SECTION}.noresolv" > "$DNS_BACKUP/noresolv" 2>/dev/null || :
	uci -q get "${DNSMASQ_SECTION}.allservers" > "$DNS_BACKUP/allservers" 2>/dev/null || :
	[ -f "$DNS_BACKUP/server" ] && [ -f "$DNS_BACKUP/noresolv" ] &&
		[ -f "$DNS_BACKUP/allservers" ] || {
		rm -rf "$DNS_BACKUP"
		return 1
	}
	servers="$(cat "$DNS_BACKUP/server" 2>/dev/null || true)"
	noresolv="$(cat "$DNS_BACKUP/noresolv" 2>/dev/null || true)"
	if [ "$noresolv" = 1 ] && printf '%s\n' "$servers" | grep -Eq '^127\.0\.0\.1#535[34]$'; then
		printf '%s\n' 1 > "$DNS_BACKUP/stale"
	else
		printf '%s\n' 0 > "$DNS_BACKUP/stale"
	fi
}

set_proxy_dns() {
	load_dns_policy || return 1
	default_upstream="$(dns_policy_value dnsmasq_default)"
	mosdns_enabled="$(dns_policy_value mosdns_enabled)"
	dns_fallback="$(dns_policy_value dns_fallback)"
	[ -n "$dns_fallback" ] || dns_fallback=1
	[ -n "$default_upstream" ] || return 1
	uci -q show "$DNSMASQ_SECTION" >/dev/null 2>&1 || return 1
	[ -d "$DNSMASQ_DIR" ] || return 1
	[ "$(uci -q get "${DNSMASQ_SECTION}.confdir" 2>/dev/null || true)" = "$DNSMASQ_DIR" ] || {
		log "dnsmasq is not configured to read $DNSMASQ_DIR"
		return 1
	}
	if [ "$mosdns_enabled" = 1 ]; then
		write_mosdns_forward_expected || return 1
		if [ -e "$MOSDNS_FORWARD_FILE" ] && ! cmp -s "$MOSDNS_FORWARD_FILE" "$MOSDNS_FORWARD_EXPECTED"; then
			log "refusing to overwrite existing $MOSDNS_FORWARD_FILE"
			return 1
		fi
		cp "$MOSDNS_FORWARD_EXPECTED" "$MOSDNS_FORWARD_FILE.tmp.$$" || return 1
		mv "$MOSDNS_FORWARD_FILE.tmp.$$" "$MOSDNS_FORWARD_FILE" || return 1
		printf '%s\n' managed > "$RUNTIME/dnsmasq-mosdns-rule"
	else
		rm -f "$MOSDNS_FORWARD_EXPECTED"
	fi
	: > "$RUNTIME/proxy-server.expected"
	uci -q delete "${DNSMASQ_SECTION}.server" || true
	while IFS= read -r server; do
		case "$server" in
			/*/*)
				uci -q add_list "${DNSMASQ_SECTION}.server=$server" || return 1
				printf '%s\n' "$server" >> "$RUNTIME/proxy-server.expected"
				;;
		esac
	done < "$DNS_BACKUP/server"
	uci -q add_list "${DNSMASQ_SECTION}.server=$default_upstream" || return 1
	printf '%s\n' "$default_upstream" >> "$RUNTIME/proxy-server.expected"
	if [ "$dns_fallback" = 1 ]; then
		for fallback_server in 1.1.1.1#53 1.0.0.1#53; do
			uci -q add_list "${DNSMASQ_SECTION}.server=$fallback_server" || return 1
			printf '%s\n' "$fallback_server" >> "$RUNTIME/proxy-server.expected"
		done
		uci -q set "${DNSMASQ_SECTION}.allservers=1" || return 1
	else
		uci -q delete "${DNSMASQ_SECTION}.allservers" || true
	fi
	uci -q set "${DNSMASQ_SECTION}.noresolv=1" || return 1
	uci -q get "${DNSMASQ_SECTION}.noresolv" > "$RUNTIME/proxy-noresolv" 2>/dev/null || :
	printf '%s\n' '1' > "$RUNTIME/proxy-noresolv.expected"
	uci -q get "${DNSMASQ_SECTION}.server" 2>/dev/null | tr ' ' '\n' > "$RUNTIME/proxy-server" || :
	cmp -s "$RUNTIME/proxy-server" "$RUNTIME/proxy-server.expected" || return 1
	cmp -s "$RUNTIME/proxy-noresolv" "$RUNTIME/proxy-noresolv.expected" || return 1
	dnsmasq_reload
}

restore_dnsmasq() {
	[ -f "$DNS_BACKUP/server" ] || {
		log "dnsmasq baseline backup is missing; refusing to stop local DNS safely"
		return 1
	}
	uci -q show "$DNSMASQ_SECTION" >/dev/null 2>&1 || return 1
	uci -q delete "${DNSMASQ_SECTION}.server" || true
	if [ -f "$DNS_BACKUP/stale" ] && [ "$(cat "$DNS_BACKUP/stale")" = 1 ]; then
		: > "$RUNTIME/restore-server.expected"
		while IFS= read -r server; do
			[ -n "$server" ] || continue
			case "$server" in
				127.0.0.1#5353|127.0.0.1#5354) continue ;;
			esac
			uci -q add_list "${DNSMASQ_SECTION}.server=$server" || return 1
			printf '%s\n' "$server" >> "$RUNTIME/restore-server.expected"
		done < "$DNS_BACKUP/server"
		uci -q delete "${DNSMASQ_SECTION}.noresolv" || true
		uci -q delete "${DNSMASQ_SECTION}.allservers" || true
		: > "$RUNTIME/restore-noresolv.expected"
		: > "$RUNTIME/restore-allservers.expected"
	else
		while IFS= read -r server; do
			[ -n "$server" ] || continue
			uci -q add_list "${DNSMASQ_SECTION}.server=$server" || return 1
		done < "$DNS_BACKUP/server" 2>/dev/null || true
		cp "$DNS_BACKUP/server" "$RUNTIME/restore-server.expected" || return 1
		if [ -s "$DNS_BACKUP/noresolv" ]; then
			noresolv="$(sed -n '1p' "$DNS_BACKUP/noresolv")"
			uci -q set "${DNSMASQ_SECTION}.noresolv=$noresolv" || return 1
			cp "$DNS_BACKUP/noresolv" "$RUNTIME/restore-noresolv.expected" || return 1
		else
			uci -q delete "${DNSMASQ_SECTION}.noresolv" || true
			: > "$RUNTIME/restore-noresolv.expected"
		fi
	fi
	if [ -s "$DNS_BACKUP/allservers" ]; then
		allservers="$(sed -n '1p' "$DNS_BACKUP/allservers")"
		uci -q set "${DNSMASQ_SECTION}.allservers=$allservers" || return 1
		cp "$DNS_BACKUP/allservers" "$RUNTIME/restore-allservers.expected" || return 1
	else
		uci -q delete "${DNSMASQ_SECTION}.allservers" || true
		: > "$RUNTIME/restore-allservers.expected"
	fi
	if [ -e "$MOSDNS_FORWARD_FILE" ]; then
		if [ ! -f "$MOSDNS_FORWARD_EXPECTED" ] || ! cmp -s "$MOSDNS_FORWARD_FILE" "$MOSDNS_FORWARD_EXPECTED"; then
			log "refusing to remove modified $MOSDNS_FORWARD_FILE"
			return 1
		fi
		rm -f "$MOSDNS_FORWARD_FILE" || return 1
	fi
	rm -f "$RUNTIME/dnsmasq-mosdns-rule" "$MOSDNS_FORWARD_EXPECTED"
	dnsmasq_reload || {
		log "dnsmasq reload failed while restoring its baseline"
		return 1
	}
	uci -q show "$DNSMASQ_SECTION" >/dev/null 2>&1 || return 1
	uci -q get "${DNSMASQ_SECTION}.server" > "$RUNTIME/restore-server" 2>/dev/null || :
	uci -q get "${DNSMASQ_SECTION}.noresolv" > "$RUNTIME/restore-noresolv" 2>/dev/null || :
	uci -q get "${DNSMASQ_SECTION}.allservers" > "$RUNTIME/restore-allservers" 2>/dev/null || :
	cmp -s "$RUNTIME/restore-server" "$RUNTIME/restore-server.expected" || return 1
	cmp -s "$RUNTIME/restore-noresolv" "$RUNTIME/restore-noresolv.expected" || return 1
	cmp -s "$RUNTIME/restore-allservers" "$RUNTIME/restore-allservers.expected" || return 1
}

cleanup_legacy_procd() {
	output="$(ubus call service list '{"name":"v2rayB"}' 2>/dev/null)" || return 0
	printf '%s\n' "$output" | grep -q '"v2rayB"' || return 0
	ubus call service delete '{"name":"v2rayB"}' >/dev/null 2>&1 || return 1
}

process_alive() {
	pid="$(sed -n '1p' "$PID_DIR/$1.pid" 2>/dev/null || true)"
	is_pid "$pid" && kill -0 "$pid" 2>/dev/null
}

managed_processes_alive() {
	process_alive v2ray || return 1
	if [ -f "$PID_DIR/mosdns.pid" ]; then
		process_alive mosdns || return 1
	fi
}

stop_pid() {
	name="$1"
	pidfile="$PID_DIR/$name.pid"
	[ -f "$pidfile" ] || return 0
	pid="$(sed -n '1p' "$pidfile" 2>/dev/null || true)"
	if is_pid "$pid" && kill -0 "$pid" 2>/dev/null; then
		kill "$pid" 2>/dev/null || return 1
		n=0
		while kill -0 "$pid" 2>/dev/null; do
			[ "$n" -lt 10 ] || {
				kill -9 "$pid" 2>/dev/null || return 1
				break
			}
			n=$((n + 1))
			sleep 1
		done
	fi
	rm -f "$pidfile"
}

stop_instances() {
	cleanup_legacy_procd || return 1
	stop_pid watchdog || return 1
	stop_pid mosdns || return 1
	stop_pid v2ray || return 1
}

port_ready() {
	port="$1"
	n=0
	while [ "$n" -lt 20 ]; do
		if netstat -ln 2>/dev/null | grep -Eq "[.:]${port}[[:space:]]"; then
			return 0
		fi
		n=$((n + 1))
		sleep 1
	done
	return 1
}

start_engine() {
	mkdir -p "$PID_DIR" || return 1
	max_fd="$(ulimit -Hn 2>/dev/null || true)"
	is_pid "$max_fd" && ulimit -n "$max_fd" 2>/dev/null || true
	for log_name in v2ray.log v2ray-error.log; do
		touch "$RUNTIME/$log_name" || return 1
		chown "$V2RAY_USER:$V2RAY_GROUP" "$RUNTIME/$log_name" || return 1
		chmod 600 "$RUNTIME/$log_name" || return 1
	done
	rm -f "$PID_DIR/v2ray.pid"
	env 'v2ray.local.asset=/usr/share/v2ray' V2RAY_CONF_GEOLOADER=memconservative \
		start-stop-daemon -S -b -c "$V2RAY_USER:$V2RAY_GROUP" \
		-x /usr/bin/v2ray -O "$RUNTIME/v2ray.log" \
		-m -p "$PID_DIR/v2ray.pid" -- \
		run -c "$RUNTIME/active/v2ray.json" || return 1
	is_pid "$(sed -n '1p' "$PID_DIR/v2ray.pid" 2>/dev/null || true)"
}

start_mosdns() {
	mkdir -p "$PID_DIR" || return 1
	/usr/bin/mosdns start -c "$RUNTIME/active/mosdns.yaml" \
		>>"$RUNTIME/mosdns.log" 2>&1 &
	printf '%s\n' "$!" > "$PID_DIR/mosdns.pid"
}

start_watchdog() {
	[ "$("$CTL" get-setting watchdog_enabled 2>/dev/null || printf 0)" = 1 ] || return 0
	mkdir -p "$PID_DIR" || return 1
	/usr/bin/v2rayB-watchdog >>"$RUNTIME/watchdog.log" 2>&1 &
	printf '%s\n' "$!" > "$PID_DIR/watchdog.pid"
}

rollback_start() {
	log "start failed; rolling back to normal mode"
	if [ -d "$DNS_BACKUP" ] && ! restore_dnsmasq; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "rollback paused: DNS baseline could not be restored; keeping local services alive"
		release_lock
		return 1
	fi
	if ! "$CTL" delete-nft >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "rollback paused: nftables rules could not be removed; keeping local services alive"
		release_lock
		return 1
	fi
	if ! stop_instances; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "rollback incomplete: managed processes did not stop"
		release_lock
		return 1
	fi
	if ! "$CTL" set-setting proxy_mode normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	if ! "$CTL" set-state normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	rm -rf "$RUNTIME/active"
	rm -rf "$DNS_BACKUP"
	release_lock
	return 1
}

start_service() {
	acquire_lock || return 1
	"$CTL" init-db >/dev/null 2>&1 || { release_lock; return 1; }
	if [ "$("$CTL" get-setting service_enabled 2>/dev/null)" != 1 ]; then
		release_lock
		return 0
	fi
	current_state="$("$CTL" status 2>/dev/null | sed -n 's/^state=//p' | head -n1)"
	if [ "$current_state" = proxy ] && managed_processes_alive; then
		release_lock
		return 0
	fi
	if [ "$current_state" != normal ] || managed_processes_alive || [ -d "$DNS_BACKUP" ] || [ -f "$RUNTIME/nft-managed" ]; then
		release_lock
		stop_service || return 1
		start_service
		return $?
	fi
	"$CTL" set-state starting >/dev/null 2>&1 || { release_lock; return 1; }
	"$CTL" render-all || { rollback_start; return 1; }
	"$CTL" test-v2ray || { rollback_start; return 1; }
	capture_dnsmasq_baseline || { rollback_start; return 1; }
	start_engine
	port_ready 5353 || { rollback_start; return 1; }
	"$CTL" apply-nft || { rollback_start; return 1; }
	load_dns_policy || { rollback_start; return 1; }
	if [ "$(dns_policy_value mosdns_enabled)" = 1 ]; then
		start_mosdns
		port_ready 5354 || { rollback_start; return 1; }
	fi
	set_proxy_dns || { rollback_start; return 1; }
	start_watchdog || { rollback_start; return 1; }
	"$CTL" set-setting proxy_mode proxy >/dev/null 2>&1 || { rollback_start; return 1; }
	"$CTL" set-state proxy >/dev/null 2>&1 || { rollback_start; return 1; }
	log "proxy mode started"
	release_lock
}

stop_service() {
	acquire_lock || return 1
	previous_state="$(sed -n '1p' "$RUNTIME/state" 2>/dev/null || printf normal)"
	"$CTL" set-state stopping >/dev/null 2>&1 || { release_lock; return 1; }
	if [ -d "$DNS_BACKUP" ]; then
		if ! restore_dnsmasq; then
			"$CTL" set-state degraded >/dev/null 2>&1 || true
			release_lock
			return 1
		fi
	elif [ "$previous_state" = proxy ] || [ "$previous_state" = degraded ] || [ "$previous_state" = stopping ]; then
		log "DNS baseline backup is missing; refusing to stop managed processes"
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	if ! "$CTL" delete-nft >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "nftables cleanup failed; keeping managed processes alive"
		release_lock
		return 1
	fi
	if ! stop_instances; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "managed processes did not stop; retry stop after inspecting procd"
		release_lock
		return 1
	fi
	if ! "$CTL" set-setting proxy_mode normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		log "network mode stopped but database state update failed"
		release_lock
		return 1
	fi
	if ! "$CTL" set-state normal >/dev/null 2>&1; then
		"$CTL" set-state degraded >/dev/null 2>&1 || true
		release_lock
		return 1
	fi
	rm -rf "$RUNTIME/active"
	rm -rf "$DNS_BACKUP"
	log "proxy mode stopped; normal DNS restored"
	release_lock
}

reload_service() {
	stop_service || return 1
	start_service
}

status() {
	managed_processes_alive && echo running || echo inactive
}

start() {
	start_service "$@"
}

stop() {
	stop_service "$@"
}

reload() {
	reload_service "$@"
}

if command -v extra_command >/dev/null 2>&1; then
	extra_command "status" "Show service status"
	extra_command "running" "Check whether managed processes are running"
fi

running() {
	managed_processes_alive
}
