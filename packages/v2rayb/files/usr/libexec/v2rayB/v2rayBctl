cmd_render_v2ray() {
	ensure_db
	row="$(active_profile)"
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	read -r protocol server port data_json profile_direct_dns profile_proxy_ports bypass_china \
		use_v2ray_dns mosdns_enabled mosdns_domains proxy_router_traffic <<EOF
$row
EOF
	IFS="$old_ifs"
	is_protocol "$protocol" || die "unsupported active protocol: $protocol"
	is_server "$server" || die "invalid active server"
	is_uint "$port" || die "invalid active port"
	case "$bypass_china" in 0|1) ;; *) die "invalid profile bypass_china value" ;; esac
	case "$data_json" in
		\{*\}) ;;
		*) die "active node data_json is not an object" ;;
	esac
	data_body="${data_json#\{}"
	data_body="${data_body%\}}"
	[ -n "$data_body" ] || die "active node data_json is empty"

	tmp="$ACTIVE_DIR/v2ray.json.tmp.$$"
	{
		printf '%s\n' '{'
		printf '%s\n' '  "log": {"loglevel": "warning", "error": "/tmp/v2rayB/v2ray-error.log"},'
		printf '%s\n' '  "inbounds": ['
		printf '    {"tag":"redir-in","port":%s,"protocol":"dokodemo-door","settings":{"network":"tcp","followRedirect":true}},\n' "$(setting transparent_proxy_port)"
		printf '%s\n' '    {"tag":"dns-in","listen":"127.0.0.1","port":5353,"protocol":"dokodemo-door","settings":{"address":"8.8.8.8","port":53,"network":"tcp,udp","followRedirect":false}},'
		printf '    {"tag":"force-proxy-in","port":%s,"protocol":"dokodemo-door","settings":{"network":"tcp","followRedirect":true}}\n' "$(setting force_proxy_port)"
		printf '%s\n' '  ],'
		printf '  "outbounds": [{"tag":"proxy","protocol":"%s",%s},\n' "$protocol" "$data_body"
		printf '%s\n' '    {"tag":"direct","protocol":"freedom","settings":{}},'
		printf '%s\n' '    {"tag":"blocked","protocol":"blackhole","settings":{}}],'
		printf '%s\n' '  "routing": {"domainStrategy":"IPIfNonMatch","rules":['
		printf '%s\n' '    {"type":"field","inboundTag":["dns-in","force-proxy-in"],"outboundTag":"proxy"},'
		printf '%s\n' '    {"type":"field","ip":["geoip:private"],"outboundTag":"direct"},'
		if [ "$bypass_china" = 1 ]; then
			printf '%s\n' '    {"type":"field","ip":["geoip:cn"],"outboundTag":"direct"},'
		fi
		printf '%s\n' '    {"type":"field","inboundTag":["redir-in"],"outboundTag":"proxy"}'
		printf '%s\n' '  ]}'
		printf '%s\n' '}'
	} > "$tmp"
	mv "$tmp" "$ACTIVE_DIR/v2ray.json"
}

endpoint_to_addr() {
	value="$1"
	case "$value" in
		*://*) printf '%s\n' "$value" ;;
		*) printf 'udp://%s\n' "$value" ;;
	esac
}

hash_port_addr() {
	value="$1"
	printf '%s\n' "$value" | sed 's/#/:/'
}

dnsmasq_endpoint() {
	printf '%s\n' "$1" | sed 's/:\([0-9][0-9]*\)$/#\1/'
}

