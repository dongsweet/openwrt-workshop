		[ -f "$NFT_MARKER" ] || die "table inet v2rayB already exists and is not owned by v2rayB; inspect it before replacing"
		nft delete table inet v2rayB
	fi
	nft -f "$ACTIVE_DIR/nftables.nft"
	printf '%s\n' managed > "$NFT_MARKER"
}

cmd_delete_nft() {
	command -v nft >/dev/null 2>&1 || die "nft is required to verify table cleanup"
	if [ ! -f "$NFT_MARKER" ]; then
		if nft list table inet v2rayB >/dev/null 2>&1; then
			die "table inet v2rayB exists but is not marked as managed; refusing to delete it"
		fi
		return 0
	fi
	if nft list table inet v2rayB >/dev/null 2>&1; then
		nft delete table inet v2rayB || die "failed to delete managed table inet v2rayB"
	fi
	if nft list table inet v2rayB >/dev/null 2>&1; then
		die "managed table inet v2rayB still exists after delete"
	fi
	rm -f "$NFT_MARKER"
}

