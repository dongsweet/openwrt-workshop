	draft_change_commit
	db_sql "SELECT id FROM draft_nodes WHERE source_id=$source_id AND name=$(sql_quote "$name");" | sed -n '1p'
}

cmd_set_profile_policy() {
	ensure_db
	profile_id="$1"
	direct_dns="$2"
	transparent_proxy_ports="$3"
	bypass_china="$4"
	use_v2ray_dns="${5:-1}"
	mosdns_enabled="${6:-1}"
	mosdns_domains="${7:-xn--ngstr-lra8j.com}"
	mosdns_match_rules="${8:-}"
	proxy_router_traffic="${9:-0}"
	transparent_proxy_port="${10:-12345}"
	probe_enabled="${11:-1}"
	probe_port="${12:-12346}"
	force_proxy_domains="${13:-}"
	force_proxy_domains="$(normalize_force_proxy_domains "$force_proxy_domains")"
	is_uint "$profile_id" || die "profile id must be numeric"
	validate_profile_policy "$direct_dns" "$transparent_proxy_ports" "$bypass_china" \
		"$use_v2ray_dns" "$mosdns_enabled" "$mosdns_domains" "$mosdns_match_rules" "$proxy_router_traffic" \
		"$transparent_proxy_port" "$probe_enabled" "$probe_port" "$force_proxy_domains"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	policy_id="$(db_sql "SELECT COALESCE(policy_id, 0) FROM draft_profiles WHERE id=$profile_id;" | sed -n '1p')"
	if is_uint "$policy_id" && [ "$policy_id" -gt 0 ] 2>/dev/null; then
		count="$(db_sql "SELECT COUNT(*) FROM draft_policies WHERE id=$policy_id;" | tr -d '[:space:]')"
		if [ "$count" = 0 ]; then
			db_sql "INSERT OR IGNORE INTO draft_policies(id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,transparent_proxy_port,probe_enabled,probe_port,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,proxy_router_traffic,force_proxy_domains,created_at,updated_at) SELECT id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,transparent_proxy_port,probe_enabled,probe_port,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,proxy_router_traffic,force_proxy_domains,created_at,updated_at FROM policies WHERE id=$policy_id;"
			count="$(db_sql "SELECT COUNT(*) FROM draft_policies WHERE id=$policy_id;" | tr -d '[:space:]')"
		fi
		[ "$count" = 1 ] || die "profile policy is missing from both draft and applied configuration"
		db_sql "UPDATE draft_policies SET direct_dns=$(sql_quote "$direct_dns"), transparent_proxy_ports=$(sql_quote "$transparent_proxy_ports"), transparent_proxy_port=$transparent_proxy_port, probe_enabled=$probe_enabled, probe_port=$probe_port, bypass_china=$bypass_china, use_v2ray_dns=$use_v2ray_dns, mosdns_enabled=$mosdns_enabled, mosdns_domains=$(sql_quote "$mosdns_domains"), mosdns_match_rules=$(sql_quote "$mosdns_match_rules"), proxy_router_traffic=$proxy_router_traffic, force_proxy_domains=$(sql_quote "$force_proxy_domains"), updated_at=CURRENT_TIMESTAMP WHERE id=$policy_id; UPDATE draft_profiles SET policy_id=$policy_id, updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id;"
	else
		policy_name="profile-$profile_id"
		policy_id="$(db_sql "INSERT INTO draft_policies(name, direct_dns, transparent_proxy_ports, transparent_proxy_port, probe_enabled, probe_port, bypass_china, use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules, proxy_router_traffic, force_proxy_domains, updated_at) VALUES($(sql_quote "$policy_name"), $(sql_quote "$direct_dns"), $(sql_quote "$transparent_proxy_ports"), $transparent_proxy_port, $probe_enabled, $probe_port, $bypass_china, $use_v2ray_dns, $mosdns_enabled, $(sql_quote "$mosdns_domains"), $(sql_quote "$mosdns_match_rules"), $proxy_router_traffic, $(sql_quote "$force_proxy_domains"), CURRENT_TIMESTAMP) ON CONFLICT(name) DO UPDATE SET direct_dns=excluded.direct_dns, transparent_proxy_ports=excluded.transparent_proxy_ports, transparent_proxy_port=excluded.transparent_proxy_port, probe_enabled=excluded.probe_enabled, probe_port=excluded.probe_port, bypass_china=excluded.bypass_china, use_v2ray_dns=excluded.use_v2ray_dns, mosdns_enabled=excluded.mosdns_enabled, mosdns_domains=excluded.mosdns_domains, mosdns_match_rules=excluded.mosdns_match_rules, proxy_router_traffic=excluded.proxy_router_traffic, force_proxy_domains=excluded.force_proxy_domains, updated_at=CURRENT_TIMESTAMP; SELECT id FROM draft_policies WHERE name=$(sql_quote "$policy_name");" | sed -n '1p')"
		is_uint "$policy_id" || die "failed to create profile policy"
		db_sql "UPDATE draft_profiles SET policy_id=$policy_id, updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id;"
	fi
	draft_change_commit
}

