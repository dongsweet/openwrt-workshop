	is_uint "$profile_id" || die "profile id must be numeric"
	is_name "$name" || die "invalid profile name"
	is_uint "$node_id" || die "node id must be numeric"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id AND enabled=1;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found or disabled: $node_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE name=$(sql_quote "$name") AND id<>$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 0 ] || die "profile already exists: $name"
	db_sql "UPDATE draft_profiles SET name=$(sql_quote "$name"), updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id; DELETE FROM draft_profile_nodes WHERE profile_id=$profile_id; INSERT INTO draft_profile_nodes(profile_id, node_id, role, priority) VALUES($profile_id, $node_id, 'primary', 0);"
	if [ "$#" -ge 4 ]; then
		direct_dns="$4"
		transparent_proxy_ports="$5"
		bypass_china="$6"
