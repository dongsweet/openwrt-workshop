probe_dns_observer_stop() {
	if [ -n "${probe_observer_table:-}" ]; then
		nft delete table inet "$probe_observer_table" >/dev/null 2>&1 || :
		probe_observer_table=''
	fi
}

probe_cleanup() {
	probe_dns_observer_stop
	[ -n "${probe_dir:-}" ] && rm -rf "$probe_dir"
}

probe_dns_observer_start() {
	probe_observer_table=''
	probe_observer_token=''
	command -v nft >/dev/null 2>&1 || return 1
	command -v logread >/dev/null 2>&1 || return 1
	probe_dnsmasq_uid="$(id -u dnsmasq 2>/dev/null || true)"
	is_uint "$probe_dnsmasq_uid" || return 1

	probe_observer_table="v2rayb_probe_$$"
	probe_observer_token="v2rayb-probe-$$-$(date +%s)"
	nft delete table inet "$probe_observer_table" >/dev/null 2>&1 || :
	if ! nft -f - >/dev/null 2>&1 <<EOF
table inet $probe_observer_table {
	chain output {
		type filter hook output priority -350; policy accept;
		meta skuid $probe_dnsmasq_uid udp dport { 53, 5353, 5354 } counter log prefix "$probe_observer_token "
		meta skuid $probe_dnsmasq_uid tcp dport { 53, 5353, 5354 } counter log prefix "$probe_observer_token "
	}
}
EOF
	then
		probe_observer_table=''
		probe_observer_token=''
		return 1
	fi
	return 0
}

probe_dns_observer_results() {
	[ -n "${probe_observer_token:-}" ] || return 0
	logread 2>/dev/null | grep -F "$probe_observer_token " | awk '
		{
			dst = ""
			port = ""
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^DST=/)
					dst = substr($i, 5)
				else if ($i ~ /^DPT=/)
					port = substr($i, 5)
			}
			if (dst == "" || port == "")
				next
			if (dst ~ /:/)
				printf "[%s]:%s\n", dst, port
			else
				printf "%s:%s\n", dst, port
		}
	' | sort -u | awk '
		BEGIN { out = "" }
		{
			if (out != "")
				out = out ","
			out = out $0
		}
		END { print out }
	'
}

cmd_network_probe() {
	ensure_db
	probe_url="$1"
	[ ${#probe_url} -le 2048 ] || die "URL is too long"
	case "$probe_url" in
		http://*|https://*) ;;
		*) die "URL must start with http:// or https://" ;;
	esac
	probe_scheme="${probe_url%%://*}"
	probe_rest="${probe_url#*://}"
	probe_authority="${probe_rest%%/*}"
	[ -n "$probe_authority" ] || die "URL host is missing"
	case "$probe_authority" in
		*@*|*'?'*|*'#'*) die "URL userinfo, query-only, or fragment-only authority is not supported" ;;
	esac

	case "$probe_authority" in
		\[*\]:*)
			probe_host="${probe_authority#\[}"
			probe_host="${probe_host%%\]*}"
			probe_port="${probe_authority#*\]}"
			probe_port="${probe_port#:}"
			;;
		\[*\])
			probe_host="${probe_authority#\[}"
			probe_host="${probe_host%\]}"
			probe_port=""
			;;
		*:*:*)
			die "IPv6 URL hosts must be enclosed in brackets"
			;;
		*:*)
			probe_host="${probe_authority%:*}"
			probe_port="${probe_authority##*:}"
			;;
		*)
			probe_host="$probe_authority"
			probe_port=""
			;;
	esac
	[ -n "$probe_host" ] || die "URL host is missing"
	case "$probe_host" in
		*[!A-Za-z0-9._:-]*) die "URL host contains unsupported characters" ;;
	esac
	if [ -z "$probe_port" ]; then
		[ "$probe_scheme" = https ] && probe_port=443 || probe_port=80
	fi
	is_uint "$probe_port" || die "URL port is invalid"
	[ "$probe_port" -ge 1 ] 2>/dev/null && [ "$probe_port" -le 65535 ] 2>/dev/null || die "URL port is out of range"

	probe_dir="$STATE_DIR/probe.$$"
	mkdir -p "$probe_dir" || die "cannot create probe workspace"
	probe_observer_table=''
	probe_observer_token=''
	trap 'probe_cleanup' EXIT HUP INT TERM

	command -v dig >/dev/null 2>&1 || die "dig is required"
	command -v curl >/dev/null 2>&1 || die "curl is required"
	dns_observation='not_applicable'
	dns_observed_upstreams=''
	dns_observation_query='-'
	dns_a_file="$probe_dir/dns-a"
	dns_aaaa_file="$probe_dir/dns-aaaa"
	case "$probe_host" in
		*:* )
			dns_a=''
			dns_aaaa="$probe_host"
			dns_cname=''
			dns_status='LITERAL_IP'
			dns_query_ms='-'
			dns_result='not_applicable'
			;;
		*[!0-9.]*)
			if probe_dns_observer_start; then
				dns_observation='observing'
			else
				dns_observation='unavailable'
			fi
			dns_observation_query='A,AAAA'
			dig +noall +comments +answer +stats +time=3 +tries=1 @127.0.0.1 -p 53 "$probe_host" A >"$dns_a_file" 2>"$probe_dir/dns-a.err" || true
			dig +noall +comments +answer +stats +time=3 +tries=1 @127.0.0.1 -p 53 "$probe_host" AAAA >"$dns_aaaa_file" 2>"$probe_dir/dns-aaaa.err" || true
	dns_a="$(awk '$4 == "A" { if (out != "") out=out ","; out=out $5 } END { print out }' "$dns_a_file")"
	dns_aaaa="$(awk '$4 == "AAAA" { if (out != "") out=out ","; out=out $5 } END { print out }' "$dns_aaaa_file")"
	dns_cname="$(awk '$4 == "CNAME" { if (out != "") out=out ","; out=out $5 } END { print out }' "$dns_a_file" "$dns_aaaa_file")"
	dns_status="$(sed -n 's/^;; ->>HEADER<<-.*status: \([^,]*\).*/\1/p' "$dns_a_file" | sed -n '1p')"
	dns_aaaa_status="$(sed -n 's/^;; ->>HEADER<<-.*status: \([^,]*\).*/\1/p' "$dns_aaaa_file" | sed -n '1p')"
	[ -n "$dns_status" ] || dns_status='UNKNOWN'
	[ -n "$dns_aaaa_status" ] || dns_aaaa_status='UNKNOWN'
	dns_query_ms="$(sed -n 's/^;; Query time: \([0-9][0-9]*\) msec.*/\1/p' "$dns_a_file" | sed -n '1p')"
	[ -n "$dns_query_ms" ] || dns_query_ms='-'
	if { [ "$dns_status" = NOERROR ] && { [ -n "$dns_a" ] || [ -n "$dns_cname" ]; }; } ||
		{ [ "$dns_aaaa_status" = NOERROR ] && { [ -n "$dns_aaaa" ] || [ -n "$dns_cname" ]; }; }; then
		dns_result=success
	else
		dns_result=failed
	fi
			;;
		*)
			dns_a="$probe_host"
			dns_aaaa=''
			dns_cname=''
			dns_status='LITERAL_IP'
			dns_query_ms='-'
			dns_result='not_applicable'
			;;
	esac

	if [ "$dns_observation" = observing ]; then
		sleep 1
		dns_observed_upstreams="$(probe_dns_observer_results)"
		if [ -z "$dns_observed_upstreams" ]; then
			# A different RR type keeps the same queried name and dnsmasq routing,
			# while avoiding a common A/AAAA cache hit.
			dig +time=2 +tries=1 @127.0.0.1 -p 53 "$probe_host" TXT >/dev/null 2>&1 || true
			dns_observation_query='A,AAAA,TXT'
			sleep 1
			dns_observed_upstreams="$(probe_dns_observer_results)"
		fi
		probe_dns_observer_stop
		if [ -n "$dns_observed_upstreams" ]; then
			dns_observation='observed'
		else
			dns_observation='not_observed'
		fi
	fi

	runtime_state="$(get_state 2>/dev/null || printf normal)"
	active_row=''
	active_row="$(active_profile 2>/dev/null)" || active_row=''
	dns_default='WAN DHCP DNS'
	use_v2ray_dns=0
	mosdns_enabled=0
	mosdns_domains=''
	if [ "$runtime_state" = proxy ] && [ -n "$active_row" ]; then
		old_ifs="$IFS"
		IFS="$(printf '\t')"
		read -r _profile_protocol _profile_server _profile_port _profile_data _direct_dns _profile_proxy_ports _bypass_china \
			use_v2ray_dns mosdns_enabled mosdns_domains proxy_router_traffic <<EOF
$active_row
EOF
		IFS="$old_ifs"
		if [ "$use_v2ray_dns" = 1 ]; then
			dns_default="$(setting v2ray_dns_listen)"
		else
			dns_default="$(dnsmasq_endpoint "$_direct_dns")"
		fi
	fi
	dnsmasq_servers="$(uci -q get 'dhcp.@dnsmasq[0].server' 2>/dev/null | tr '\n' ',' | sed 's/,$//' || true)"
	[ -n "$dnsmasq_servers" ] || dnsmasq_servers='WAN DHCP DNS'
	dns_path='router -> dnsmasq 127.0.0.1#53 -> upstream not observed'
	dns_branch='upstream not observed'
	dns_entry='127.0.0.1#53 (dnsmasq)'
	if [ "$dns_status" = LITERAL_IP ]; then
		dns_observation='not_applicable'
		dns_entry='URL contains an IP literal; no DNS query'
		dnsmasq_servers='not applicable'
		dns_path='URL contains an IP literal; no DNS lookup'
		dns_branch='not applicable'
	elif [ "$dns_observation" = observed ]; then
		dns_path="router -> dnsmasq 127.0.0.1#53 -> $dns_observed_upstreams"
		dns_branch='observed dnsmasq upstream'
	elif [ "$dns_observation" = not_observed ]; then
		dns_path='DNS answer served without an observed dnsmasq upstream (cache or local answer)'
		dns_branch='no upstream packet observed'
	elif [ "$dns_observation" = unavailable ]; then
		dns_path='actual dnsmasq upstream unavailable; runtime observation could not be started'
		dns_branch='observation unavailable'
	fi

	curl_format='%{http_code}|%{remote_ip}|%{remote_port}|%{local_ip}|%{local_port}|%{time_connect}|%{time_appconnect}|%{time_starttransfer}|%{time_total}|%{ssl_verify_result}|%{http_version}'
	probe_dns_ip="$(printf '%s' "$dns_a" | cut -d, -f1)"
	if [ -z "$probe_dns_ip" ]; then
		probe_dns_ip="$(printf '%s' "$dns_aaaa" | cut -d, -f1)"
	fi
	resolve_ips=''
	if [ "$dns_status" != LITERAL_IP ]; then
		for resolved_ip in $(printf '%s,%s' "$dns_a" "$dns_aaaa" | tr ',' ' '); do
			[ -n "$resolved_ip" ] || continue
			case "$resolved_ip" in
				*:*) resolved_ip="[$resolved_ip]" ;;
			esac
			if [ -n "$resolve_ips" ]; then
				resolve_ips="$resolve_ips,$resolved_ip"
			else
				resolve_ips="$resolved_ip"
			fi
		done
	fi
	if [ "$dns_result" = failed ] || [ -z "$probe_dns_ip" ]; then
		curl_code=6
		: >"$probe_dir/curl"
		printf '%s\n' 'HTTPS request skipped because dnsmasq returned no usable address' >"$probe_dir/curl.err"
	elif [ "$dns_status" = LITERAL_IP ]; then
		if curl --noproxy '*' --silent --show-error --connect-timeout 5 --max-time 15 --output /dev/null \
			--write-out "$curl_format" "$probe_url" >"$probe_dir/curl" 2>"$probe_dir/curl.err"; then
			curl_code=0
		else
			curl_code=$?
		fi
	elif [ "$dns_status" != LITERAL_IP ]; then
		if curl --noproxy '*' --silent --show-error --connect-timeout 5 --max-time 15 --output /dev/null \
			--resolve "$probe_host:$probe_port:$resolve_ips" --write-out "$curl_format" \
			"$probe_url" >"$probe_dir/curl" 2>"$probe_dir/curl.err"; then
			curl_code=0
		else
			curl_code=$?
		fi
	else
		if curl --noproxy '*' --silent --show-error --connect-timeout 5 --max-time 15 --output /dev/null \
			--write-out "$curl_format" "$probe_url" >"$probe_dir/curl" 2>"$probe_dir/curl.err"; then
			curl_code=0
		else
			curl_code=$?
		fi
	fi
	curl_line="$(cat "$probe_dir/curl" 2>/dev/null || true)"
	old_ifs="$IFS"
	IFS='|'
	read -r http_code remote_ip remote_port local_ip local_port time_connect time_appconnect \
		time_starttransfer time_total ssl_verify_result http_version <<EOF
$curl_line
EOF
	IFS="$old_ifs"
	[ "$curl_code" -eq 0 ] && https_result=success || https_result=failed
	https_error="$(tr '\n' ' ' <"$probe_dir/curl.err" 2>/dev/null | cut -c1-300 || true)"
	[ -n "$remote_ip" ] || remote_ip='-'
	[ -n "$local_ip" ] || local_ip='-'
	[ -n "$http_code" ] || http_code='-'
	[ -n "$http_version" ] || http_version='-'
	effective_url="$probe_url"

	route_line=''
	route_query_ip="$remote_ip"
	case "$route_query_ip" in
		-|'') ;;
		*) route_line="$(ip route get "$route_query_ip" 2>/dev/null | sed -n '1p' || true)" ;;
	esac
	[ -n "$route_line" ] || {
		case "$route_query_ip" in
			-|'') ;;
			*) route_line="$(ip -6 route get "$route_query_ip" 2>/dev/null | sed -n '1p' || true)" ;;
		esac
	}
	route_dev="$(printf '%s\n' "$route_line" | awk '{for (i=1; i<=NF; i++) if ($i == "dev") print $(i+1)}' | sed -n '1p')"
	route_via="$(printf '%s\n' "$route_line" | awk '{for (i=1; i<=NF; i++) if ($i == "via") print $(i+1)}' | sed -n '1p')"
	route_src="$(printf '%s\n' "$route_line" | awk '{for (i=1; i<=NF; i++) if ($i == "src") print $(i+1)}' | sed -n '1p')"
	[ -n "$route_line" ] || route_line='-'
	[ -n "$route_dev" ] || route_dev='-'
	[ -n "$route_via" ] || route_via='-'
	[ -n "$route_src" ] || route_src='-'
	if [ "$runtime_state" = proxy ] && [ "${proxy_router_traffic:-0}" = 1 ]; then
		https_path='router-originated curl -> v2rayB OUTPUT redirect when ports and routing rules match'
	elif [ "$runtime_state" = proxy ]; then
		https_path='router-originated curl -> kernel OUTPUT route; router-originated TCP proxying is disabled for this profile'
	else
		https_path='router-originated curl -> kernel OUTPUT route; v2rayB is not in proxy mode'
	fi

	printf 'probe_url=%s\n' "$probe_url"
	printf 'probe_host=%s\n' "$probe_host"
	printf 'probe_scheme=%s\n' "$probe_scheme"
	printf 'runtime_state=%s\n' "$runtime_state"
	printf 'dns_entry=%s\n' "$dns_entry"
	printf 'dns_result=%s\n' "$dns_result"
	printf 'dns_status=%s\n' "$dns_status"
	printf 'dns_a=%s\n' "${dns_a:--}"
	printf 'dns_aaaa=%s\n' "${dns_aaaa:--}"
	printf 'dns_cname=%s\n' "${dns_cname:--}"
	printf 'dns_query_ms=%s\n' "$dns_query_ms"
	printf 'dnsmasq_servers=%s\n' "$dnsmasq_servers"
	printf 'dns_branch=%s\n' "$dns_branch"
	printf 'dns_path=%s\n' "$dns_path"
	printf 'dns_observation=%s\n' "$dns_observation"
	printf 'dns_observed_upstreams=%s\n' "${dns_observed_upstreams:--}"
	printf 'dns_observation_query=%s\n' "$dns_observation_query"
	printf '%s\n' 'dns_observation_method=nftables output trace filtered to the dnsmasq process'
	printf '%s\n' 'dns_observation_scope=dnsmasq outbound DNS packets during the probe window; correlation is best effort'
	if [ "$dns_observation" = observed ]; then
		printf '%s\n' 'dns_upstream_observation=actual outbound DNS packets observed during the probe window'
	elif [ "$dns_observation" = not_observed ]; then
		printf '%s\n' 'dns_upstream_observation=no outbound DNS packet observed; answer may be cached or local'
	else
		printf '%s\n' 'dns_upstream_observation=actual upstream could not be observed'
	fi
	printf 'https_result=%s\n' "$https_result"
	printf 'https_curl_code=%s\n' "$curl_code"
	printf 'https_http_code=%s\n' "$http_code"
	printf 'https_remote=%s:%s\n' "$remote_ip" "${remote_port:--}"
	printf 'https_local=%s:%s\n' "$local_ip" "${local_port:--}"
	printf 'https_http_version=%s\n' "$http_version"
	printf 'https_tls_verify=%s\n' "${ssl_verify_result:--}"
	printf 'https_effective_url=%s\n' "$effective_url"
	printf 'https_error=%s\n' "${https_error:--}"
	printf 'https_time_connect=%s\n' "${time_connect:--}"
	printf 'https_time_tls=%s\n' "${time_appconnect:--}"
	printf 'https_time_first_byte=%s\n' "${time_starttransfer:--}"
	printf 'https_time_total=%s\n' "${time_total:--}"
	printf 'route_device=%s\n' "$route_dev"
	printf 'route_gateway=%s\n' "$route_via"
	printf 'route_source=%s\n' "$route_src"
	printf 'route_kernel=%s\n' "$route_line"
	printf 'https_path=%s\n' "$https_path"
}

cmd_network_probe_start() {
	ensure_db
	probe_url="$1"
	[ ${#probe_url} -le 2048 ] || die "URL is too long"
	case "$probe_url" in
		http://*|https://*) ;;
		*) die "URL must start with http:// or https://" ;;
	esac

	mkdir -p "$PROBE_ROOT" || die "cannot create probe workspace"
	# Keep only recent completed jobs; a probe result is transient.
	find "$PROBE_ROOT" -mindepth 1 -maxdepth 1 -type d -mmin +60 -exec rm -rf {} + 2>/dev/null || :
	job_id="$(date +%s)-$$"
	job_dir="$PROBE_ROOT/$job_id"
	mkdir "$job_dir" || die "cannot create probe job"
	printf 'running\n' > "$job_dir/status" || die "cannot record probe job"
	printf '%s\n' "$job_id"

	(
		probe_rc=0
		cmd_network_probe "$probe_url" > "$job_dir/output" 2> "$job_dir/error" || probe_rc=$?
		printf '%s\n' "$probe_rc" > "$job_dir/rc.tmp"
		mv "$job_dir/rc.tmp" "$job_dir/rc"
		if [ "$probe_rc" -eq 0 ]; then
			printf 'done\n' > "$job_dir/status.tmp"
		else
			printf 'failed\n' > "$job_dir/status.tmp"
		fi
		mv "$job_dir/status.tmp" "$job_dir/status"
	) >/dev/null 2>&1 &
}

cmd_network_probe_status() {
	job_id="$1"
	case "$job_id" in
		''|*[!0-9-]*) die "invalid probe job id" ;;
	esac
	job_dir="$PROBE_ROOT/$job_id"
	[ -d "$job_dir" ] || die "probe job not found"
	job_status="$(sed -n '1p' "$job_dir/status" 2>/dev/null || printf running)"
	job_rc="$(sed -n '1p' "$job_dir/rc" 2>/dev/null || printf '%s\n' '-')"
	printf 'status=%s\n' "$job_status"
	printf 'rc=%s\n' "$job_rc"
	printf '%s\n' '--output--'
	cat "$job_dir/output" 2>/dev/null || :
	printf '%s\n' '--error--'
	cat "$job_dir/error" 2>/dev/null || :
}

cmd_dns_state() {
	ensure_db
	state="$(get_state)"
	row="$(active_profile)"
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	read -r protocol server port data_json direct_dns profile_proxy_ports bypass_china \
		use_v2ray_dns mosdns_enabled mosdns_domains proxy_router_traffic <<EOF
$row
EOF
	IFS="$old_ifs"
	direct_rule="$(active_profile_match_rules | sed -n '/^[[:space:]]*[^#[:space:]]/{p;q;}')"
	[ -n "$direct_rule" ] || direct_rule="$(sed -n '/^[[:space:]]*[^#[:space:]]/{p;q;}' "$RULE_DIR/direct_domains.txt" 2>/dev/null || true)"
	accel_count=0
	if [ -d "$DNSMASQ_CONFIG_DIR" ]; then
		accel_count="$(find "$DNSMASQ_CONFIG_DIR" -maxdepth 1 -type f -iname '*china*' 2>/dev/null | wc -l | tr -d '[:space:]')"
	fi
	printf 'runtime_state=%s\n' "$state"
	printf 'dnsmasq_listen=%s\n' '0.0.0.0:53'
	if [ "$state" = proxy ]; then
		if [ "$use_v2ray_dns" = 1 ]; then
			printf 'dnsmasq_default=%s\n' "$(setting v2ray_dns_listen)"
		else
			printf 'dnsmasq_default=%s\n' "$(dnsmasq_endpoint "$direct_dns")"
		fi
	else
		printf 'dnsmasq_default=WAN DHCP DNS\n'
	fi
	printf 'dnsmasq_confdir=%s\n' "$DNSMASQ_CONFIG_DIR"
	printf 'china_accel_files=%s\n' "${accel_count:-0}"
	printf 'use_v2ray_dns=%s\n' "$use_v2ray_dns"
	printf 'v2ray_dns_listen=%s\n' "$(setting v2ray_dns_listen)"
	printf 'mosdns_enabled=%s\n' "$mosdns_enabled"
	printf 'mosdns_listen=%s\n' "$(setting mosdns_listen)"
	printf 'mosdns_route_suffix=%s\n' "$mosdns_domains"
	printf 'direct_dns=%s\n' "$direct_dns"
	printf 'proxy_router_traffic=%s\n' "$proxy_router_traffic"
	printf 'direct_rule=%s\n' "$direct_rule"
	printf 'nft_direct_sets=%s\n' 'direct4,direct6'
	printf 'nft_direct_static_sets=%s\n' 'direct_static4,direct_static6'
	printf 'nft_force_proxy_sets=%s\n' 'force_proxy4,force_proxy6,force_proxy'
}

cmd_status() {
	ensure_db
	printf 'state=%s\n' "$(get_state)"
	printf 'active_engine=%s\n' "$(setting active_engine)"
	printf 'active_profile=%s\n' "$(setting active_profile)"
	printf 'service_enabled=%s\n' "$(setting service_enabled)"
	if draft_pending; then draft_state=1; else draft_state=0; fi
	printf 'draft_pending=%s\n' "$draft_state"
	printf 'proxy_mode=%s\n' "$(setting proxy_mode)"
	printf 'watchdog_enabled=%s\n' "$(setting watchdog_enabled)"
	printf 'fallback_on_failure=%s\n' "$(setting fallback_on_failure)"
	printf 'mosdns_listen=%s\n' "$(setting mosdns_listen)"
	printf 'v2ray_dns_listen=%s\n' "$(setting v2ray_dns_listen)"
	printf 'transparent_proxy_port=%s\n' "$(setting transparent_proxy_port)"
	printf 'force_proxy_port=%s\n' "$(setting force_proxy_port)"
	row="$(active_profile 2>/dev/null || true)"
	if [ -n "$row" ]; then
		old_ifs="$IFS"
		IFS="$(printf '\t')"
		read -r profile_protocol profile_server profile_port profile_data \
			profile_direct_dns profile_proxy_ports profile_bypass_china \
			profile_use_v2ray_dns profile_mosdns_enabled profile_mosdns_domains profile_proxy_router_traffic <<EOF
$row
EOF
		IFS="$old_ifs"
		printf 'profile_direct_dns=%s\n' "$profile_direct_dns"
		printf 'profile_transparent_proxy_ports=%s\n' "$profile_proxy_ports"
		printf 'profile_bypass_china=%s\n' "$profile_bypass_china"
		printf 'profile_use_v2ray_dns=%s\n' "$profile_use_v2ray_dns"
		printf 'profile_mosdns_enabled=%s\n' "$profile_mosdns_enabled"
		printf 'profile_mosdns_domains=%s\n' "$profile_mosdns_domains"
		printf 'profile_proxy_router_traffic=%s\n' "$profile_proxy_router_traffic"
	fi
}

