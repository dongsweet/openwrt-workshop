#!/bin/sh

# v2rayB control boundary. The SQLite database is the source of truth;
# everything under /tmp/v2rayB is disposable runtime output.

set -eu

DB="${V2RAYB_DB:-/etc/v2rayB/v2rayB.db}"
SCHEMA="${V2RAYB_SCHEMA:-/etc/v2rayB/schema.sql}"
STATE_DIR="${V2RAYB_STATE_DIR:-/tmp/v2rayB}"
ACTIVE_DIR="$STATE_DIR/active"
NFT_MARKER="$STATE_DIR/nft-managed"
RULE_DIR="${V2RAYB_RULE_DIR:-/etc/v2rayB/rules}"
SQLITE3="${V2RAYB_SQLITE3:-sqlite3}"
V2RAY_BIN="${V2RAYB_V2RAY_BIN:-/usr/bin/v2ray}"
MOSDNS_BIN="${V2RAYB_MOSDNS_BIN:-/usr/bin/mosdns}"
DNSMASQ_CONFIG_DIR="${V2RAYB_DNSMASQ_DIR:-/etc/dnsmasq.d}"
MOSDNS_ROUTE_SUFFIX="xn--ngstr-lra8j.com"

die() {
	echo "v2rayBctl: $*" >&2
	exit 1
}

require_sqlite() {
	command -v "$SQLITE3" >/dev/null 2>&1 || die "sqlite3 is required"
}

sql_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_name() {
	case "$1" in
		''|*[!A-Za-z0-9._-]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_server() {
	case "$1" in
		''|*[!A-Za-z0-9._:\[\]-]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_protocol() {
	case "$1" in
		vless|vmess|trojan|shadowsocks) return 0 ;;
		*) return 1 ;;
	esac
}

format_ports() {
	ports="$1"
	old_ifs="$IFS"
	IFS=,
	set -- $ports
	IFS="$old_ifs"
	[ "$#" -gt 0 ] || return 1
	case "$ports" in *,|,*|*,,*) return 1 ;; esac
	formatted=""
	for item in "$@"; do
		case "$item" in
			*-*)
				start="${item%%-*}"
				end="${item#*-}"
				case "$end" in *-*) return 1 ;; esac
				is_uint "$start" && is_uint "$end" || return 1
				[ "$start" -ge 1 ] 2>/dev/null && [ "$end" -le 65535 ] 2>/dev/null || return 1
				[ "$start" -le "$end" ] 2>/dev/null || return 1
				port="$start-$end"
				;;
			*)
				is_uint "$item" || return 1
				[ "$item" -ge 1 ] 2>/dev/null && [ "$item" -le 65535 ] 2>/dev/null || return 1
				port="$item"
				;;
		esac
		if [ -n "$formatted" ]; then
			formatted="$formatted, $port"
		else
			formatted="$port"
		fi
	done
	printf '{ %s }' "$formatted"
}

validate_dns_endpoint() {
	value="$1"
	case "$value" in *[!A-Za-z0-9.:\[\]-]*|*:|:*) return 1 ;; esac
	port="${value##*:}"
	is_uint "$port" && [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 1
	[ -n "${value%:*}" ]
}

validate_dns_domains() {
	value="$1"
	[ -n "$value" ] || return 0
	old_ifs="$IFS"
	IFS=,
	set -- $value
	IFS="$old_ifs"
	case "$value" in *,|,*|*,,*) return 1 ;; esac
	for domain in "$@"; do
		case "$domain" in
			''|*[!A-Za-z0-9.-]*|.*|*.) return 1 ;;
		esac
	done
}

validate_mosdns_rules() {
	value="$1"
	[ -n "$value" ] || return 0
	old_ifs="$IFS"
	IFS='
'
	for rule in $value; do
		case "$rule" in
			''|'#'*) continue ;;
			regexp:*|domain:*|full:*) ;;
			*) IFS="$old_ifs"; return 1 ;;
		esac
	done
	IFS="$old_ifs"
}

validate_profile_policy() {
	direct_dns="$1"
	ports="$2"
	bypass_china="$3"
	use_v2ray_dns="${4:-1}"
	mosdns_enabled="${5:-1}"
	mosdns_domains="${6:-xn--ngstr-lra8j.com}"
	mosdns_match_rules="${7:-}"
	validate_dns_endpoint "$direct_dns" || die "invalid profile DNS endpoint"
	format_ports "$ports" >/dev/null || die "invalid profile transparent proxy port list"
	case "$bypass_china" in 0|1) ;; *) die "profile bypass_china must be 0 or 1" ;; esac
	case "$use_v2ray_dns" in 0|1) ;; *) die "profile use_v2ray_dns must be 0 or 1" ;; esac
	case "$mosdns_enabled" in 0|1) ;; *) die "profile mosdns_enabled must be 0 or 1" ;; esac
	validate_dns_domains "$mosdns_domains" || die "invalid MosDNS domain list"
	if [ "$mosdns_enabled" = 1 ] && [ -z "$mosdns_domains" ]; then
		die "MosDNS is enabled but no domains are configured"
	fi
	validate_mosdns_rules "$mosdns_match_rules" || die "invalid MosDNS match rules"
}

db_sql() {
	"$SQLITE3" -batch -bail "$DB" "PRAGMA foreign_keys=ON; $1"
}

setting() {
	db_sql "SELECT value FROM settings WHERE key=$(sql_quote "$1");" | sed -n '1p'
}

draft_pending() {
	[ "$(setting draft_pending)" = 1 ] || return 1
	count="$(db_sql "SELECT (SELECT COUNT(*) FROM draft_nodes) + (SELECT COUNT(*) FROM draft_profiles) + (SELECT COUNT(*) FROM draft_policies);" | tr -d '[:space:]')"
	[ "$count" -gt 0 ] || return 1
}

current_setting() {
	if draft_pending && [ "$(db_sql "SELECT COUNT(*) FROM settings WHERE key=$(sql_quote "draft_$1");" | tr -d '[:space:]')" = 1 ]; then
		setting "draft_$1"
	else
		setting "$1"
	fi
}

begin_draft() {
	draft_pending && return 0
	db_sql "BEGIN;
		DELETE FROM draft_profile_nodes;
		DELETE FROM draft_profiles;
		DELETE FROM draft_nodes;
		DELETE FROM draft_policies;
		INSERT INTO draft_policies(id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,created_at,updated_at) SELECT id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,created_at,updated_at FROM policies;
		INSERT INTO draft_nodes(id,source_id,name,protocol,server,port,data_json,enabled,last_latency_ms,last_checked_at,last_error,created_at,updated_at) SELECT id,source_id,name,protocol,server,port,data_json,enabled,last_latency_ms,last_checked_at,last_error,created_at,updated_at FROM nodes;
		INSERT INTO draft_profiles(id,name,engine,policy_id,engine_options_json,enabled,created_at,updated_at) SELECT id,name,engine,policy_id,engine_options_json,enabled,created_at,updated_at FROM profiles;
		INSERT INTO draft_profile_nodes(profile_id,node_id,role,priority) SELECT profile_id,node_id,role,priority FROM profile_nodes;
		DELETE FROM settings WHERE key IN ('draft_active_profile','draft_direct_dns','draft_transparent_proxy_ports');
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_active_profile',value,CURRENT_TIMESTAMP FROM settings WHERE key='active_profile';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_direct_dns',value,CURRENT_TIMESTAMP FROM settings WHERE key='direct_dns';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_transparent_proxy_ports',value,CURRENT_TIMESTAMP FROM settings WHERE key='transparent_proxy_ports';
		INSERT INTO settings(key,value,updated_at) VALUES('draft_pending','1',CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value='1',updated_at=CURRENT_TIMESTAMP;
		COMMIT;"
}

draft_change_begin() {
	DRAFT_CHANGE_DEPTH=$(( ${DRAFT_CHANGE_DEPTH:-0} + 1 ))
	[ "$DRAFT_CHANGE_DEPTH" -eq 1 ] || return 0
	DRAFT_CHANGE_NEW=0
	if ! draft_pending; then
		DRAFT_CHANGE_NEW=1
		begin_draft
	fi
}

draft_change_commit() {
	DRAFT_CHANGE_DEPTH=$(( ${DRAFT_CHANGE_DEPTH:-1} - 1 ))
	[ "$DRAFT_CHANGE_DEPTH" -le 0 ] || return 0
	if [ "${DRAFT_CHANGE_NEW:-0}" = 1 ]; then
		version="$(setting applied_config_version)"
		is_uint "$version" || version=1
		version=$((version + 1))
	else
		version="$(setting draft_config_version)"
		is_uint "$version" || version="$(setting applied_config_version)"
		is_uint "$version" || version=1
		version=$((version + 1))
	fi
	db_sql "INSERT INTO settings(key,value,updated_at) VALUES('draft_config_version',$(sql_quote "$version"),CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP;"
	DRAFT_CHANGE_DEPTH=0
	DRAFT_CHANGE_NEW=0
}

discard_drafts() {
	db_sql "BEGIN;
		DELETE FROM draft_profile_nodes;
		DELETE FROM draft_profiles;
		DELETE FROM draft_nodes;
		DELETE FROM draft_policies;
		INSERT INTO settings(key,value,updated_at) VALUES('draft_pending','0',CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value='0',updated_at=CURRENT_TIMESTAMP;
		COMMIT;"
}

set_draft_setting() {
	key="$1"
	value="$2"
	db_sql "INSERT INTO settings(key,value,updated_at) VALUES('draft_$key',$(sql_quote "$value"),CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP;"
}

ensure_db() {
	require_sqlite
	[ -f "$SCHEMA" ] || die "schema not found: $SCHEMA"
	mkdir -p "$(dirname "$DB")" "$STATE_DIR" "$ACTIVE_DIR" "$RULE_DIR"
	if [ ! -s "$DB" ]; then
		"$SQLITE3" -batch -bail "$DB" < "$SCHEMA"
		chmod 600 "$DB"
		return 0
	fi
	version="$(db_sql 'PRAGMA user_version;' | tr -d '[:space:]')"
	if [ "$version" = 1 ]; then
		db_sql "ALTER TABLE policies ADD COLUMN direct_dns TEXT; ALTER TABLE policies ADD COLUMN transparent_proxy_ports TEXT; ALTER TABLE policies ADD COLUMN bypass_china INTEGER NOT NULL DEFAULT 1 CHECK (bypass_china IN (0, 1)); INSERT OR IGNORE INTO schema_migrations(version) VALUES (2); PRAGMA user_version=2;"
		version=2
	fi
	if [ "$version" = 2 ]; then
		db_sql "ALTER TABLE policies ADD COLUMN use_v2ray_dns INTEGER NOT NULL DEFAULT 1 CHECK (use_v2ray_dns IN (0, 1)); ALTER TABLE policies ADD COLUMN mosdns_enabled INTEGER NOT NULL DEFAULT 1 CHECK (mosdns_enabled IN (0, 1)); ALTER TABLE policies ADD COLUMN mosdns_domains TEXT; ALTER TABLE policies ADD COLUMN mosdns_match_rules TEXT; INSERT OR IGNORE INTO schema_migrations(version) VALUES (3); PRAGMA user_version=3;"
		version=3
	fi
	if [ "$version" = 3 ]; then
		db_sql "CREATE TABLE IF NOT EXISTS draft_nodes (id INTEGER PRIMARY KEY, source_id INTEGER, name TEXT NOT NULL, protocol TEXT NOT NULL, server TEXT NOT NULL, port INTEGER NOT NULL CHECK (port BETWEEN 1 AND 65535), data_json TEXT NOT NULL DEFAULT '{}', enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)), last_latency_ms INTEGER, last_checked_at TEXT, last_error TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, UNIQUE(source_id, name)); CREATE TABLE IF NOT EXISTS draft_policies (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, dns_policy_json TEXT NOT NULL DEFAULT '{}', routing_policy_json TEXT NOT NULL DEFAULT '{}', direct_dns TEXT, transparent_proxy_ports TEXT, bypass_china INTEGER NOT NULL DEFAULT 1 CHECK (bypass_china IN (0, 1)), use_v2ray_dns INTEGER NOT NULL DEFAULT 1 CHECK (use_v2ray_dns IN (0, 1)), mosdns_enabled INTEGER NOT NULL DEFAULT 1 CHECK (mosdns_enabled IN (0, 1)), mosdns_domains TEXT, mosdns_match_rules TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP); CREATE TABLE IF NOT EXISTS draft_profiles (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, engine TEXT NOT NULL, policy_id INTEGER, engine_options_json TEXT NOT NULL DEFAULT '{}', enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP); CREATE TABLE IF NOT EXISTS draft_profile_nodes (profile_id INTEGER NOT NULL, node_id INTEGER NOT NULL, role TEXT NOT NULL DEFAULT 'primary', priority INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(profile_id, node_id)); INSERT OR IGNORE INTO schema_migrations(version) VALUES (4); PRAGMA user_version=4;"
		version=4
	fi
	[ "$version" = 4 ] || die "unsupported database schema version: $version"
	db_sql "INSERT OR IGNORE INTO settings(key, value) VALUES ('direct_dns', '223.5.5.5:53'), ('force_proxy_port', '12346'), ('transparent_proxy_ports', '80,443,8080,8443'), ('applied_config_version', '1'), ('draft_config_version', '1'), ('draft_pending', '0'), ('draft_active_profile', ''), ('draft_direct_dns', '223.5.5.5:53'), ('draft_transparent_proxy_ports', '80,443,8080,8443');"
}

set_state() {
	case "$1" in
		normal|starting|proxy|stopping|degraded) ;;
		*) die "invalid runtime state: $1" ;;
	esac
	mkdir -p "$STATE_DIR"
	tmp="$STATE_DIR/state.tmp.$$"
	printf '%s\n' "$1" > "$tmp"
	mv "$tmp" "$STATE_DIR/state"
}

get_state() {
	if [ -s "$STATE_DIR/state" ]; then
		sed -n '1p' "$STATE_DIR/state"
	else
		printf '%s\n' normal
	fi
}

cmd_init_db() {
	ensure_db
	[ -f "$RULE_DIR/direct_domains.txt" ] || : > "$RULE_DIR/direct_domains.txt"
	[ -f "$RULE_DIR/force_proxy_domains.txt" ] || : > "$RULE_DIR/force_proxy_domains.txt"
	[ -f "$RULE_DIR/direct_ipv4.txt" ] || : > "$RULE_DIR/direct_ipv4.txt"
	[ -f "$RULE_DIR/direct_ipv6.txt" ] || : > "$RULE_DIR/direct_ipv6.txt"
}

cmd_get_setting() {
	ensure_db
	case "$1" in
		''|*[!A-Za-z0-9_./-]*) die "invalid setting key" ;;
	esac
	setting "$1"
}

cmd_set_setting() {
	ensure_db
	key="$1"
	value="$2"
	case "$key" in
		''|*[!A-Za-z0-9_./-]*) die "invalid setting key" ;;
	esac
	case "$key" in
		direct_dns)
			validate_dns_endpoint "$value" || die "invalid DNS endpoint"
			;;
		transparent_proxy_ports)
			format_ports "$value" >/dev/null || die "invalid transparent proxy port list"
			;;
	esac
	case "$key" in
		direct_dns|transparent_proxy_ports|active_profile)
			draft_change_begin
			set_draft_setting "$key" "$value"
			draft_change_commit
			;;
		*)
			db_sql "INSERT INTO settings(key, value, updated_at) VALUES($(sql_quote "$key"), $(sql_quote "$value"), CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=CURRENT_TIMESTAMP;"
			;;
	esac
}

cmd_set_state() {
	set_state "$1"
}

cmd_add_source() {
	ensure_db
	type="$1"
	name="$2"
	url="${3:-}"
	format="${4:-}"
	is_name "$name" || die "invalid source name"
	case "$type" in
		manual|subscription|imported) ;;
		*) die "invalid source type" ;;
	esac
	db_sql "INSERT INTO sources(type, name, url, format, updated_at) VALUES($(sql_quote "$type"), $(sql_quote "$name"), $(sql_quote "$url"), $(sql_quote "$format"), CURRENT_TIMESTAMP) ON CONFLICT(type, name) DO UPDATE SET url=excluded.url, format=excluded.format, updated_at=CURRENT_TIMESTAMP;"
}

cmd_add_manual_node() {
	ensure_db
	name="$1"
	protocol="$2"
	server="$3"
	port="$4"
	data_json="${5:-}"
	is_name "$name" || die "invalid node name"
	is_protocol "$protocol" || die "unsupported protocol: $protocol"
	is_server "$server" || die "invalid server"
	is_uint "$port" || die "port must be numeric"
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || die "port out of range"
	[ -n "$data_json" ] || die "data_json is required"
	case "$data_json" in
		\{*\}) ;;
		*) die "data_json must be a JSON object" ;;
	esac
	db_sql "INSERT INTO sources(type, name, updated_at) VALUES('manual', 'manual', CURRENT_TIMESTAMP) ON CONFLICT(type, name) DO NOTHING;"
	source_id="$(db_sql "SELECT id FROM sources WHERE type='manual' AND name='manual';" | sed -n '1p')"
	draft_change_begin
	db_sql "INSERT INTO draft_nodes(source_id, name, protocol, server, port, data_json, updated_at) VALUES($source_id, $(sql_quote "$name"), $(sql_quote "$protocol"), $(sql_quote "$server"), $port, $(sql_quote "$data_json"), CURRENT_TIMESTAMP) ON CONFLICT(source_id, name) DO UPDATE SET protocol=excluded.protocol, server=excluded.server, port=excluded.port, data_json=excluded.data_json, enabled=1, updated_at=CURRENT_TIMESTAMP;"
	draft_change_commit
	db_sql "SELECT id FROM draft_nodes WHERE source_id=$source_id AND name=$(sql_quote "$name");" | sed -n '1p'
}

cmd_set_profile_policy() {
	ensure_db
	profile_id="$1"
	direct_dns="$2"
	transparent_proxy_ports="$3"
	bypass_china="$4"
	use_v2ray_dns="${5:-1}"
	mosdns_enabled="${6:-1}"
	mosdns_domains="${7:-xn--ngstr-lra8j.com}"
	mosdns_match_rules="${8:-}"
	is_uint "$profile_id" || die "profile id must be numeric"
	validate_profile_policy "$direct_dns" "$transparent_proxy_ports" "$bypass_china" \
		"$use_v2ray_dns" "$mosdns_enabled" "$mosdns_domains" "$mosdns_match_rules"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	policy_id="$(db_sql "SELECT COALESCE(policy_id, 0) FROM draft_profiles WHERE id=$profile_id;" | sed -n '1p')"
	if is_uint "$policy_id" && [ "$policy_id" -gt 0 ] 2>/dev/null; then
		count="$(db_sql "SELECT COUNT(*) FROM draft_policies WHERE id=$policy_id;" | tr -d '[:space:]')"
		if [ "$count" = 0 ]; then
			db_sql "INSERT OR IGNORE INTO draft_policies(id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,created_at,updated_at) SELECT id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,created_at,updated_at FROM policies WHERE id=$policy_id;"
			count="$(db_sql "SELECT COUNT(*) FROM draft_policies WHERE id=$policy_id;" | tr -d '[:space:]')"
		fi
		[ "$count" = 1 ] || die "profile policy is missing from both draft and applied configuration"
		db_sql "UPDATE draft_policies SET direct_dns=$(sql_quote "$direct_dns"), transparent_proxy_ports=$(sql_quote "$transparent_proxy_ports"), bypass_china=$bypass_china, use_v2ray_dns=$use_v2ray_dns, mosdns_enabled=$mosdns_enabled, mosdns_domains=$(sql_quote "$mosdns_domains"), mosdns_match_rules=$(sql_quote "$mosdns_match_rules"), updated_at=CURRENT_TIMESTAMP WHERE id=$policy_id; UPDATE draft_profiles SET policy_id=$policy_id, updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id;"
	else
		policy_name="profile-$profile_id"
		policy_id="$(db_sql "INSERT INTO draft_policies(name, direct_dns, transparent_proxy_ports, bypass_china, use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules, updated_at) VALUES($(sql_quote "$policy_name"), $(sql_quote "$direct_dns"), $(sql_quote "$transparent_proxy_ports"), $bypass_china, $use_v2ray_dns, $mosdns_enabled, $(sql_quote "$mosdns_domains"), $(sql_quote "$mosdns_match_rules"), CURRENT_TIMESTAMP) ON CONFLICT(name) DO UPDATE SET direct_dns=excluded.direct_dns, transparent_proxy_ports=excluded.transparent_proxy_ports, bypass_china=excluded.bypass_china, use_v2ray_dns=excluded.use_v2ray_dns, mosdns_enabled=excluded.mosdns_enabled, mosdns_domains=excluded.mosdns_domains, mosdns_match_rules=excluded.mosdns_match_rules, updated_at=CURRENT_TIMESTAMP; SELECT id FROM draft_policies WHERE name=$(sql_quote "$policy_name");" | sed -n '1p')"
		is_uint "$policy_id" || die "failed to create profile policy"
		db_sql "UPDATE draft_profiles SET policy_id=$policy_id, updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id;"
	fi
	draft_change_commit
}

cmd_add_profile() {
	ensure_db
	name="$1"
	node_id="$2"
	direct_dns="${3:-$(current_setting direct_dns)}"
	transparent_proxy_ports="${4:-$(current_setting transparent_proxy_ports)}"
	bypass_china="${5:-1}"
	use_v2ray_dns="${6:-1}"
	mosdns_enabled="${7:-1}"
	mosdns_domains="${8:-xn--ngstr-lra8j.com}"
	mosdns_match_rules="${9:-}"
	is_name "$name" || die "invalid profile name"
	is_uint "$node_id" || die "node id must be numeric"
	validate_profile_policy "$direct_dns" "$transparent_proxy_ports" "$bypass_china" \
		"$use_v2ray_dns" "$mosdns_enabled" "$mosdns_domains" "$mosdns_match_rules"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id AND enabled=1;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found or disabled: $node_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE name=$(sql_quote "$name");" | tr -d '[:space:]')"
	[ "$count" = 0 ] || die "profile already exists: $name"
	db_sql "INSERT INTO draft_profiles(name, engine, updated_at) VALUES($(sql_quote "$name"), 'v2ray', CURRENT_TIMESTAMP);"
	profile_id="$(db_sql "SELECT id FROM draft_profiles WHERE name=$(sql_quote "$name");" | sed -n '1p')"
	db_sql "DELETE FROM draft_profile_nodes WHERE profile_id=$profile_id; INSERT INTO draft_profile_nodes(profile_id, node_id, role, priority) VALUES($profile_id, $node_id, 'primary', 0);"
	cmd_set_profile_policy "$profile_id" "$direct_dns" "$transparent_proxy_ports" "$bypass_china" \
		"$use_v2ray_dns" "$mosdns_enabled" "$mosdns_domains" "$mosdns_match_rules"
	set_draft_setting active_profile "$profile_id"
	draft_change_commit
	printf '%s\n' "$profile_id"
}

cmd_update_node() {
	ensure_db
	node_id="$1"
	name="$2"
	protocol="$3"
	server="$4"
	port="$5"
	data_json="${6:-}"
	is_uint "$node_id" || die "node id must be numeric"
	is_name "$name" || die "invalid node name"
	is_protocol "$protocol" || die "unsupported protocol: $protocol"
	is_server "$server" || die "invalid server"
	is_uint "$port" || die "port must be numeric"
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || die "port out of range"
	[ -n "$data_json" ] || die "data_json is required"
	case "$data_json" in
		\{*\}) ;;
		*) die "data_json must be a JSON object" ;;
	esac
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found: $node_id"
	source_id="$(db_sql "SELECT source_id FROM draft_nodes WHERE id=$node_id;" | sed -n '1p')"
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE source_id=$source_id AND name=$(sql_quote "$name") AND id<>$node_id;" | tr -d '[:space:]')"
	[ "$count" = 0 ] || die "node name already exists: $name"
	db_sql "UPDATE draft_nodes SET name=$(sql_quote "$name"), protocol=$(sql_quote "$protocol"), server=$(sql_quote "$server"), port=$port, data_json=$(sql_quote "$data_json"), updated_at=CURRENT_TIMESTAMP WHERE id=$node_id;"
	draft_change_commit
	printf '%s\n' "$node_id"
}

cmd_set_node_enabled() {
	ensure_db
	node_id="$1"
	enabled="$2"
	is_uint "$node_id" || die "node id must be numeric"
	case "$enabled" in 0|1) ;; *) die "enabled must be 0 or 1" ;; esac
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found: $node_id"
	if [ "$enabled" = 0 ] && [ "$(db_sql "SELECT COUNT(*) FROM draft_profile_nodes WHERE node_id=$node_id;" | tr -d '[:space:]')" != 0 ]; then
		die "node is referenced by a profile; remove the profile first"
	fi
	db_sql "UPDATE draft_nodes SET enabled=$enabled, updated_at=CURRENT_TIMESTAMP WHERE id=$node_id;"
	draft_change_commit
}

cmd_delete_node() {
	ensure_db
	node_id="$1"
	is_uint "$node_id" || die "node id must be numeric"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found: $node_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profile_nodes WHERE node_id=$node_id;" | tr -d '[:space:]')"
	[ "$count" = 0 ] || die "node is referenced by a profile; remove the profile first"
	db_sql "DELETE FROM draft_nodes WHERE id=$node_id;"
	draft_change_commit
}

cmd_update_profile() {
	ensure_db
	profile_id="$1"
	name="$2"
	node_id="$3"
	is_uint "$profile_id" || die "profile id must be numeric"
	is_name "$name" || die "invalid profile name"
	is_uint "$node_id" || die "node id must be numeric"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id AND enabled=1;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found or disabled: $node_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE name=$(sql_quote "$name") AND id<>$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 0 ] || die "profile already exists: $name"
	db_sql "UPDATE draft_profiles SET name=$(sql_quote "$name"), updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id; DELETE FROM draft_profile_nodes WHERE profile_id=$profile_id; INSERT INTO draft_profile_nodes(profile_id, node_id, role, priority) VALUES($profile_id, $node_id, 'primary', 0);"
	if [ "$#" -ge 4 ]; then
		direct_dns="$4"
		transparent_proxy_ports="$5"
		bypass_china="$6"
		use_v2ray_dns="${7:-1}"
		mosdns_enabled="${8:-1}"
		mosdns_domains="${9:-xn--ngstr-lra8j.com}"
		mosdns_match_rules="${10:-}"
		cmd_set_profile_policy "$profile_id" "$direct_dns" "$transparent_proxy_ports" "$bypass_china" \
			"$use_v2ray_dns" "$mosdns_enabled" "$mosdns_domains" "$mosdns_match_rules"
	fi
	draft_change_commit
	printf '%s\n' "$profile_id"
}

cmd_set_profile_enabled() {
	ensure_db
	profile_id="$1"
	enabled="$2"
	is_uint "$profile_id" || die "profile id must be numeric"
	case "$enabled" in 0|1) ;; *) die "enabled must be 0 or 1" ;; esac
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	active_profile_id="$(current_setting active_profile)"
	if [ "$enabled" = 0 ] && [ "$active_profile_id" = "$profile_id" ]; then
		die "active profile must be switched before it can be disabled"
	fi
	db_sql "UPDATE draft_profiles SET enabled=$enabled, updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id;"
	draft_change_commit
}

cmd_delete_profile() {
	ensure_db
	profile_id="$1"
	is_uint "$profile_id" || die "profile id must be numeric"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	active_profile_id="$(current_setting active_profile)"
	[ "$active_profile_id" != "$profile_id" ] || die "active profile must be switched before it can be deleted"
	policy_id="$(db_sql "SELECT COALESCE(policy_id, 0) FROM draft_profiles WHERE id=$profile_id;" | sed -n '1p')"
	db_sql "DELETE FROM draft_profile_nodes WHERE profile_id=$profile_id; DELETE FROM draft_profiles WHERE id=$profile_id;"
	if is_uint "$policy_id" && [ "$policy_id" -gt 0 ] 2>/dev/null; then
		db_sql "DELETE FROM draft_policies WHERE id=$policy_id AND NOT EXISTS (SELECT 1 FROM draft_profiles WHERE policy_id=$policy_id);"
	fi
	draft_change_commit
}

cmd_select_profile() {
	ensure_db
	profile_id="$1"
	is_uint "$profile_id" || die "profile id must be numeric"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id AND enabled=1;" | tr -d '[:space:]')"
