cmd_update_profile() {
	ensure_db
	profile_id="$1"
	name="$2"
	node_id="$3"
	is_uint "$profile_id" || die "profile id must be numeric"
	is_name "$name" || die "invalid profile name"
	is_uint "$node_id" || die "node id must be numeric"
	draft_change_begin
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE id=$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "profile not found: $profile_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_nodes WHERE id=$node_id AND enabled=1;" | tr -d '[:space:]')"
	[ "$count" = 1 ] || die "node not found or disabled: $node_id"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles WHERE name=$(sql_quote "$name") AND id<>$profile_id;" | tr -d '[:space:]')"
	[ "$count" = 0 ] || die "profile already exists: $name"
	engine="${15:-}"
	if [ -n "$engine" ]; then
		is_engine "$engine" || die "invalid profile engine: $engine"
	else
		engine="$(db_sql "SELECT engine FROM draft_profiles WHERE id=$profile_id;" | sed -n '1p')"
		is_engine "$engine" || engine=v2ray
	fi
	db_sql "UPDATE draft_profiles SET name=$(sql_quote "$name"), engine=$(sql_quote "$engine"), updated_at=CURRENT_TIMESTAMP WHERE id=$profile_id; DELETE FROM draft_profile_nodes WHERE profile_id=$profile_id; INSERT INTO draft_profile_nodes(profile_id, node_id, role, priority) VALUES($profile_id, $node_id, 'primary', 0);"
	if [ "$#" -ge 4 ]; then
		direct_dns="$4"
		transparent_proxy_ports="$5"
		bypass_china="$6"
		use_v2ray_dns="${7:-1}"
		mosdns_enabled="${8:-1}"
		mosdns_domains="${9:-xn--ngstr-lra8j.com}"
		mosdns_match_rules="${10:-}"
		proxy_router_traffic="${11:-0}"
		transparent_proxy_port="${12:-12345}"
		probe_enabled="${13:-1}"
		probe_port="${14:-12346}"
		force_proxy_domains="${16:-}"
		cmd_set_profile_policy "$profile_id" "$direct_dns" "$transparent_proxy_ports" "$bypass_china" \
			"$use_v2ray_dns" "$mosdns_enabled" "$mosdns_domains" "$mosdns_match_rules" "$proxy_router_traffic" \
			"$transparent_proxy_port" "$probe_enabled" "$probe_port" "$force_proxy_domains"
	fi
	draft_change_commit
	printf '%s\n' "$profile_id"
}

