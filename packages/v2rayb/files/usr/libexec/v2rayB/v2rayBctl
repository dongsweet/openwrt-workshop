cmd_status() {
	ensure_db
	printf 'state=%s\n' "$(get_state)"
	printf 'direct_dns_upstreams=%s\n' "$(setting direct_dns_upstreams)"
	printf 'draft_direct_dns_upstreams=%s\n' "$(setting draft_direct_dns_upstreams)"
	printf 'bypass_sources4=%s\n' "$(setting bypass_sources4)"
	printf 'draft_bypass_sources4=%s\n' "$(setting draft_bypass_sources4)"
	printf 'active_engine=%s\n' "$(selected_engine)"
	printf 'active_profile=%s\n' "$(setting active_profile)"
	printf 'service_enabled=%s\n' "$(setting service_enabled)"
	if draft_pending; then draft_state=1; else draft_state=0; fi
	printf 'draft_pending=%s\n' "$draft_state"
	printf 'proxy_mode=%s\n' "$(setting proxy_mode)"
	printf 'watchdog_enabled=%s\n' "$(setting watchdog_enabled)"
	printf 'draft_watchdog_enabled=%s\n' "$(setting draft_watchdog_enabled)"
	printf 'watchdog_auto_recover=%s\n' "$(setting watchdog_auto_recover)"
	printf 'draft_watchdog_auto_recover=%s\n' "$(setting draft_watchdog_auto_recover)"
	printf 'watchdog_restart_engine=%s\n' "$(setting watchdog_restart_engine)"
	printf 'draft_watchdog_restart_engine=%s\n' "$(setting draft_watchdog_restart_engine)"
	printf 'fallback_on_failure=%s\n' "$(setting fallback_on_failure)"
	printf 'mosdns_listen=%s\n' "$(setting mosdns_listen)"
	printf 'v2ray_dns_listen=%s\n' "$(setting v2ray_dns_listen)"
	row="$(active_profile 2>/dev/null || true)"
	if [ -n "$row" ]; then
		old_ifs="$IFS"
		IFS="$(printf '\t')"
		read -r profile_protocol profile_server profile_port profile_data \
			profile_direct_dns profile_proxy_ports profile_bypass_china \
			profile_use_v2ray_dns profile_mosdns_enabled profile_mosdns_domains profile_proxy_router_traffic \
			profile_transparent_proxy_port profile_probe_enabled profile_probe_port profile_force_domains profile_engine <<EOF
$row
EOF
		IFS="$old_ifs"
		printf 'profile_direct_dns=%s\n' "$profile_direct_dns"
		printf 'profile_transparent_proxy_ports=%s\n' "$profile_proxy_ports"
		printf 'profile_bypass_china=%s\n' "$profile_bypass_china"
		printf 'profile_use_v2ray_dns=%s\n' "$profile_use_v2ray_dns"
		printf 'profile_mosdns_enabled=%s\n' "$profile_mosdns_enabled"
		printf 'profile_mosdns_domains=%s\n' "$profile_mosdns_domains"
		printf 'profile_proxy_router_traffic=%s\n' "$profile_proxy_router_traffic"
		printf 'profile_transparent_proxy_port=%s\n' "$profile_transparent_proxy_port"
		printf 'profile_probe_enabled=%s\n' "$profile_probe_enabled"
		printf 'profile_probe_port=%s\n' "$profile_probe_port"
		printf 'profile_force_proxy_domains=%s\n' "$profile_force_domains"
		printf 'profile_engine=%s\n' "$profile_engine"
	fi
}

cmd_logs() {
	component="$1"
	lines=100
	[ "$#" -lt 2 ] || lines="$2"
	case "$component" in
		all|v2rayb|watchdog|v2ray|mosdns|dnsmasq|system) ;;
		*) die "unsupported log component" ;;
	esac
	case "$lines" in
		50|100|200) ;;
		*) die "log line count must be 50, 100 or 200" ;;
	esac
	print_file_tail() {
		label="$1"
		file="$2"
		printf '%s\n' "===== $label ====="
		if [ -r "$file" ]; then
			tail -n "$lines" "$file" | awk 'length($0) > 2048 { print substr($0, 1, 2048) " ... [line truncated]"; next } { print }'
		else
			printf '%s\n' '[log file not available]'
		fi
	}
	print_syslog() {
		filter="$1"
		printf '%s\n' "===== $2 ====="
		if ! command -v "$LOGREAD" >/dev/null 2>&1; then
			printf '%s\n' '[logread not available]'
			return
		fi
		if [ "$filter" = all ]; then
			"$LOGREAD" 2>/dev/null
		else
			"$LOGREAD" 2>/dev/null | grep -E "$filter" || :
		fi | tail -n "$lines" | awk 'length($0) > 2048 { print substr($0, 1, 2048) " ... [line truncated]"; next } { print }'
	}
	case "$component" in
		v2rayb) print_syslog 'v2rayB:' 'v2rayB' ;;
		watchdog) print_syslog 'v2rayB-watchdog:' 'Watchdog' ;;
		v2ray)
			print_file_tail 'V2Ray standard log' "$STATE_DIR/v2ray.log"
			print_file_tail 'V2Ray error log' "$STATE_DIR/v2ray-error.log"
			;;
		mosdns) print_file_tail 'MosDNS' "$STATE_DIR/mosdns.log" ;;
		dnsmasq) print_syslog 'dnsmasq\[' 'dnsmasq' ;;
		system) print_syslog all 'System log' ;;
		all)
			print_syslog 'v2rayB:|v2rayB-watchdog:|dnsmasq\[' 'v2rayB, watchdog and dnsmasq'
			print_file_tail 'V2Ray standard log' "$STATE_DIR/v2ray.log"
			print_file_tail 'V2Ray error log' "$STATE_DIR/v2ray-error.log"
			print_file_tail 'MosDNS' "$STATE_DIR/mosdns.log"
			;;
	esac
}

