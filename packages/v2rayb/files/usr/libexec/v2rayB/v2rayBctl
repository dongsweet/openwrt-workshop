cmd_apply_draft() {
	ensure_db
	draft_pending || die "no pending configuration changes"
	active_id="$(setting draft_active_profile)"
	is_uint "$active_id" || die "draft has no active profile"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles p JOIN draft_profile_nodes pn ON pn.profile_id=p.id JOIN draft_nodes n ON n.id=pn.node_id WHERE p.id=$active_id AND p.enabled=1 AND n.enabled=1;" | tr -d '[:space:]')"
	[ "$count" -gt 0 ] || die "draft active profile has no enabled node"
	deleted_sources="$(db_sql 'SELECT source_id FROM draft_source_deletions;')"
	tmp_backup="$APPLY_BACKUP.tmp.$$"
	cp "$DB" "$tmp_backup" || die "could not save the applied database"
	chmod 600 "$tmp_backup" 2>/dev/null || :
	mv "$tmp_backup" "$APPLY_BACKUP" || die "could not finalize the applied database backup"
	db_sql "BEGIN;
		DELETE FROM profile_nodes;
		DELETE FROM profiles;
		DELETE FROM nodes;
		DELETE FROM policies;
		DELETE FROM sources WHERE id IN (SELECT source_id FROM draft_source_deletions);
		INSERT INTO policies(id,name,dns_policy_json,routing_policy_json,created_at,updated_at,direct_dns,transparent_proxy_ports,transparent_proxy_port,probe_enabled,probe_port,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,proxy_router_traffic,force_proxy_domains) SELECT id,name,dns_policy_json,routing_policy_json,created_at,updated_at,direct_dns,transparent_proxy_ports,transparent_proxy_port,probe_enabled,probe_port,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,proxy_router_traffic,force_proxy_domains FROM draft_policies;
		INSERT INTO nodes(id,source_id,name,protocol,server,port,data_json,enabled,last_latency_ms,last_checked_at,last_error,created_at,updated_at) SELECT id,source_id,name,protocol,server,port,data_json,enabled,last_latency_ms,last_checked_at,last_error,created_at,updated_at FROM draft_nodes;
		INSERT INTO profiles(id,name,engine,policy_id,engine_options_json,enabled,created_at,updated_at) SELECT id,name,engine,policy_id,engine_options_json,enabled,created_at,updated_at FROM draft_profiles;
		INSERT INTO profile_nodes(profile_id,node_id,role,priority) SELECT profile_id,node_id,role,priority FROM draft_profile_nodes;
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_active_profile'),value),updated_at=CURRENT_TIMESTAMP WHERE key='active_profile';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_service_enabled'),value),updated_at=CURRENT_TIMESTAMP WHERE key='service_enabled';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_direct_dns_upstreams'),value),updated_at=CURRENT_TIMESTAMP WHERE key='direct_dns_upstreams';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_bypass_sources4'),value),updated_at=CURRENT_TIMESTAMP WHERE key='bypass_sources4';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_watchdog_enabled'),value),updated_at=CURRENT_TIMESTAMP WHERE key='watchdog_enabled';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_watchdog_auto_recover'),value),updated_at=CURRENT_TIMESTAMP WHERE key='watchdog_auto_recover';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_watchdog_restart_engine'),value),updated_at=CURRENT_TIMESTAMP WHERE key='watchdog_restart_engine';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='draft_config_version'),value),updated_at=CURRENT_TIMESTAMP WHERE key='applied_config_version';
		DELETE FROM draft_profile_nodes;
		DELETE FROM draft_profiles;
		DELETE FROM draft_nodes;
		DELETE FROM draft_policies;
		DELETE FROM draft_source_deletions;
		INSERT INTO settings(key,value,updated_at) VALUES('draft_pending','0',CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value='0',updated_at=CURRENT_TIMESTAMP;
		DELETE FROM sources WHERE type='manual' AND name='manual' AND NOT EXISTS (SELECT 1 FROM nodes WHERE source_id=sources.id) AND NOT EXISTS (SELECT 1 FROM draft_nodes WHERE source_id=sources.id);
		COMMIT;"
	for source_id in $deleted_sources; do
		rm -f "$SUBSCRIPTION_DIR/$source_id.raw"
	done
}

cmd_rollback_apply() {
	ensure_db
	[ -s "$APPLY_BACKUP" ] || die "no pending apply backup"
	tmp_db="$DB.tmp.$$"
	cp "$APPLY_BACKUP" "$tmp_db" || die "could not restore the applied database"
	chmod 600 "$tmp_db" 2>/dev/null || :
	mv "$tmp_db" "$DB" || die "could not finalize the restored database"
}

cmd_clear_apply_backup() {
	rm -f "$APPLY_BACKUP"
}

apply_job_write() {
	apply_job_dir="$1"
	apply_job_file="$2"
	apply_job_value="$3"
	apply_job_tmp="$apply_job_dir/$apply_job_file.tmp.$$"
	printf '%s\n' "$apply_job_value" > "$apply_job_tmp" || return 1
	mv "$apply_job_tmp" "$apply_job_dir/$apply_job_file" || return 1
}

apply_job_output() {
	apply_job_dir="$1"
	apply_job_text="$2"
	[ -n "$apply_job_text" ] || return 0
	printf '%s\n' "$apply_job_text" >> "$apply_job_dir/output" || :
}

apply_job_set_stage() {
	apply_job_dir="$1"
	apply_job_stage="$2"
	apply_job_write "$apply_job_dir" stage "$apply_job_stage" || :
}

apply_job_finish() {
	apply_job_dir="$1"
	apply_job_status="$2"
	apply_job_rc="$3"
	apply_job_error="$4"
	[ -z "$apply_job_error" ] || printf '%s\n' "$apply_job_error" > "$apply_job_dir/error"
	apply_job_write "$apply_job_dir" finished_at "$(date '+%Y-%m-%d %H:%M:%S')" || :
	apply_job_write "$apply_job_dir" rc "$apply_job_rc" || :
	apply_job_write "$apply_job_dir" status "$apply_job_status" || :
}

apply_job_fail_and_rollback() {
	apply_job_dir="$1"
	apply_job_reason="$2"
	apply_job_step_output="$3"
	apply_job_before_state="$4"
	apply_job_before_enabled="$5"
	apply_job_message="$apply_job_reason"
	apply_job_output "$apply_job_dir" "$apply_job_step_output"
	apply_job_set_stage "$apply_job_dir" rolling-back

	apply_job_rollback_output="$(cmd_rollback_apply 2>&1)" || {
		apply_job_message="$apply_job_reason; rollback failed: ${apply_job_rollback_output:-unknown error}"
		apply_job_output "$apply_job_dir" "$apply_job_rollback_output"
		apply_job_finish "$apply_job_dir" failed 1 "$apply_job_message"
		return 1
	}
	apply_job_output "$apply_job_dir" "$apply_job_rollback_output"

	apply_job_render_output="$(cmd_render_all 2>&1)" || {
		apply_job_message="$apply_job_reason; database rolled back but runtime configuration render failed: ${apply_job_render_output:-unknown error}"
		apply_job_output "$apply_job_dir" "$apply_job_render_output"
		apply_job_finish "$apply_job_dir" failed 1 "$apply_job_message"
		return 1
	}
	apply_job_output "$apply_job_dir" "$apply_job_render_output"

	apply_job_set_stage "$apply_job_dir" restoring-service
	apply_job_boot_output="$("$INIT_SCRIPT" "$([ "$apply_job_before_enabled" = 1 ] && printf enable || printf disable)" 2>&1)" || {
		apply_job_message="$apply_job_reason; database rolled back but boot state restoration failed: ${apply_job_boot_output:-unknown error}"
		apply_job_output "$apply_job_dir" "$apply_job_boot_output"
		apply_job_finish "$apply_job_dir" failed 1 "$apply_job_message"
		return 1
	}
	apply_job_output "$apply_job_dir" "$apply_job_boot_output"
	apply_job_restore_refresh=0
	case "$apply_job_before_state" in
		proxy) apply_job_restore_action=restart; apply_job_restore_refresh=1 ;;
		suspended) apply_job_restore_action=suspend ;;
		*) apply_job_restore_action=stop ;;
	esac
	if [ "${apply_job_restore_refresh:-0}" = 1 ]; then
		apply_job_restore_output="$("$INIT_SCRIPT" "$apply_job_restore_action" refresh 2>&1)" || {
			apply_job_message="$apply_job_reason; configuration rolled back but service restoration failed: ${apply_job_restore_output:-unknown error}"
			apply_job_output "$apply_job_dir" "$apply_job_restore_output"
			apply_job_finish "$apply_job_dir" failed 1 "$apply_job_message"
			return 1
		}
	else
		apply_job_restore_output="$("$INIT_SCRIPT" "$apply_job_restore_action" 2>&1)" || {
		apply_job_message="$apply_job_reason; configuration rolled back but service restoration failed: ${apply_job_restore_output:-unknown error}"
		apply_job_output "$apply_job_dir" "$apply_job_restore_output"
		apply_job_finish "$apply_job_dir" failed 1 "$apply_job_message"
		return 1
	}
	fi
	apply_job_output "$apply_job_dir" "$apply_job_restore_output"
	cmd_clear_apply_backup >/dev/null 2>&1 || :
	apply_job_finish "$apply_job_dir" failed 1 "$apply_job_message"
	return 1
}

apply_job_fail_keep_config() {
	apply_job_dir="$1"
	apply_job_reason="$2"
	apply_job_step_output="$3"
	apply_job_output "$apply_job_dir" "$apply_job_step_output"
	apply_job_set_stage "$apply_job_dir" service-start-failed
	cmd_clear_apply_backup >/dev/null 2>&1 || :
	apply_job_finish "$apply_job_dir" failed 1 "$apply_job_reason"
	return 1
}

cmd_apply_draft_run() {
	apply_job_dir="$1"
	case "$apply_job_dir" in
		"$APPLY_JOB_ROOT"/*) ;;
		*) die "invalid apply job directory" ;;
	esac
	[ -d "$apply_job_dir" ] || die "apply job not found"
	apply_job_write "$apply_job_dir" status running || die "cannot record apply job"
	apply_job_set_stage "$apply_job_dir" preparing
	apply_job_before_state="$(get_state)"
	apply_job_before_enabled="$(setting service_enabled)"
	cmd_clear_apply_backup >/dev/null 2>&1 || :

	apply_job_set_stage "$apply_job_dir" saving-database
	apply_job_step_output="$(cmd_apply_draft 2>&1)" || {
		apply_job_fail_and_rollback "$apply_job_dir" "Draft could not be applied" "$apply_job_step_output" "$apply_job_before_state" "$apply_job_before_enabled"
		return 1
	}
	apply_job_output "$apply_job_dir" "$apply_job_step_output"

	apply_job_set_stage "$apply_job_dir" rendering
	apply_job_step_output="$(cmd_render_all 2>&1)" || {
		apply_job_fail_and_rollback "$apply_job_dir" "Applied configuration could not be rendered" "$apply_job_step_output" "$apply_job_before_state" "$apply_job_before_enabled"
		return 1
	}
	apply_job_output "$apply_job_dir" "$apply_job_step_output"

	apply_job_enabled="$(setting service_enabled)"
	apply_job_set_stage "$apply_job_dir" updating-boot
	apply_job_step_output="$("$INIT_SCRIPT" "$([ "$apply_job_enabled" = 1 ] && printf enable || printf disable)" 2>&1)" || {
		apply_job_fail_and_rollback "$apply_job_dir" "Applied, but boot state update failed" "$apply_job_step_output" "$apply_job_before_state" "$apply_job_before_enabled"
		return 1
	}
	apply_job_output "$apply_job_dir" "$apply_job_step_output"

	if [ "$apply_job_enabled" = 1 ]; then
		apply_job_action=restart
		apply_job_set_stage "$apply_job_dir" restarting-service
		apply_job_step_output="$("$INIT_SCRIPT" "$apply_job_action" refresh 2>&1)" || {
			apply_job_fail_keep_config "$apply_job_dir" "Configuration applied, but proxy startup failed; the new configuration was kept" "$apply_job_step_output"
			return 1
		}
	else
		apply_job_set_stage "$apply_job_dir" stopping-service
		apply_job_step_output="$("$INIT_SCRIPT" stop 2>&1)" || {
			apply_job_fail_and_rollback "$apply_job_dir" "Applied, but service stop failed" "$apply_job_step_output" "$apply_job_before_state" "$apply_job_before_enabled"
			return 1
		}
	fi
	apply_job_output "$apply_job_dir" "$apply_job_step_output"

	apply_job_set_stage "$apply_job_dir" verifying
	apply_job_now_state="$(get_state)"
	if [ "$apply_job_enabled" = 1 ]; then
		[ "$apply_job_now_state" = proxy ] || {
			apply_job_fail_keep_config "$apply_job_dir" "Configuration applied, but proxy did not reach proxy mode; the new configuration was kept" ""
			return 1
		}
	else
		[ "$apply_job_now_state" = normal ] || {
			apply_job_fail_and_rollback "$apply_job_dir" "Service action returned without returning to normal mode" "" "$apply_job_before_state" "$apply_job_before_enabled"
			return 1
		}
	fi

	cmd_clear_apply_backup >/dev/null 2>&1 || {
		apply_job_fail_and_rollback "$apply_job_dir" "Applied, but the apply backup could not be cleared" "" "$apply_job_before_state" "$apply_job_before_enabled"
		return 1
	}
	apply_job_set_stage "$apply_job_dir" complete
	apply_job_finish "$apply_job_dir" done 0 ""
}

cmd_apply_draft_start() {
	ensure_db
	draft_pending || die "no pending configuration changes"
	active_id="$(setting draft_active_profile)"
	is_uint "$active_id" || die "draft has no active profile"
	count="$(db_sql "SELECT COUNT(*) FROM draft_profiles p JOIN draft_profile_nodes pn ON pn.profile_id=p.id JOIN draft_nodes n ON n.id=pn.node_id WHERE p.id=$active_id AND p.enabled=1 AND n.enabled=1;" | tr -d '[:space:]')"
	[ "$count" -gt 0 ] || die "draft active profile has no enabled node"

	mkdir -p "$APPLY_JOB_ROOT" || die "cannot create apply job directory"
	find "$APPLY_JOB_ROOT" -mindepth 1 -maxdepth 1 -type d ! -name active -mmin +1440 -exec rm -rf {} + 2>/dev/null || :
	if [ -d "$APPLY_ACTIVE_JOB" ]; then
		active_job_id="$(sed -n '1p' "$APPLY_ACTIVE_JOB/job_id" 2>/dev/null || true)"
		active_job_pid="$(sed -n '1p' "$APPLY_ACTIVE_JOB/pid" 2>/dev/null || true)"
		if [ -n "$active_job_id" ] && [ -d "$APPLY_JOB_ROOT/$active_job_id" ] &&
			{ [ "$(sed -n '1p' "$APPLY_JOB_ROOT/$active_job_id/status" 2>/dev/null || true)" = running ] ||
			  [ "$(sed -n '1p' "$APPLY_JOB_ROOT/$active_job_id/status" 2>/dev/null || true)" = queued ]; } &&
			is_uint "$active_job_pid" && kill -0 "$active_job_pid" 2>/dev/null; then
			die "a configuration apply is already running"
		fi
		rm -rf "$APPLY_ACTIVE_JOB"
	fi

	mkdir "$APPLY_ACTIVE_JOB" 2>/dev/null || die "cannot reserve an apply job"
	job_id="$(date +%s)-$$"
	job_dir="$APPLY_JOB_ROOT/$job_id"
	if ! mkdir "$job_dir"; then
		rm -rf "$APPLY_ACTIVE_JOB"
		die "cannot create apply job"
	fi
	printf '%s\n' "$job_id" > "$APPLY_ACTIVE_JOB/job_id" || {
		rm -rf "$APPLY_ACTIVE_JOB" "$job_dir"
		die "cannot reserve an apply job"
	}
	apply_job_write "$job_dir" status queued || {
		rm -rf "$APPLY_ACTIVE_JOB" "$job_dir"
		die "cannot record apply job"
	}
	apply_job_write "$job_dir" stage queued || :
	apply_job_write "$job_dir" started_at "$(date '+%Y-%m-%d %H:%M:%S')" || :
	: > "$job_dir/output"
	: > "$job_dir/error"
	printf '%s\n' "$job_id"

	(
		job_rc=0
		V2RAYB_LOCK_WAIT_SECONDS=60 "$0" apply-draft-run "$job_dir" || job_rc=$?
		job_status="$(sed -n '1p' "$job_dir/status" 2>/dev/null || printf running)"
		if [ "$job_rc" -ne 0 ] && { [ "$job_status" = queued ] || [ "$job_status" = running ]; }; then
			apply_job_finish "$job_dir" failed 1 "Apply worker stopped before completing"
		fi
		active_job_id="$(sed -n '1p' "$APPLY_ACTIVE_JOB/job_id" 2>/dev/null || true)"
		[ "$active_job_id" = "$job_id" ] && rm -rf "$APPLY_ACTIVE_JOB"
	) </dev/null >/dev/null 2>&1 &
	printf '%s\n' "$!" > "$APPLY_ACTIVE_JOB/pid" 2>/dev/null || :
}

cmd_apply_draft_status() {
	job_id="$1"
	case "$job_id" in ''|*[!0-9-]*) die "invalid apply job id" ;; esac
	job_dir="$APPLY_JOB_ROOT/$job_id"
	[ -d "$job_dir" ] || die "apply job not found"
	job_status="$(sed -n '1p' "$job_dir/status" 2>/dev/null || printf running)"
	job_stage="$(sed -n '1p' "$job_dir/stage" 2>/dev/null || printf queued)"
	job_rc="$(sed -n '1p' "$job_dir/rc" 2>/dev/null || printf '%s\n' '-')"
	printf 'status=%s\n' "$job_status"
	printf 'stage=%s\n' "$job_stage"
	printf 'rc=%s\n' "$job_rc"
	printf 'started_at=%s\n' "$(sed -n '1p' "$job_dir/started_at" 2>/dev/null || printf '%s\n' '-')"
	printf 'finished_at=%s\n' "$(sed -n '1p' "$job_dir/finished_at" 2>/dev/null || printf '%s\n' '-')"
	printf '%s\n' '--output--'
	cat "$job_dir/output" 2>/dev/null || :
	printf '%s\n' '--error--'
	cat "$job_dir/error" 2>/dev/null || :
}

