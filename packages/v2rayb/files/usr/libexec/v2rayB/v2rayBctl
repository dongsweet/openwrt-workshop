#!/bin/sh

# v2rayB control boundary. The SQLite database is the source of truth;
# everything under /tmp/v2rayB is disposable runtime output.

set -eu

DB="${V2RAYB_DB:-/etc/v2rayB/v2rayB.db}"
SCHEMA="${V2RAYB_SCHEMA:-/etc/v2rayB/schema.sql}"
STATE_DIR="${V2RAYB_STATE_DIR:-/tmp/v2rayB}"
ACTIVE_DIR="$STATE_DIR/active"
NFT_MARKER="$STATE_DIR/nft-managed"
RULE_DIR="${V2RAYB_RULE_DIR:-/etc/v2rayB/rules}"
SUBSCRIPTION_DIR="${V2RAYB_SUBSCRIPTION_DIR:-/etc/v2rayB/subscriptions}"
SUBSCRIPTION_PARSER="${V2RAYB_SUBSCRIPTION_PARSER:-/usr/libexec/v2rayB/v2rayB-subscription}"
SUBSCRIPTION_DOWNLOADER="${V2RAYB_SUBSCRIPTION_DOWNLOADER:-/usr/libexec/v2rayB/v2rayB-subscription-download}"
SUBSCRIPTION_DOWNLOAD_USER="${V2RAYB_SUBSCRIPTION_DOWNLOAD_USER:-nobody}"
SUBSCRIPTION_DOWNLOAD_GROUP="${V2RAYB_SUBSCRIPTION_DOWNLOAD_GROUP:-nogroup}"
SQLITE3="${V2RAYB_SQLITE3:-sqlite3}"
V2RAY_BIN="${V2RAYB_V2RAY_BIN:-/usr/bin/v2ray}"
XRAY_BIN="${V2RAYB_XRAY_BIN:-/usr/bin/xray}"
MOSDNS_BIN="${V2RAYB_MOSDNS_BIN:-/usr/bin/mosdns}"
DNSMASQ_CONFIG_DIR="${V2RAYB_DNSMASQ_DIR:-/etc/dnsmasq.d}"
LOGREAD="${V2RAYB_LOGREAD:-logread}"
MOSDNS_ROUTE_SUFFIX="xn--ngstr-lra8j.com"
V2RAY_USER="${V2RAYB_V2RAY_USER:-nobody}"
INIT_SCRIPT="${V2RAYB_INIT_SCRIPT:-/etc/init.d/v2rayB}"
APPLY_BACKUP="$STATE_DIR/db-before-apply"
CTL_LOCK_DIR="${V2RAYB_LOCK_DIR:-$STATE_DIR/lock}"
PROBE_ROOT="$STATE_DIR/probes"
NODE_PROBE_ROOT="$STATE_DIR/node-probes"
SUBSCRIPTION_JOB_ROOT="$STATE_DIR/subscription-jobs"
APPLY_JOB_ROOT="$STATE_DIR/apply-jobs"
APPLY_ACTIVE_JOB="$APPLY_JOB_ROOT/active"
CTL_LOCK_ACQUIRED=0
SQLITE_BUSY_TIMEOUT_MS="${V2RAYB_SQLITE_BUSY_TIMEOUT_MS:-10000}"

case "$SQLITE_BUSY_TIMEOUT_MS" in
	''|*[!0-9]*) SQLITE_BUSY_TIMEOUT_MS=10000 ;;
esac

die() {
	echo "v2rayBctl: $*" >&2
	exit 1
}

require_sqlite() {
	command -v "$SQLITE3" >/dev/null 2>&1 || die "sqlite3 is required"
}

sql_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_name() {
	case "$1" in
		''|*[!A-Za-z0-9._-]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_source_name() {
	[ -n "$1" ] || return 1
	[ "${#1}" -le 256 ] || return 1
	if printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'; then
		return 1
	fi
	return 0
}

is_server() {
	case "$1" in
		''|*[!A-Za-z0-9._:\[\]-]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_protocol() {
	case "$1" in
		vless|vmess|trojan|shadowsocks) return 0 ;;
		*) return 1 ;;
	esac
}

is_engine() {
	case "$1" in
		v2ray|xray) return 0 ;;
		*) return 1 ;;
	esac
}

format_ports() {
	ports="$1"
	old_ifs="$IFS"
	IFS=,
	set -- $ports
	IFS="$old_ifs"
	[ "$#" -gt 0 ] || return 1
	case "$ports" in *,|,*|*,,*) return 1 ;; esac
	formatted=""
	for item in "$@"; do
		case "$item" in
			*-*)
				start="${item%%-*}"
				end="${item#*-}"
				case "$end" in *-*) return 1 ;; esac
				is_uint "$start" && is_uint "$end" || return 1
				[ "$start" -ge 1 ] 2>/dev/null && [ "$end" -le 65535 ] 2>/dev/null || return 1
				[ "$start" -le "$end" ] 2>/dev/null || return 1
				port="$start-$end"
				;;
			*)
				is_uint "$item" || return 1
				[ "$item" -ge 1 ] 2>/dev/null && [ "$item" -le 65535 ] 2>/dev/null || return 1
				port="$item"
				;;
		esac
		if [ -n "$formatted" ]; then
			formatted="$formatted, $port"
		else
			formatted="$port"
		fi
	done
	printf '{ %s }' "$formatted"
}

validate_dns_endpoint() {
	_dns_endpoint_value="$1"
	case "$_dns_endpoint_value" in *[!A-Za-z0-9.:\[\]-]*|*:|:*) return 1 ;; esac
	_dns_endpoint_port="${_dns_endpoint_value##*:}"
	is_uint "$_dns_endpoint_port" && [ "$_dns_endpoint_port" -ge 1 ] 2>/dev/null && [ "$_dns_endpoint_port" -le 65535 ] 2>/dev/null || return 1
	[ -n "${_dns_endpoint_value%:*}" ]
}

validate_dns_domains() {
	value="$1"
	[ -n "$value" ] || return 0
	old_ifs="$IFS"
	IFS=,
	set -- $value
	IFS="$old_ifs"
	case "$value" in *,|,*|*,,*) return 1 ;; esac
	for domain in "$@"; do
		case "$domain" in
			''|*[!A-Za-z0-9.-]*|.*|*.) return 1 ;;
		esac
	done
}

validate_mosdns_rules() {
	value="$1"
	[ -n "$value" ] || return 0
	old_ifs="$IFS"
	IFS='
'
	for rule in $value; do
		case "$rule" in
			''|'#'*) continue ;;
			regexp:*|domain:*|full:*) ;;
			*) IFS="$old_ifs"; return 1 ;;
		esac
	done
	IFS="$old_ifs"
}

normalize_dns_upstreams() {
	printf '%s\n' "$1" | tr ', \t' '\n\n\n' | awk '
		NF { print }
	' | awk '!seen[$0]++' | awk 'BEGIN { first=1 } { if (!first) printf ","; printf "%s", $0; first=0 } END { if (!first) printf "\n" }'
}

validate_dns_upstreams() {
	_dns_upstreams_value="$1"
	[ -n "$_dns_upstreams_value" ] || return 1
	_dns_upstreams_old_ifs="$IFS"
	IFS=','
	set -f
	set -- $_dns_upstreams_value
	IFS="$_dns_upstreams_old_ifs"
	set +f
	_dns_upstreams_count=0
	for _dns_upstreams_item in "$@"; do
		[ -n "$_dns_upstreams_item" ] || return 1
		validate_dns_endpoint "$_dns_upstreams_item" || return 1
		_dns_upstreams_count=$((_dns_upstreams_count + 1))
	done
	[ "$_dns_upstreams_count" -ge 1 ] && [ "$_dns_upstreams_count" -le 8 ]
}

normalize_bypass_sources() {
	printf '%s\n' "$1" | tr ', \t' '\n\n\n' | awk '
		NF {
			item = $0
			if (item !~ /\//)
				item = item "/32"
			if (!seen[item]++)
				order[++count] = item
		}
		END {
			for (i = 1; i <= count; i++) {
				if (i > 1)
					printf ","
				printf "%s", order[i]
			}
			if (count)
				printf "\n"
		}
	'
}

validate_bypass_sources() {
	_bypass_value="$1"
	[ -n "$_bypass_value" ] || return 0
	[ "${#_bypass_value}" -le 8192 ] || return 1
	_bypass_old_ifs="$IFS"
	IFS=','
	set -f
	set -- $_bypass_value
	IFS="$_bypass_old_ifs"
	set +f
	[ "$#" -ge 1 ] && [ "$#" -le 256 ] || return 1
	for _bypass_item in "$@"; do
		[ -n "$_bypass_item" ] || return 1
		case "$_bypass_item" in
			*/*)
				_bypass_ip="${_bypass_item%/*}"
				_bypass_prefix="${_bypass_item#*/}"
				case "$_bypass_prefix" in ''|*/*) return 1 ;; esac
				;;
			*)
				_bypass_ip="$_bypass_item"
				_bypass_prefix=32
				;;
		esac
		case "$_bypass_ip" in
			''|.*|*.|*..*|*[!0-9.]*) return 1 ;;
		esac
		_bypass_old_ifs="$IFS"
		IFS=.
		set -- $_bypass_ip
		IFS="$_bypass_old_ifs"
		[ "$#" -eq 4 ] || return 1
		for _bypass_octet in "$@"; do
			is_uint "$_bypass_octet" && [ "$_bypass_octet" -le 255 ] 2>/dev/null || return 1
		done
		is_uint "$_bypass_prefix" && [ "$_bypass_prefix" -le 32 ] 2>/dev/null || return 1
	done
}

normalize_force_proxy_domains() {
	printf '%s\n' "$1" | tr ', \t\r' '\n\n\n\n' | awk '
		NF {
			item = tolower($0)
			if (!seen[item]++)
				order[++count] = item
		}
		END {
			for (i = 1; i <= count; i++) {
				if (i > 1)
					printf ","
				printf "%s", order[i]
			}
			if (count)
				printf "\n"
		}
	'
}

validate_force_proxy_domains() {
	_force_domains_value="$1"
	[ -n "$_force_domains_value" ] || return 0
	[ "${#_force_domains_value}" -le 8192 ] || return 1
	_force_domains_old_ifs="$IFS"
	IFS=','
	set -f
	set -- $_force_domains_value
	IFS="$_force_domains_old_ifs"
	set +f
	[ "$#" -ge 1 ] && [ "$#" -le 256 ] || return 1
	for _force_domain in "$@"; do
		[ "${#_force_domain}" -le 253 ] || return 1
		case "$_force_domain" in
			''|.*|*.|*..*|*[!A-Za-z0-9.-]*) return 1 ;;
		esac
	done
}

validate_profile_policy() {
	direct_dns="$1"
	ports="$2"
	bypass_china="$3"
	use_v2ray_dns="${4:-1}"
	mosdns_enabled="${5:-1}"
	mosdns_domains="${6:-xn--ngstr-lra8j.com}"
	mosdns_match_rules="${7:-}"
	proxy_router_traffic="${8:-0}"
	transparent_proxy_port="${9:-12345}"
	probe_enabled="${10:-1}"
	probe_port="${11:-12346}"
	force_proxy_domains="${12:-}"
	validate_dns_endpoint "$direct_dns" || die "invalid profile DNS endpoint"
	format_ports "$ports" >/dev/null || die "invalid profile transparent proxy port list"
	case "$bypass_china" in 0|1) ;; *) die "profile bypass_china must be 0 or 1" ;; esac
	case "$use_v2ray_dns" in 0|1) ;; *) die "profile use_v2ray_dns must be 0 or 1" ;; esac
	case "$mosdns_enabled" in 0|1) ;; *) die "profile mosdns_enabled must be 0 or 1" ;; esac
	case "$proxy_router_traffic" in 0|1) ;; *) die "profile proxy_router_traffic must be 0 or 1" ;; esac
	is_uint "$transparent_proxy_port" && [ "$transparent_proxy_port" -ge 1 ] 2>/dev/null && [ "$transparent_proxy_port" -le 65535 ] 2>/dev/null ||
		die "invalid transparent proxy listener port"
	case "$probe_enabled" in 0|1) ;; *) die "profile probe_enabled must be 0 or 1" ;; esac
	is_uint "$probe_port" && [ "$probe_port" -ge 1 ] 2>/dev/null && [ "$probe_port" -le 65535 ] 2>/dev/null ||
		die "invalid probe port"
	[ "$transparent_proxy_port" != "$probe_port" ] || die "transparent proxy and probe ports must differ"
	validate_dns_domains "$mosdns_domains" || die "invalid MosDNS domain list"
	if [ "$mosdns_enabled" = 1 ] && [ -z "$mosdns_domains" ]; then
		die "MosDNS is enabled but no domains are configured"
	fi
	validate_mosdns_rules "$mosdns_match_rules" || die "invalid MosDNS match rules"
	validate_force_proxy_domains "$force_proxy_domains" || die "invalid force proxy domain list"
}

db_sql() {
	"$SQLITE3" -cmd ".timeout $SQLITE_BUSY_TIMEOUT_MS" -batch -bail "$DB" "PRAGMA foreign_keys=ON; $1"
}

db_has_table() {
	table="$1"
	count="$(db_sql "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name=$(sql_quote "$table");" | tr -d '[:space:]')"
	[ "$count" = 1 ]
}

db_has_column() {
	table="$1"
	column="$2"
	count="$(db_sql "SELECT COUNT(*) FROM pragma_table_info($(sql_quote "$table")) WHERE name=$(sql_quote "$column");" | tr -d '[:space:]')"
	[ "$count" = 1 ]
}

db_add_column() {
	table="$1"
	column="$2"
	definition="$3"
	db_has_column "$table" "$column" || db_sql "ALTER TABLE $table ADD COLUMN $definition;"
}

acquire_ctl_lock() {
	[ "${V2RAYB_LOCK_HELD:-0}" = 1 ] && return 0
	mkdir -p "$(dirname "$CTL_LOCK_DIR")" || die "cannot create lock directory"
	wait_seconds="${V2RAYB_LOCK_WAIT_SECONDS:-0}"
	case "$wait_seconds" in ''|*[!0-9]*) wait_seconds=0 ;; esac
	waited=0
	while :; do
		if mkdir "$CTL_LOCK_DIR" 2>/dev/null; then
			printf "%s\n" "$$" > "$CTL_LOCK_DIR/pid"
			CTL_LOCK_ACQUIRED=1
			V2RAYB_LOCK_HELD=1
			export V2RAYB_LOCK_HELD
			trap 'rm -rf "$CTL_LOCK_DIR"' EXIT HUP INT TERM
			return 0
		fi
		old_pid="$(sed -n "1p" "$CTL_LOCK_DIR/pid" 2>/dev/null || true)"
		case "$old_pid" in
			''|*[!0-9]*) ;;
			*)
				if kill -0 "$old_pid" 2>/dev/null; then
					[ "$waited" -lt "$wait_seconds" ] || die "v2rayB is busy (pid $old_pid)"
					waited=$((waited + 1))
					sleep 1
					continue
				fi
				;;
		esac
		rm -rf "$CTL_LOCK_DIR"
	done
}

setting() {
	db_sql "SELECT value FROM settings WHERE key=$(sql_quote "$1");" | sed -n '1p'
}

draft_pending() {
	[ "$(setting draft_pending)" = 1 ] || return 1
	count="$(db_sql "SELECT (SELECT COUNT(*) FROM draft_nodes) + (SELECT COUNT(*) FROM draft_profiles) + (SELECT COUNT(*) FROM draft_policies) + (SELECT COUNT(*) FROM draft_source_deletions);" | tr -d '[:space:]')"
	[ "$count" -gt 0 ] 2>/dev/null && return 0
	[ "$(setting active_profile)" != "$(setting draft_active_profile)" ] && return 0
	[ "$(setting service_enabled)" != "$(setting draft_service_enabled)" ] && return 0
	[ "$(setting direct_dns_upstreams)" != "$(setting draft_direct_dns_upstreams)" ] && return 0
	[ "$(setting bypass_sources4)" != "$(setting draft_bypass_sources4)" ] && return 0
	[ "$(setting watchdog_enabled)" != "$(setting draft_watchdog_enabled)" ] && return 0
	[ "$(setting watchdog_auto_recover)" != "$(setting draft_watchdog_auto_recover)" ] && return 0
	[ "$(setting watchdog_restart_engine)" != "$(setting draft_watchdog_restart_engine)" ] && return 0
	return 1
}

begin_draft() {
	draft_pending && return 0
	db_sql "BEGIN;
		DELETE FROM draft_profile_nodes;
		DELETE FROM draft_profiles;
		DELETE FROM draft_nodes;
		DELETE FROM draft_policies;
		DELETE FROM draft_source_deletions;
		INSERT INTO draft_policies(id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,transparent_proxy_port,probe_enabled,probe_port,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,proxy_router_traffic,force_proxy_domains,created_at,updated_at) SELECT id,name,dns_policy_json,routing_policy_json,direct_dns,transparent_proxy_ports,transparent_proxy_port,probe_enabled,probe_port,bypass_china,use_v2ray_dns,mosdns_enabled,mosdns_domains,mosdns_match_rules,proxy_router_traffic,force_proxy_domains,created_at,updated_at FROM policies;
		INSERT INTO draft_nodes(id,source_id,name,protocol,server,port,data_json,enabled,last_latency_ms,last_checked_at,last_error,created_at,updated_at) SELECT id,source_id,name,protocol,server,port,data_json,enabled,last_latency_ms,last_checked_at,last_error,created_at,updated_at FROM nodes;
		INSERT INTO draft_profiles(id,name,engine,policy_id,engine_options_json,enabled,created_at,updated_at) SELECT id,name,engine,policy_id,engine_options_json,enabled,created_at,updated_at FROM profiles;
		INSERT INTO draft_profile_nodes(profile_id,node_id,role,priority) SELECT profile_id,node_id,role,priority FROM profile_nodes;
		DELETE FROM settings WHERE key IN ('draft_active_profile','draft_service_enabled','draft_direct_dns_upstreams','draft_bypass_sources4','draft_watchdog_enabled','draft_watchdog_auto_recover','draft_watchdog_restart_engine');
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_active_profile',value,CURRENT_TIMESTAMP FROM settings WHERE key='active_profile';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_service_enabled',value,CURRENT_TIMESTAMP FROM settings WHERE key='service_enabled';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_direct_dns_upstreams',value,CURRENT_TIMESTAMP FROM settings WHERE key='direct_dns_upstreams';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_bypass_sources4',value,CURRENT_TIMESTAMP FROM settings WHERE key='bypass_sources4';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_watchdog_enabled',value,CURRENT_TIMESTAMP FROM settings WHERE key='watchdog_enabled';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_watchdog_auto_recover',value,CURRENT_TIMESTAMP FROM settings WHERE key='watchdog_auto_recover';
		INSERT INTO settings(key,value,updated_at) SELECT 'draft_watchdog_restart_engine',value,CURRENT_TIMESTAMP FROM settings WHERE key='watchdog_restart_engine';
		INSERT INTO settings(key,value,updated_at) VALUES('draft_pending','1',CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value='1',updated_at=CURRENT_TIMESTAMP;
		COMMIT;"
}

draft_change_begin() {
	DRAFT_CHANGE_DEPTH=$(( ${DRAFT_CHANGE_DEPTH:-0} + 1 ))
	[ "$DRAFT_CHANGE_DEPTH" -eq 1 ] || return 0
	DRAFT_CHANGE_NEW=0
	if ! draft_pending; then
		DRAFT_CHANGE_NEW=1
		begin_draft
	fi
}

draft_change_commit() {
	DRAFT_CHANGE_DEPTH=$(( ${DRAFT_CHANGE_DEPTH:-1} - 1 ))
	[ "$DRAFT_CHANGE_DEPTH" -le 0 ] || return 0
	if [ "${DRAFT_CHANGE_NEW:-0}" = 1 ]; then
		version="$(setting applied_config_version)"
		is_uint "$version" || version=1
		version=$((version + 1))
	else
		version="$(setting draft_config_version)"
		is_uint "$version" || version="$(setting applied_config_version)"
		is_uint "$version" || version=1
		version=$((version + 1))
	fi
	db_sql "INSERT INTO settings(key,value,updated_at) VALUES('draft_config_version',$(sql_quote "$version"),CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP;"
	DRAFT_CHANGE_DEPTH=0
	DRAFT_CHANGE_NEW=0
}

discard_drafts() {
	db_sql "BEGIN;
		DELETE FROM draft_profile_nodes;
		DELETE FROM draft_profiles;
		DELETE FROM draft_nodes;
		DELETE FROM draft_policies;
		DELETE FROM draft_source_deletions;
		DELETE FROM sources WHERE type='manual' AND name='manual' AND NOT EXISTS (SELECT 1 FROM nodes WHERE source_id=sources.id);
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='active_profile'),''),updated_at=CURRENT_TIMESTAMP WHERE key='draft_active_profile';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='service_enabled'),'0'),updated_at=CURRENT_TIMESTAMP WHERE key='draft_service_enabled';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='direct_dns_upstreams'),'223.5.5.5:53'),updated_at=CURRENT_TIMESTAMP WHERE key='draft_direct_dns_upstreams';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='bypass_sources4'),''),updated_at=CURRENT_TIMESTAMP WHERE key='draft_bypass_sources4';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='watchdog_enabled'),'1'),updated_at=CURRENT_TIMESTAMP WHERE key='draft_watchdog_enabled';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='watchdog_auto_recover'),'1'),updated_at=CURRENT_TIMESTAMP WHERE key='draft_watchdog_auto_recover';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='watchdog_restart_engine'),'1'),updated_at=CURRENT_TIMESTAMP WHERE key='draft_watchdog_restart_engine';
		UPDATE settings SET value=COALESCE((SELECT value FROM settings WHERE key='applied_config_version'),'1'),updated_at=CURRENT_TIMESTAMP WHERE key='draft_config_version';
		INSERT INTO settings(key,value,updated_at) VALUES('draft_pending','0',CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value='0',updated_at=CURRENT_TIMESTAMP;
		COMMIT;"
}

selected_engine() {
	_engine="$(db_sql "SELECT COALESCE(p.engine, 'v2ray') FROM profiles p WHERE p.id=(SELECT value FROM settings WHERE key='active_profile') AND p.enabled=1 LIMIT 1;" | sed -n '1p')"
	is_engine "$_engine" || _engine=v2ray
	printf '%s\n' "$_engine"
}

selected_engine_bin() {
	case "$(selected_engine)" in
		xray) printf '%s\n' "$XRAY_BIN" ;;
		*) printf '%s\n' "$V2RAY_BIN" ;;
	esac
}

set_draft_setting() {
	key="$1"
	value="$2"
	db_sql "INSERT INTO settings(key,value,updated_at) VALUES('draft_$key',$(sql_quote "$value"),CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP;"
}

ensure_db() {
	require_sqlite
	[ -f "$SCHEMA" ] || die "schema not found: $SCHEMA"
	mkdir -p "$(dirname "$DB")" "$STATE_DIR" "$ACTIVE_DIR" "$RULE_DIR"
	if [ ! -s "$DB" ]; then
		"$SQLITE3" -batch -bail "$DB" < "$SCHEMA"
		chmod 600 "$DB"
		return 0
	fi
	version="$(db_sql 'PRAGMA user_version;' | tr -d '[:space:]')"
	if [ "$version" = 1 ]; then
		db_add_column policies direct_dns 'direct_dns TEXT'
		db_add_column policies transparent_proxy_ports 'transparent_proxy_ports TEXT'
		db_add_column policies bypass_china 'bypass_china INTEGER NOT NULL DEFAULT 1 CHECK (bypass_china IN (0, 1))'
		db_sql "CREATE TABLE IF NOT EXISTS sources (id INTEGER PRIMARY KEY, type TEXT NOT NULL CHECK (type IN ('manual','subscription','imported')), name TEXT NOT NULL, url TEXT, format TEXT, enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0,1)), etag TEXT, last_error TEXT, last_updated TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, UNIQUE(type,name)); CREATE INDEX IF NOT EXISTS idx_sources_enabled ON sources(enabled); INSERT OR IGNORE INTO schema_migrations(version) VALUES (2); PRAGMA user_version=2;"
		version=2
	fi
	if [ "$version" = 2 ]; then
		db_add_column policies use_v2ray_dns 'use_v2ray_dns INTEGER NOT NULL DEFAULT 1 CHECK (use_v2ray_dns IN (0, 1))'
		db_add_column policies mosdns_enabled 'mosdns_enabled INTEGER NOT NULL DEFAULT 1 CHECK (mosdns_enabled IN (0, 1))'
		db_add_column policies mosdns_domains 'mosdns_domains TEXT'
		db_add_column policies mosdns_match_rules 'mosdns_match_rules TEXT'
		db_sql "INSERT OR IGNORE INTO schema_migrations(version) VALUES (3); PRAGMA user_version=3;"
		version=3
	fi
	if [ "$version" = 3 ]; then
		db_sql "CREATE TABLE IF NOT EXISTS draft_nodes (id INTEGER PRIMARY KEY, source_id INTEGER, name TEXT NOT NULL, protocol TEXT NOT NULL, server TEXT NOT NULL, port INTEGER NOT NULL CHECK (port BETWEEN 1 AND 65535), data_json TEXT NOT NULL DEFAULT '{}', enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)), last_latency_ms INTEGER, last_checked_at TEXT, last_error TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, UNIQUE(source_id, name)); CREATE TABLE IF NOT EXISTS draft_policies (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, dns_policy_json TEXT NOT NULL DEFAULT '{}', routing_policy_json TEXT NOT NULL DEFAULT '{}', direct_dns TEXT, transparent_proxy_ports TEXT, bypass_china INTEGER NOT NULL DEFAULT 1 CHECK (bypass_china IN (0, 1)), use_v2ray_dns INTEGER NOT NULL DEFAULT 1 CHECK (use_v2ray_dns IN (0, 1)), mosdns_enabled INTEGER NOT NULL DEFAULT 1 CHECK (mosdns_enabled IN (0, 1)), mosdns_domains TEXT, mosdns_match_rules TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP); CREATE TABLE IF NOT EXISTS draft_profiles (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, engine TEXT NOT NULL, policy_id INTEGER, engine_options_json TEXT NOT NULL DEFAULT '{}', enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)), created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP); CREATE TABLE IF NOT EXISTS draft_profile_nodes (profile_id INTEGER NOT NULL, node_id INTEGER NOT NULL, role TEXT NOT NULL DEFAULT 'primary', priority INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(profile_id, node_id)); INSERT OR IGNORE INTO schema_migrations(version) VALUES (4); PRAGMA user_version=4;"
		version=4
	fi
	if [ "$version" = 4 ]; then
		db_add_column policies proxy_router_traffic 'proxy_router_traffic INTEGER NOT NULL DEFAULT 0 CHECK (proxy_router_traffic IN (0, 1))'
		db_add_column draft_policies proxy_router_traffic 'proxy_router_traffic INTEGER NOT NULL DEFAULT 0 CHECK (proxy_router_traffic IN (0, 1))'
		db_sql "INSERT OR IGNORE INTO schema_migrations(version) VALUES (5); PRAGMA user_version=5;"
		version=5
	fi
	if [ "$version" = 5 ]; then
		db_sql "CREATE TABLE IF NOT EXISTS draft_source_deletions (source_id INTEGER PRIMARY KEY); INSERT OR IGNORE INTO schema_migrations(version) VALUES (6); PRAGMA user_version=6;"
		version=6
	fi
	if [ "$version" = 6 ]; then
		db_add_column sources ipv4_only 'ipv4_only INTEGER NOT NULL DEFAULT 1 CHECK (ipv4_only IN (0, 1))'
		db_sql "INSERT OR IGNORE INTO schema_migrations(version) VALUES (7); PRAGMA user_version=7;"
		version=7
	fi
	if [ "$version" = 7 ]; then
		db_add_column policies transparent_proxy_port 'transparent_proxy_port INTEGER NOT NULL DEFAULT 12345 CHECK (transparent_proxy_port BETWEEN 1 AND 65535)'
		db_add_column policies probe_enabled 'probe_enabled INTEGER NOT NULL DEFAULT 1 CHECK (probe_enabled IN (0, 1))'
		db_add_column policies probe_port 'probe_port INTEGER NOT NULL DEFAULT 12346 CHECK (probe_port BETWEEN 1 AND 65535)'
		db_add_column draft_policies transparent_proxy_port 'transparent_proxy_port INTEGER NOT NULL DEFAULT 12345 CHECK (transparent_proxy_port BETWEEN 1 AND 65535)'
		db_add_column draft_policies probe_enabled 'probe_enabled INTEGER NOT NULL DEFAULT 1 CHECK (probe_enabled IN (0, 1))'
		db_add_column draft_policies probe_port 'probe_port INTEGER NOT NULL DEFAULT 12346 CHECK (probe_port BETWEEN 1 AND 65535)'
		legacy_proxy_port="$(setting transparent_proxy_port)"
		if is_uint "$legacy_proxy_port" && [ "$legacy_proxy_port" -ge 1 ] 2>/dev/null && [ "$legacy_proxy_port" -le 65535 ] 2>/dev/null; then
			db_sql "UPDATE policies SET transparent_proxy_port=$legacy_proxy_port; UPDATE draft_policies SET transparent_proxy_port=$legacy_proxy_port;"
		fi
		db_sql "DELETE FROM settings WHERE key IN ('transparent_proxy_port','force_proxy_port'); INSERT OR IGNORE INTO schema_migrations(version) VALUES (8); PRAGMA user_version=8;"
		version=8
	fi
	if [ "$version" = 8 ]; then
		legacy_direct_dns='223.5.5.5:53'
		if db_has_column policies direct_dns && db_has_column profiles policy_id; then
			legacy_direct_dns="$(db_sql "SELECT COALESCE((SELECT pol.direct_dns FROM profiles p JOIN policies pol ON pol.id=p.policy_id WHERE p.id=(SELECT value FROM settings WHERE key='active_profile')), (SELECT direct_dns FROM policies WHERE direct_dns IS NOT NULL AND direct_dns<>'' ORDER BY id LIMIT 1), '223.5.5.5:53');" | sed -n '1p')"
		fi
		normalized_direct_dns="$(normalize_dns_upstreams "$legacy_direct_dns")"
		validate_dns_upstreams "$normalized_direct_dns" || normalized_direct_dns='223.5.5.5:53'
		db_sql "INSERT INTO settings(key,value,updated_at) VALUES('direct_dns_upstreams',$(sql_quote "$normalized_direct_dns"),CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP; INSERT OR IGNORE INTO schema_migrations(version) VALUES (9); PRAGMA user_version=9;"
		version=9
	fi
	if [ "$version" = 9 ]; then
		legacy_bypass_sources=''
		legacy_bypass_file="$RULE_DIR/proxy_bypass_sources4.txt"
		if [ -f "$legacy_bypass_file" ]; then
			legacy_bypass_sources="$(awk '$1 !~ /^#/ { print $1 }' "$legacy_bypass_file")"
			legacy_bypass_sources="$(normalize_bypass_sources "$legacy_bypass_sources")"
			validate_bypass_sources "$legacy_bypass_sources" || legacy_bypass_sources=''
		fi
		db_sql "INSERT INTO settings(key,value,updated_at) VALUES('bypass_sources4',$(sql_quote "$legacy_bypass_sources"),CURRENT_TIMESTAMP),('draft_bypass_sources4',$(sql_quote "$legacy_bypass_sources"),CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP; INSERT OR IGNORE INTO schema_migrations(version) VALUES (10); PRAGMA user_version=10;"
		version=10
	fi
	if [ "$version" = 10 ]; then
		db_sql "INSERT OR IGNORE INTO schema_migrations(version) VALUES (11); PRAGMA user_version=11;"
		version=11
	fi
	if [ "$version" = 11 ]; then
		db_add_column policies force_proxy_domains 'force_proxy_domains TEXT'
		db_add_column draft_policies force_proxy_domains 'force_proxy_domains TEXT'
		if db_has_table settings; then
			legacy_force_domains="$(db_sql "SELECT value FROM settings WHERE key='force_proxy_domains';" | sed -n '1p')"
			normalized_force_domains="$(normalize_force_proxy_domains "$legacy_force_domains")"
			! validate_force_proxy_domains "$normalized_force_domains" && normalized_force_domains=''
			active_profile_id="$(db_sql "SELECT value FROM settings WHERE key='active_profile';" | sed -n '1p')"
			if is_uint "$active_profile_id" && [ -n "$normalized_force_domains" ]; then
				db_sql "UPDATE policies SET force_proxy_domains=$(sql_quote "$normalized_force_domains") WHERE id=(SELECT policy_id FROM profiles WHERE id=$active_profile_id); UPDATE draft_policies SET force_proxy_domains=$(sql_quote "$normalized_force_domains") WHERE id=(SELECT policy_id FROM draft_profiles WHERE id=$active_profile_id);"
			fi
			db_sql "DELETE FROM settings WHERE key IN ('force_proxy_domains','draft_force_proxy_domains');"
		fi
		db_sql "INSERT OR IGNORE INTO schema_migrations(version) VALUES (12); PRAGMA user_version=12;"
		version=12
	fi
	if [ "$version" = 12 ]; then
		bad_ggc_rule='regexp:^r\+[0-9]+(---|\.)sn-(2x3|ni5|j5o)[a-z0-9_]{5}\.xn--ngstr-lra8j\.com$'
		good_ggc_rule='regexp:^rr[0-9]+(---|\.)sn-(2x3|ni5|j5o)[a-z0-9_]{5}\.xn--ngstr-lra8j\.com$'
		if db_has_column policies mosdns_match_rules; then
			db_sql "UPDATE policies SET mosdns_match_rules=$(sql_quote "$good_ggc_rule") WHERE mosdns_match_rules=$(sql_quote "$bad_ggc_rule");"
		fi
		if db_has_column draft_policies mosdns_match_rules; then
			db_sql "UPDATE draft_policies SET mosdns_match_rules=$(sql_quote "$good_ggc_rule") WHERE mosdns_match_rules=$(sql_quote "$bad_ggc_rule");"
		fi
		db_sql "INSERT OR IGNORE INTO schema_migrations(version) VALUES (13); PRAGMA user_version=13;"
		version=13
	fi
	[ "$version" = 13 ] || die "unsupported database schema version: $version"
	missing_settings="$(db_sql "SELECT COUNT(*) FROM (SELECT 'service_enabled' AS key UNION ALL SELECT 'draft_service_enabled' UNION ALL SELECT 'watchdog_enabled' UNION ALL SELECT 'draft_watchdog_enabled' UNION ALL SELECT 'watchdog_auto_recover' UNION ALL SELECT 'draft_watchdog_auto_recover' UNION ALL SELECT 'watchdog_restart_engine' UNION ALL SELECT 'draft_watchdog_restart_engine' UNION ALL SELECT 'applied_config_version' UNION ALL SELECT 'draft_config_version' UNION ALL SELECT 'draft_pending' UNION ALL SELECT 'draft_active_profile' UNION ALL SELECT 'direct_dns_upstreams' UNION ALL SELECT 'draft_direct_dns_upstreams' UNION ALL SELECT 'bypass_sources4' UNION ALL SELECT 'draft_bypass_sources4') required WHERE NOT EXISTS (SELECT 1 FROM settings s WHERE s.key=required.key);" | tr -d '[:space:]')"
	if [ "$missing_settings" -gt 0 ] 2>/dev/null; then
		db_sql "INSERT OR IGNORE INTO settings(key, value) VALUES ('service_enabled', '0'), ('draft_service_enabled', '0'), ('watchdog_enabled', '1'), ('draft_watchdog_enabled', '1'), ('watchdog_auto_recover', '1'), ('draft_watchdog_auto_recover', '1'), ('watchdog_restart_engine', '1'), ('draft_watchdog_restart_engine', '1'), ('applied_config_version', '1'), ('draft_config_version', '1'), ('draft_pending', '0'), ('draft_active_profile', ''), ('direct_dns_upstreams', '223.5.5.5:53'), ('draft_direct_dns_upstreams', '223.5.5.5:53'), ('bypass_sources4', ''), ('draft_bypass_sources4', '');"
	fi
	legacy_settings="$(db_sql "SELECT COUNT(*) FROM settings WHERE key IN ('direct_dns','transparent_proxy_ports','draft_direct_dns','draft_transparent_proxy_ports');" | tr -d '[:space:]')"
	if [ "$legacy_settings" -gt 0 ] 2>/dev/null; then
		db_sql "DELETE FROM settings WHERE key IN ('direct_dns','transparent_proxy_ports','draft_direct_dns','draft_transparent_proxy_ports');"
	fi
	if [ "$(setting draft_pending)" != 1 ]; then
		stale_draft_rows="$(db_sql "SELECT (SELECT COUNT(*) FROM draft_nodes) + (SELECT COUNT(*) FROM draft_profiles) + (SELECT COUNT(*) FROM draft_policies) + (SELECT COUNT(*) FROM draft_profile_nodes) + (SELECT COUNT(*) FROM draft_source_deletions);" | tr -d '[:space:]')"
		if [ "$stale_draft_rows" -gt 0 ] 2>/dev/null; then
			discard_drafts
		fi
	fi
}

set_state() {
	case "$1" in
		normal|starting|proxy|stopping|degraded|suspended) ;;
		*) die "invalid runtime state: $1" ;;
	esac
	mkdir -p "$STATE_DIR"
	tmp="$STATE_DIR/state.tmp.$$"
	printf '%s\n' "$1" > "$tmp"
	mv "$tmp" "$STATE_DIR/state"
}

get_state() {
	if [ -s "$STATE_DIR/state" ]; then
		sed -n '1p' "$STATE_DIR/state"
	else
		printf '%s\n' normal
	fi
}

cmd_init_db() {
	ensure_db
	[ -f "$RULE_DIR/direct_domains.txt" ] || : > "$RULE_DIR/direct_domains.txt"
	[ -f "$RULE_DIR/direct_ipv4.txt" ] || : > "$RULE_DIR/direct_ipv4.txt"
	[ -f "$RULE_DIR/direct_ipv6.txt" ] || : > "$RULE_DIR/direct_ipv6.txt"
}

cmd_get_setting() {
	ensure_db
	case "$1" in
		''|*[!A-Za-z0-9_./-]*) die "invalid setting key" ;;
	esac
	setting "$1"
}

cmd_set_setting() {
	ensure_db
	key="$1"
	value="$2"
	case "$key" in
		''|*[!A-Za-z0-9_./-]*) die "invalid setting key" ;;
	esac
	case "$key" in
		service_enabled)
			case "$value" in 0|1) ;; *) die "service_enabled must be 0 or 1" ;; esac
			;;
		direct_dns_upstreams)
			value="$(normalize_dns_upstreams "$value")"
			validate_dns_upstreams "$value" || die "invalid direct DNS upstream list"
			;;
		bypass_sources4)
			value="$(normalize_bypass_sources "$value")"
			validate_bypass_sources "$value" || die "invalid bypass source IPv4/CIDR list"
			;;
		watchdog_enabled|watchdog_auto_recover|watchdog_restart_engine)
			case "$value" in 0|1) ;; *) die "$key must be 0 or 1" ;; esac
			;;
		esac
	case "$key" in
		active_profile|service_enabled|direct_dns_upstreams|bypass_sources4|watchdog_enabled|watchdog_auto_recover|watchdog_restart_engine)
			draft_change_begin
			set_draft_setting "$key" "$value"
			draft_change_commit
			;;
		*)
			db_sql "INSERT INTO settings(key, value, updated_at) VALUES($(sql_quote "$key"), $(sql_quote "$value"), CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=CURRENT_TIMESTAMP;"
			;;
	esac
}

cmd_set_state() {
	set_state "$1"
}

cmd_add_source() {
	ensure_db
	type="$1"
	name="$2"
	url="${3:-}"
	format="${4:-}"
	ipv4_only="${5:-1}"
	is_source_name "$name" || die "订阅名称无效：编码长度不得超过 256 字节，且不能包含控制字符"
	case "$ipv4_only" in 0|1) ;; *) die "ipv4_only must be 0 or 1" ;; esac
	case "$type" in
		manual|imported) ;;
		subscription)
			case "$url" in http://*|https://*) ;; *) die "subscription URL must use http or https" ;; esac
			case "$format" in ''|auto|uri|base64) [ -n "$format" ] || format=auto ;; *) die "unsupported subscription format" ;; esac
			;;
		*) die "invalid source type" ;;
	esac
	db_sql "INSERT INTO sources(type, name, url, format, ipv4_only, updated_at) VALUES($(sql_quote "$type"), $(sql_quote "$name"), $(sql_quote "$url"), $(sql_quote "$format"), $ipv4_only, CURRENT_TIMESTAMP) ON CONFLICT(type, name) DO UPDATE SET url=excluded.url, format=excluded.format, ipv4_only=excluded.ipv4_only, updated_at=CURRENT_TIMESTAMP;"
}

cmd_list_sources() {
	ensure_db
	source_filter=""
	if draft_pending; then
		source_filter="WHERE NOT EXISTS (SELECT 1 FROM draft_source_deletions dsd WHERE dsd.source_id=s.id)"
	fi
	db_sql "SELECT s.id || char(9) || s.type || char(9) || s.name || char(9) || COALESCE(s.url, '') || char(9) || COALESCE(s.format, 'auto') || char(9) || s.enabled || char(9) || COALESCE(s.last_updated, '') || char(9) || COALESCE(s.last_error, '') || char(9) || (SELECT COUNT(*) FROM nodes n WHERE n.source_id=s.id) || char(9) || COALESCE(s.ipv4_only, 1) FROM sources s $source_filter ORDER BY s.type, s.name;"
}

set_source_error() {
	source_id="$1"
	error_text="$2"
	db_sql "UPDATE sources SET last_error=$(sql_quote "$error_text"), updated_at=CURRENT_TIMESTAMP WHERE id=$source_id;" >/dev/null 2>&1 || :
}

cmd_update_subscription() {
	ensure_db
	source_id="$1"
	is_uint "$source_id" || die "source id must be numeric"
	row="$(db_sql "SELECT type || char(9) || name || char(9) || COALESCE(url, '') || char(9) || COALESCE(format, 'auto') || char(9) || COALESCE(ipv4_only, 1) FROM sources WHERE id=$source_id;")"
	[ -n "$row" ] || die "source not found: $source_id"
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	read -r type name url format ipv4_only <<EOF
$row
EOF
	IFS="$old_ifs"
	[ "$type" = subscription ] || die "source is not a subscription"
	[ -n "$url" ] || die "subscription URL is empty"
	case "$ipv4_only" in 0|1) ;; *) die "invalid subscription IPv4 setting" ;; esac
	draft_pending && die "apply or revert pending changes before updating a subscription"
	active_before="$(db_sql "SELECT n.server || char(9) || n.data_json FROM profiles p JOIN profile_nodes pn ON pn.profile_id=p.id JOIN nodes n ON n.id=pn.node_id WHERE p.id=(SELECT value FROM settings WHERE key='active_profile') AND n.source_id=$source_id ORDER BY pn.priority, n.id LIMIT 1;")"
	[ -x "$SUBSCRIPTION_PARSER" ] || die "subscription parser is not installed"
	mkdir -p "$SUBSCRIPTION_DIR" || die "cannot create subscription cache directory"
	chmod 700 "$SUBSCRIPTION_DIR" 2>/dev/null || :
	fetch_dir="${TMPDIR:-/tmp}/v2rayB-subscription-fetch.$$"
	raw_tmp="$fetch_dir/raw"
	error_tmp="$fetch_dir/error"
	rc_tmp="$fetch_dir/rc"
	pid_tmp="$fetch_dir/pid"
	nodes_tmp="$SUBSCRIPTION_DIR/.${source_id}.nodes.$$"
	sql_tmp="$SUBSCRIPTION_DIR/.${source_id}.sql.$$"
	trap 'rm -rf "$fetch_dir"; rm -f "$nodes_tmp" "$sql_tmp"; rm -rf "$CTL_LOCK_DIR"' EXIT HUP INT TERM
	[ -x "$SUBSCRIPTION_DOWNLOADER" ] || die "subscription downloader is not installed"
	command -v start-stop-daemon >/dev/null 2>&1 || die "start-stop-daemon is required"
	id -u "$SUBSCRIPTION_DOWNLOAD_USER" >/dev/null 2>&1 || die "subscription download user does not exist"
	mkdir -m 700 "$fetch_dir" || die "cannot create subscription fetch directory"
	chown "$SUBSCRIPTION_DOWNLOAD_USER:$SUBSCRIPTION_DOWNLOAD_GROUP" "$fetch_dir" || die "cannot prepare subscription fetch directory"
	start-stop-daemon -S -b -c "$SUBSCRIPTION_DOWNLOAD_USER:$SUBSCRIPTION_DOWNLOAD_GROUP" \
		-x "$SUBSCRIPTION_DOWNLOADER" -m -p "$pid_tmp" -- \
		"$raw_tmp" "$error_tmp" "$rc_tmp" "$ipv4_only" "$url" || die "cannot start subscription download"
	wait_count=0
	while kill -0 "$(sed -n '1p' "$pid_tmp" 2>/dev/null)" 2>/dev/null; do
		[ "$wait_count" -lt 30 ] || {
			kill "$(sed -n '1p' "$pid_tmp" 2>/dev/null)" 2>/dev/null || :
			die "subscription download did not finish"
		}
		wait_count=$((wait_count + 1))
		sleep 1
	done
	download_rc="$(sed -n '1p' "$rc_tmp" 2>/dev/null || printf 1)"
	if [ "$download_rc" != 0 ] || [ ! -s "$raw_tmp" ]; then
		error_text="subscription download failed; check the URL and router connectivity"
		set_source_error "$source_id" "$error_text"
		die "$error_text"
	fi
	if [ "$(id -u)" = 0 ]; then
		chown root:root "$raw_tmp" || die "cannot secure subscription cache"
	fi
	chmod 600 "$raw_tmp" 2>/dev/null || :
	if ! "$SUBSCRIPTION_PARSER" "$raw_tmp" "$format" "$name" > "$nodes_tmp" 2>"$error_tmp"; then
		error_text="$(tr '\n\t' '  ' < "$error_tmp" | cut -c1-300)"
		[ -n "$error_text" ] || error_text="subscription format could not be parsed"
		set_source_error "$source_id" "$error_text"
		die "$error_text"
	fi
	node_count="$(wc -l < "$nodes_tmp" | tr -d '[:space:]')"
	is_uint "$node_count" && [ "$node_count" -gt 0 ] && [ "$node_count" -le 512 ] || die "subscription returned an invalid node count"
	{
		printf '%s\n' 'PRAGMA foreign_keys=ON; BEGIN IMMEDIATE; CREATE TEMP TABLE import_names(name TEXT PRIMARY KEY);'
		while IFS="$(printf '\t')" read -r node_name protocol server port data_json; do
			[ -n "$node_name" ] || continue
			printf 'INSERT OR IGNORE INTO import_names(name) VALUES(%s);\n' "$(sql_quote "$node_name")"
		printf 'INSERT INTO nodes(source_id,name,protocol,server,port,data_json,enabled,last_error,updated_at) VALUES(%s,%s,%s,%s,%s,%s,1,NULL,CURRENT_TIMESTAMP) ON CONFLICT(source_id,name) DO UPDATE SET protocol=excluded.protocol,server=excluded.server,port=excluded.port,data_json=excluded.data_json,last_error=NULL,updated_at=CURRENT_TIMESTAMP;\n' \
				"$source_id" "$(sql_quote "$node_name")" "$(sql_quote "$protocol")" "$(sql_quote "$server")" "$port" "$(sql_quote "$data_json")"
		done < "$nodes_tmp"
		printf "UPDATE nodes SET last_error='not present in latest subscription',updated_at=CURRENT_TIMESTAMP WHERE source_id=%s AND name NOT IN (SELECT name FROM import_names);\\n" "$source_id"
		printf 'DELETE FROM nodes WHERE source_id=%s AND name NOT IN (SELECT name FROM import_names) AND NOT EXISTS (SELECT 1 FROM profile_nodes WHERE profile_nodes.node_id=nodes.id);\n' "$source_id"
		printf 'UPDATE sources SET last_error=NULL,last_updated=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP WHERE id=%s; COMMIT;\n' "$source_id"
	} > "$sql_tmp"
	if ! "$SQLITE3" -cmd ".timeout $SQLITE_BUSY_TIMEOUT_MS" -batch -bail "$DB" < "$sql_tmp"; then
		set_source_error "$source_id" "subscription nodes could not be committed"
		die "subscription nodes could not be committed"
	fi
	mv "$raw_tmp" "$SUBSCRIPTION_DIR/$source_id.raw" || die "could not replace subscription cache"
	active_runtime_changed=0
	active_after="$(db_sql "SELECT n.server || char(9) || n.data_json FROM profiles p JOIN profile_nodes pn ON pn.profile_id=p.id JOIN nodes n ON n.id=pn.node_id WHERE p.id=(SELECT value FROM settings WHERE key='active_profile') AND n.source_id=$source_id ORDER BY pn.priority, n.id LIMIT 1;")"
	if [ -n "$active_before" ] && [ "$active_before" != "$active_after" ]; then
		active_runtime_changed=1
	fi
	printf 'source_id=%s\nnodes=%s\ncache=%s\n' "$source_id" "$node_count" "$SUBSCRIPTION_DIR/$source_id.raw"
	printf 'active_runtime_changed=%s\n' "$active_runtime_changed"
}

cmd_subscription_update_start() {
	ensure_db
	source_id="$1"
	is_uint "$source_id" || die "source id must be numeric"
	source_type="$(db_sql "SELECT type FROM sources WHERE id=$source_id;")"
	[ "$source_type" = subscription ] || die "subscription source not found: $source_id"
	draft_pending && die "apply or revert pending changes before updating a subscription"

	mkdir -p "$SUBSCRIPTION_JOB_ROOT" || die "cannot create subscription job directory"
	find "$SUBSCRIPTION_JOB_ROOT" -mindepth 1 -maxdepth 1 -type d -mmin +60 -exec rm -rf {} + 2>/dev/null || :
	job_id="$(date +%s)-$$"
	job_dir="$SUBSCRIPTION_JOB_ROOT/$job_id"
	mkdir "$job_dir" || die "cannot create subscription job"
	printf 'running\n' > "$job_dir/status"
	printf '%s\n' "$job_id"

	(
		job_rc=0
		"$0" update-subscription "$source_id" > "$job_dir/output" 2> "$job_dir/error" || job_rc=$?
		if [ "$job_rc" -eq 0 ] && grep -q '^active_runtime_changed=1$' "$job_dir/output"; then
			service_enabled="$("$0" get-setting service_enabled 2>/dev/null || true)"
			runtime_state="$("$0" get-setting proxy_mode 2>/dev/null || true)"
			if [ "$service_enabled" = 1 ] && [ "$runtime_state" = proxy ]; then
				if ! /etc/init.d/v2rayB restart >> "$job_dir/output" 2>> "$job_dir/error"; then
					printf '%s\n' 'active subscription node changed, but v2rayB restart failed' >> "$job_dir/error"
					job_rc=1
				fi
			fi
		fi
		printf '%s\n' "$job_rc" > "$job_dir/rc.tmp"
		mv "$job_dir/rc.tmp" "$job_dir/rc"
		if [ "$job_rc" -eq 0 ]; then
			printf 'done\n' > "$job_dir/status.tmp"
		else
			printf 'failed\n' > "$job_dir/status.tmp"
		fi
		mv "$job_dir/status.tmp" "$job_dir/status"
	) </dev/null >/dev/null 2>&1 &
}

cmd_subscription_update_status() {
	job_id="$1"
	case "$job_id" in ''|*[!0-9-]*) die "invalid subscription job id" ;; esac
	job_dir="$SUBSCRIPTION_JOB_ROOT/$job_id"
	[ -d "$job_dir" ] || die "subscription job not found"
	job_status="$(sed -n '1p' "$job_dir/status" 2>/dev/null || printf running)"
	job_rc="$(sed -n '1p' "$job_dir/rc" 2>/dev/null || printf '%s\n' '-')"
	printf 'status=%s\nrc=%s\n' "$job_status" "$job_rc"
	printf '%s\n' '--output--'
	cat "$job_dir/output" 2>/dev/null || :
	printf '%s\n' '--error--'
	cat "$job_dir/error" 2>/dev/null || :
}

cmd_delete_source() {
	ensure_db
	source_id="$1"
	is_uint "$source_id" || die "source id must be numeric"
	type="$(db_sql "SELECT type FROM sources WHERE id=$source_id;" | sed -n '1p')"
	[ "$type" = subscription ] || die "source is not a subscription"
	nodes_table=nodes
	profile_nodes_table=profile_nodes
	if draft_pending; then
		nodes_table=draft_nodes
		profile_nodes_table=draft_profile_nodes
	fi
	refs="$(db_sql "SELECT COUNT(*) FROM $profile_nodes_table pn JOIN $nodes_table n ON n.id=pn.node_id WHERE n.source_id=$source_id;" | tr -d '[:space:]')"
	[ "$refs" = 0 ] || die "subscription has nodes referenced by a profile"
	draft_change_begin
	db_sql "DELETE FROM draft_nodes WHERE source_id=$source_id; INSERT OR IGNORE INTO draft_source_deletions(source_id) VALUES($source_id);"
	draft_change_commit
}

cmd_add_manual_node() {
