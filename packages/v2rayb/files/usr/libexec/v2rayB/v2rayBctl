cmd_render_v2ray() {
	ensure_db
	row="$(active_profile)"
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	read -r protocol server port data_json profile_direct_dns profile_proxy_ports bypass_china \
		use_v2ray_dns mosdns_enabled mosdns_domains proxy_router_traffic \
		transparent_proxy_port probe_enabled probe_port _profile_force_domains _profile_engine <<EOF
$row
EOF
	IFS="$old_ifs"
	is_protocol "$protocol" || die "unsupported active protocol: $protocol"
	is_server "$server" || die "invalid active server"
	is_uint "$port" || die "invalid active port"
	case "$bypass_china" in 0|1) ;; *) die "invalid profile bypass_china value" ;; esac
	case "$data_json" in
		\{*\}) ;;
		*) die "active node data_json is not an object" ;;
	esac
	data_body="${data_json#\{}"
	data_body="${data_body%\}}"
	[ -n "$data_body" ] || die "active node data_json is empty"
	force_domains="$(normalize_force_proxy_domains "$_profile_force_domains")"
	validate_force_proxy_domains "$force_domains" || die "invalid force proxy domain list"

	tmp="$ACTIVE_DIR/v2ray.json.tmp.$$"
	{
		printf '%s\n' '{'
		printf '%s\n' '  "log": {"loglevel": "warning", "error": "/tmp/v2rayB/v2ray-error.log"},'
		is_uint "$transparent_proxy_port" && [ "$transparent_proxy_port" -ge 1 ] 2>/dev/null && [ "$transparent_proxy_port" -le 65535 ] 2>/dev/null ||
			die "invalid transparent proxy listener port"
		case "$probe_enabled" in 0|1) ;; *) die "invalid probe enabled value" ;; esac
		is_uint "$probe_port" && [ "$probe_port" -ge 1 ] 2>/dev/null && [ "$probe_port" -le 65535 ] 2>/dev/null ||
			die "invalid probe port"
		[ "$transparent_proxy_port" != "$probe_port" ] || die "transparent proxy and probe ports must differ"
		printf '%s\n' '  "inbounds": ['
		if [ -n "$force_domains" ]; then
			printf '    {"tag":"redir-in","port":%s,"protocol":"dokodemo-door","settings":{"network":"tcp","followRedirect":true},"sniffing":{"enabled":true,"destOverride":["http","tls"],"routeOnly":true}},\n' "$transparent_proxy_port"
		else
			printf '    {"tag":"redir-in","port":%s,"protocol":"dokodemo-door","settings":{"network":"tcp","followRedirect":true}},\n' "$transparent_proxy_port"
		fi
		if [ "$probe_enabled" = 1 ]; then
			printf '%s\n' '    {"tag":"dns-in","listen":"127.0.0.1","port":5353,"protocol":"dokodemo-door","settings":{"address":"8.8.8.8","port":53,"network":"tcp,udp","followRedirect":false}},'
			printf '    {"tag":"health-in","listen":"127.0.0.1","port":%s,"protocol":"socks","settings":{"auth":"noauth","udp":false}}\n' "$probe_port"
			proxy_inbounds='"dns-in","health-in"'
		else
			printf '%s\n' '    {"tag":"dns-in","listen":"127.0.0.1","port":5353,"protocol":"dokodemo-door","settings":{"address":"8.8.8.8","port":53,"network":"tcp,udp","followRedirect":false}}'
			proxy_inbounds='"dns-in"'
		fi
		printf '%s\n' '  ],'
		printf '  "outbounds": [{"tag":"proxy","protocol":"%s",%s},\n' "$protocol" "$data_body"
		printf '%s\n' '    {"tag":"direct","protocol":"freedom","settings":{}},'
		printf '%s\n' '    {"tag":"blocked","protocol":"blackhole","settings":{}}],'
		printf '%s\n' '  "routing": {"domainStrategy":"IPIfNonMatch","rules":['
		printf '    {"type":"field","inboundTag":[%s],"outboundTag":"proxy"},\n' "$proxy_inbounds"
		if [ -n "$force_domains" ]; then
			force_route_domains="$(printf '%s\n' "$force_domains" | sed 's/,/","full:/g')"
			printf '    {"type":"field","domain":["full:%s"],"outboundTag":"proxy"},\n' "$force_route_domains"
		fi
		printf '%s\n' '    {"type":"field","ip":["geoip:private"],"outboundTag":"direct"},'
		if [ "$bypass_china" = 1 ]; then
			printf '%s\n' '    {"type":"field","ip":["geoip:cn"],"outboundTag":"direct"},'
		fi
		printf '%s\n' '    {"type":"field","inboundTag":["redir-in"],"outboundTag":"proxy"}'
		printf '%s\n' '  ]}'
		printf '%s\n' '}'
	} > "$tmp"
	mv "$tmp" "$ACTIVE_DIR/v2ray.json"
}

endpoint_to_addr() {
	value="$1"
	case "$value" in
		*://*) printf '%s\n' "$value" ;;
		*) printf 'udp://%s\n' "$value" ;;
	esac
}

hash_port_addr() {
	value="$1"
	printf '%s\n' "$value" | sed 's/#/:/'
}

dnsmasq_endpoint() {
	printf '%s\n' "$1" | sed 's/:\([0-9][0-9]*\)$/#\1/'
}

direct_dns_upstreams() {
	# Shared shell variables must not leak the caller's list into this function.
	_direct_dns_value="$(setting direct_dns_upstreams)"
	[ -n "$_direct_dns_value" ] || _direct_dns_value='223.5.5.5:53'
	printf '%s\n' "$_direct_dns_value"
}

first_direct_dns_upstream() {
	direct_dns_upstreams | awk -F ',' 'NF { print $1; exit }'
}

subscription_hosts() {
	db_sql "SELECT url FROM sources WHERE type='subscription' AND url IS NOT NULL ORDER BY id;" | awk '
		{
			url = $0
			sub(/^[A-Za-z][A-Za-z0-9+.-]*:\/\//, "", url)
			sub(/[\/?#].*$/, "", url)
			if (url ~ /^\[[^]]*\](:[0-9]+)?$/) {
				sub(/^\[/, "", url)
				sub(/\](:[0-9]+)?$/, "", url)
			} else if (url ~ /^[^:]+:[0-9]+$/) {
				sub(/:[0-9]+$/, "", url)
			}
			print tolower(url)
		}
	' | awk '
		function valid(host) {
			return length(host) <= 253 && host !~ /^[.]/ && host !~ /[.]$/ && host !~ /[^A-Za-z0-9._:-]/
		}
		NF && valid($0) { print }
	' | sort -u
}

dns_subscription_hosts() {
	hosts="$(subscription_hosts | tr '\n' ',' | sed 's/,$//')"
	printf '%s\n' "$hosts"
}

