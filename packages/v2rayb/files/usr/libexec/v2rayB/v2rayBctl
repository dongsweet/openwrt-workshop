	cat >&2 <<'EOF'
Usage:
  v2rayBctl init-db
  v2rayBctl status
  v2rayBctl get-setting KEY
  v2rayBctl set-setting KEY VALUE
  v2rayBctl set-state normal|starting|proxy|stopping|degraded
  v2rayBctl add-source manual|subscription|imported NAME [URL] [FORMAT]
  v2rayBctl add-node NAME PROTOCOL SERVER PORT DATA_JSON
  v2rayBctl update-node NODE_ID NAME PROTOCOL SERVER PORT DATA_JSON
  v2rayBctl set-node-enabled NODE_ID 0|1
  v2rayBctl delete-node NODE_ID
  v2rayBctl add-profile NAME NODE_ID [DIRECT_DNS PORTS BYPASS_CHINA USE_V2RAY_DNS MOSDNS_ENABLED MOSDNS_DOMAINS MOSDNS_MATCH_RULES PROXY_ROUTER_TRAFFIC]
  v2rayBctl update-profile PROFILE_ID NAME NODE_ID [DIRECT_DNS PORTS BYPASS_CHINA USE_V2RAY_DNS MOSDNS_ENABLED MOSDNS_DOMAINS MOSDNS_MATCH_RULES PROXY_ROUTER_TRAFFIC]
  v2rayBctl set-profile-policy PROFILE_ID DIRECT_DNS PORTS BYPASS_CHINA [USE_V2RAY_DNS MOSDNS_ENABLED MOSDNS_DOMAINS MOSDNS_MATCH_RULES PROXY_ROUTER_TRAFFIC]
  v2rayBctl set-profile-enabled PROFILE_ID 0|1
  v2rayBctl delete-profile PROFILE_ID
  v2rayBctl select-profile PROFILE_ID
  v2rayBctl apply-draft|revert-draft
  v2rayBctl rollback-apply|clear-apply-backup
  v2rayBctl list-nodes
  v2rayBctl get-node NODE_ID
  v2rayBctl list-profiles
  v2rayBctl get-applied-profile
  v2rayBctl get-profile PROFILE_ID
  v2rayBctl get-profile-rules PROFILE_ID
  v2rayBctl dns-state
  v2rayBctl dns-settings
  v2rayBctl render-v2ray|render-mosdns|render-nft|render-all
