  v2rayBctl network-probe-status JOB_ID
EOF
	exit 2
}

[ "$#" -gt 0 ] || usage
command="$1"
shift
case "$command" in
init-db|set-setting|set-state|add-source|add-node|update-node|set-node-enabled|delete-node|set-profile-policy|add-profile|update-profile|set-profile-enabled|delete-profile|select-profile|apply-draft|revert-draft|rollback-apply|clear-apply-backup|render-v2ray|render-mosdns|render-nft|render-all|apply-nft|delete-nft)
		acquire_ctl_lock
		;;
esac

case "$command" in
	init-db) [ "$#" -eq 0 ] || usage; cmd_init_db ;;
	status) [ "$#" -eq 0 ] || usage; cmd_status ;;
	dns-state) [ "$#" -eq 0 ] || usage; cmd_dns_state ;;
	dns-settings) [ "$#" -eq 0 ] || usage; cmd_dns_settings ;;
	get-setting) [ "$#" -eq 1 ] || usage; cmd_get_setting "$1" ;;
	set-setting) [ "$#" -eq 2 ] || usage; cmd_set_setting "$1" "$2" ;;
	set-state) [ "$#" -eq 1 ] || usage; cmd_set_state "$1" ;;
	add-source) [ "$#" -ge 2 ] && [ "$#" -le 4 ] || usage; cmd_add_source "$@" ;;
	add-node) [ "$#" -eq 5 ] || usage; cmd_add_manual_node "$@" ;;
	update-node) [ "$#" -eq 6 ] || usage; cmd_update_node "$@" ;;
	set-node-enabled) [ "$#" -eq 2 ] || usage; cmd_set_node_enabled "$@" ;;
	delete-node) [ "$#" -eq 1 ] || usage; cmd_delete_node "$1" ;;
	add-profile) { [ "$#" -eq 2 ] || [ "$#" -eq 5 ] || [ "$#" -eq 9 ] || [ "$#" -eq 10 ]; } || usage; cmd_add_profile "$@" ;;
	update-profile) { [ "$#" -eq 3 ] || [ "$#" -eq 6 ] || [ "$#" -eq 10 ] || [ "$#" -eq 11 ]; } || usage; cmd_update_profile "$@" ;;
	set-profile-policy) { [ "$#" -eq 4 ] || [ "$#" -eq 8 ] || [ "$#" -eq 9 ]; } || usage; cmd_set_profile_policy "$@" ;;
	set-profile-enabled) [ "$#" -eq 2 ] || usage; cmd_set_profile_enabled "$@" ;;
	delete-profile) [ "$#" -eq 1 ] || usage; cmd_delete_profile "$1" ;;
	select-profile) [ "$#" -eq 1 ] || usage; cmd_select_profile "$1" ;;
	apply-draft) [ "$#" -eq 0 ] || usage; cmd_apply_draft ;;
	revert-draft) [ "$#" -eq 0 ] || usage; cmd_revert_draft ;;
	rollback-apply) [ "$#" -eq 0 ] || usage; cmd_rollback_apply ;;
	clear-apply-backup) [ "$#" -eq 0 ] || usage; cmd_clear_apply_backup ;;
	list-nodes) [ "$#" -eq 0 ] || usage; cmd_list_nodes ;;
	get-node) [ "$#" -eq 1 ] || usage; cmd_get_node "$1" ;;
	list-profiles) [ "$#" -eq 0 ] || usage; cmd_list_profiles ;;
	get-applied-profile) [ "$#" -eq 0 ] || usage; cmd_get_applied_profile ;;
	get-profile) [ "$#" -eq 1 ] || usage; cmd_get_profile "$1" ;;
	get-profile-rules) [ "$#" -eq 1 ] || usage; cmd_get_profile_rules "$1" ;;
	render-v2ray) [ "$#" -eq 0 ] || usage; cmd_render_v2ray ;;
	render-mosdns) [ "$#" -eq 0 ] || usage; cmd_render_mosdns ;;
	render-nft) [ "$#" -eq 0 ] || usage; cmd_render_nft ;;
	render-all) [ "$#" -eq 0 ] || usage; cmd_render_all ;;
	apply-nft) [ "$#" -eq 0 ] || usage; cmd_apply_nft ;;
	delete-nft) [ "$#" -eq 0 ] || usage; cmd_delete_nft ;;
