#!/bin/sh

TAG="v2rayB-watchdog"
CTL="${V2RAYB_CTL:-/usr/libexec/v2rayB/v2rayBctl}"
INIT_SCRIPT="${V2RAYB_INIT_SCRIPT:-/etc/init.d/v2rayB}"
RUNTIME="${V2RAYB_RUNTIME_DIR:-/tmp/v2rayB}"
SUSPEND_PENDING_FILE="$RUNTIME/suspend-pending"
FAIL_LIMIT="${V2RAYB_WATCHDOG_FAIL_LIMIT:-3}"
INITIAL_DELAY="${V2RAYB_WATCHDOG_INITIAL_DELAY:-60}"
PROBE_MIN="${V2RAYB_WATCHDOG_PROBE_MIN:-10}"
PROBE_MAX="${V2RAYB_WATCHDOG_PROBE_MAX:-30}"
MAX_CYCLES="${V2RAYB_WATCHDOG_MAX_CYCLES:-0}"
RESTART_BACKOFF="${V2RAYB_WATCHDOG_RESTART_BACKOFF:-300}"
STATE_FILE="$RUNTIME/watchdog.state"
HEALTH_PROBE_PORT="${V2RAYB_HEALTH_PROBE_PORT:-12346}"
HEALTH_PROBE_URL="${V2RAYB_HEALTH_PROBE_URL:-https://www.gstatic.com/generate_204}"
failures=0
cycles=0
recovery_reported=0
last_restart="$(sed -n '1p' "$STATE_FILE" 2>/dev/null || printf 0)"
last_engine_restart="$(sed -n '2p' "$STATE_FILE" 2>/dev/null || printf 0)"
case "$last_engine_restart" in ''|*[!0-9]*) last_engine_restart=0 ;; esac
case "$last_restart" in ''|*[!0-9]*) last_restart=0 ;; esac

log() {
	logger -t "$TAG" "$*"
}

save_restart_times() {
	state_tmp="$STATE_FILE.tmp.$$"
	printf '%s\n%s\n' "$last_restart" "$last_engine_restart" > "$state_tmp"
	mv "$state_tmp" "$STATE_FILE"
}

random_delay() {
	awk -v min="$PROBE_MIN" -v max="$PROBE_MAX" \
		'BEGIN { srand(); print min + int(rand() * (max - min + 1)) }'
}

probe_proxy() {
	command -v curl >/dev/null 2>&1 || return 1
	curl --socks5-hostname "127.0.0.1:$HEALTH_PROBE_PORT" \
		--fail --silent --show-error --output /dev/null \
		--connect-timeout 8 --max-time 15 "$HEALTH_PROBE_URL"
}

log "started; waiting ${INITIAL_DELAY}s before the first proxy connectivity probe"
sleep "$INITIAL_DELAY"
log "proxy connectivity probe interval is randomized from $PROBE_MIN to $PROBE_MAX seconds"

while :; do
	sleep "$(random_delay)"
	cycles=$((cycles + 1))
	state="$(sed -n '1p' "$RUNTIME/state" 2>/dev/null)"
	if [ -e "$SUSPEND_PENDING_FILE" ]; then
		if [ "$state" = normal ] || [ "$state" = suspended ]; then
			rm -f "$SUSPEND_PENDING_FILE"
		else
			if probe_proxy; then
				if [ "$failures" -gt 0 ]; then
					log "proxy probe recovered while fail-open cleanup remains incomplete"
				fi
				failures=0
			else
				[ "$failures" -ge "$FAIL_LIMIT" ] || failures=$((failures + 1))
			fi
			if "$INIT_SCRIPT" suspend; then
				log "fail-open suspension completed after retry"
				failures=0
				recovery_reported=0
			else
				if [ "$recovery_reported" = 0 ]; then
					log "fail-open cleanup remains incomplete; watchdog will probe and retry"
					recovery_reported=1
				fi
				failures="$FAIL_LIMIT"
			fi
			[ "$MAX_CYCLES" -le 0 ] 2>/dev/null || [ "$cycles" -lt "$MAX_CYCLES" ] || break
			continue
		fi
	fi
	case "$state" in
		proxy|suspended) ;;
		*)
			failures=0
			recovery_reported=0
			[ "$MAX_CYCLES" -le 0 ] 2>/dev/null || [ "$cycles" -lt "$MAX_CYCLES" ] || break
			continue
			;;
	esac
	now="$(date +%s)"

	if probe_proxy; then
		if [ "$state" = suspended ]; then
			auto_recover="$("$CTL" get-setting watchdog_auto_recover 2>/dev/null || printf 0)"
			if [ "$auto_recover" = 1 ]; then
				if [ "$((now - last_engine_restart))" -ge "$RESTART_BACKOFF" ]; then
					log "proxy connectivity recovered; attempting throttled automatic recovery"
					last_engine_restart="$now"
					save_restart_times
					if "$INIT_SCRIPT" recover; then
						log "automatic recovery completed"
						failures=0
						recovery_reported=0
					else
						log "automatic recovery failed; watchdog will retry after the recovery interval"
						failures="$FAIL_LIMIT"
					fi
				elif [ "$recovery_reported" = 0 ]; then
					log "proxy connectivity recovered; automatic recovery is waiting for its retry interval"
					recovery_reported=1
				fi
			elif [ "$recovery_reported" = 0 ]; then
				log "proxy connectivity recovered; automatic recovery is disabled"
				recovery_reported=1
			fi
		elif [ "$failures" -gt 0 ]; then
			log "proxy connectivity recovered after $failures consecutive failure(s)"
			failures=0
		fi
		[ "$MAX_CYCLES" -le 0 ] 2>/dev/null || [ "$cycles" -lt "$MAX_CYCLES" ] || break
		continue
	fi

	if [ "$failures" -lt "$FAIL_LIMIT" ]; then
		failures=$((failures + 1))
		log "proxy connectivity probe failed ($failures/$FAIL_LIMIT)"
	fi
	[ "$failures" -ge "$FAIL_LIMIT" ] || {
		[ "$MAX_CYCLES" -le 0 ] 2>/dev/null || [ "$cycles" -lt "$MAX_CYCLES" ] || break
		continue
	}

	if [ "$state" = suspended ]; then
		restart_engine="$("$CTL" get-setting watchdog_restart_engine 2>/dev/null || printf 0)"
		if [ "$restart_engine" = 1 ] && [ "$((now - last_engine_restart))" -ge "$RESTART_BACKOFF" ]; then
			log "suspended proxy is still unreachable; restarting the selected engine after the retry interval"
			last_engine_restart="$now"
			save_restart_times
			if "$INIT_SCRIPT" recover; then
				log "suspended engine restarted; takeover restored after successful probe"
				failures=0
				recovery_reported=0
			else
				log "suspended engine restart did not restore connectivity; retry is throttled"
				failures="$FAIL_LIMIT"
			fi
		fi
		[ "$MAX_CYCLES" -le 0 ] 2>/dev/null || [ "$cycles" -lt "$MAX_CYCLES" ] || break
		continue
	fi

	last_restart="$now"
	save_restart_times
	fallback="$("$CTL" get-setting fallback_on_failure 2>/dev/null || printf 0)"
	if [ "$fallback" = 1 ]; then
		log "proxy connectivity failed $failures consecutive times; withdrawing traffic and DNS imports"
		if "$INIT_SCRIPT" suspend; then
			log "traffic withdrawn; watchdog remains active"
			failures=0
		else
			log "v2rayB suspend failed; watchdog will retry"
		fi
	else
		failures=0
		log "proxy connectivity is failing but fallback_on_failure is disabled"
	fi
	[ "$MAX_CYCLES" -le 0 ] 2>/dev/null || [ "$cycles" -lt "$MAX_CYCLES" ] || break
done
