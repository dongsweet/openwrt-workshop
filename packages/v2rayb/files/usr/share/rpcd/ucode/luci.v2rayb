#!/usr/bin/env ucode

'use strict';

import { popen } from 'fs';

const ctl_path = '/usr/libexec/v2rayB/v2rayBctl';
const init_path = '/etc/init.d/v2rayB';

function shell_quote(value) {
	return "'" + replace('' + value, /'/g, "'\\''") + "'";
}

function run(path, args) {
	let command = path;
	for (let i = 0; i < length(args); i++)
		command += ' ' + shell_quote(args[i]);

	let pipe = popen(command + ' 2>&1', 'r');
	if (!pipe)
		return { code: -1, output: 'Unable to start v2rayB command' };

	let output = pipe.read('all') || '';
	let code = pipe.close();
	return {
		code: code,
		output: replace(output, /^\s+|\s+$/g, '')
	};
}

function ctl(args) {
	return run(ctl_path, args);
}

function string_arg(request, key) {
	let value = request?.args?.[key];
	return type(value) == 'string' ? value : '';
}

function failed(result) {
	return {
		success: false,
		error: result.output || 'v2rayB command failed'
	};
}

function probe_result(result) {
	if (result.code != 0)
		return failed(result);
	return {
		success: true,
		output: result.output || ''
	};
}

function valid_id(value) {
	return match(value, /^[0-9]+$/);
}

function valid_profile_policy(direct_dns, ports, bypass_china, use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules) {
	if (direct_dns == '' || length(direct_dns) > 255)
		return 'Invalid direct DNS endpoint';
	if (ports == '' || length(ports) > 255 ||
	    !match(ports, /^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$/))
		return 'Invalid transparent proxy port list';
	if (!match(bypass_china, /^[01]$/))
		return 'Invalid Bypass China IP value; expected 0 or 1';
	if (!match(use_v2ray_dns, /^[01]$/))
		return 'Invalid Use V2Ray DNS value; expected 0 or 1';
	if (!match(mosdns_enabled, /^[01]$/))
		return 'Invalid Enable MosDNS value; expected 0 or 1';
	if ((mosdns_enabled == '1' && mosdns_domains == '') || length(mosdns_domains) > 1024)
		return 'Invalid MosDNS domain list';
	if (mosdns_match_rules != '' && length(mosdns_match_rules) > 16384)
		return 'MosDNS match rules are too long';
	return null;
}

function valid_node_fields(name, protocol, server, port, data_json) {
	if (length(name) > 64 || length(server) > 255 || length(data_json) > 16384)
		return 'One or more fields are too long';
	if (!match(protocol, /^(vless|vmess|trojan|shadowsocks)$/))
		return 'Unsupported node protocol';
	if (!match(port, /^[0-9]+$/) || +port < 1 || +port > 65535)
		return 'Invalid node port';
	if (data_json == '' || substr(data_json, 0, 1) != '{' ||
	    substr(data_json, length(data_json) - 1, 1) != '}')
		return 'Outbound data must be a JSON object';
	return null;
}

const methods = {
	status: {
		call: function() {
			return ctl([ 'status' ]);
		}
	},

	dns_state: {
		call: function() {
			return ctl([ 'dns-state' ]);
		}
	},

	get_v2ray_config: {
		call: function() {
			let result = ctl([ 'get-v2ray-config' ]);
			return result.code == 0 ? result : failed(result);
		}
	},

	network_probe: {
		args: { url: '' },
		call: function(request) {
			let url = string_arg(request, 'url');
			if (length(url) == 0 || length(url) > 2048 ||
			    !match(url, /^https?:\/\/[A-Za-z0-9._:[\]-]+(\/.*)?$/))
				return { success: false, error: 'Enter a valid http:// or https:// URL' };
			return probe_result(ctl([ 'network-probe', url ]));
		}
	},

	list_nodes: {
		call: function() {
			return ctl([ 'list-nodes' ]);
		}
	},

	get_node: {
		args: { node_id: '' },
		call: function(request) {
			let node_id = string_arg(request, 'node_id');
			if (!valid_id(node_id))
				return { success: false, error: 'Invalid node id' };
			let result = ctl([ 'get-node', node_id ]);
			if (result.code != 0)
				return failed(result);
			let columns = split(result.output, '\t');
			if (length(columns) != 6)
				return { success: false, error: 'Node details could not be read' };
			return {
				success: true,
				node: {
					id: node_id,
					name: columns[0],
					protocol: columns[1],
					server: columns[2],
					port: columns[3],
					enabled: columns[4],
					data_json: columns[5]
				}
			};
		}
	},

	list_profiles: {
		call: function() {
			return ctl([ 'list-profiles' ]);
		}
	},

	get_applied_profile: {
		call: function() {
			return ctl([ 'get-applied-profile' ]);
		}
	},

	get_profile: {
		args: { profile_id: '' },
		call: function(request) {
			let profile_id = string_arg(request, 'profile_id');
			if (!valid_id(profile_id))
				return { success: false, error: 'Invalid profile id' };
			let result = ctl([ 'get-profile', profile_id ]);
			if (result.code != 0)
				return failed(result);
			let rules = ctl([ 'get-profile-rules', profile_id ]);
			if (rules.code != 0)
				return failed(rules);
			let fields = {};
			let lines = split(result.output, '\n');
			for (let i = 0; i < length(lines); i++) {
				let line = lines[i], sep = index(line, '=');
				if (sep > 0)
					fields[substr(line, 0, sep)] = substr(line, sep + 1);
			}
			if (!fields.name || !fields.node_id)
				return { success: false, error: 'Profile details could not be read' };
			return {
				success: true,
				profile: {
					id: profile_id,
					name: fields.name,
					node_id: fields.node_id,
					enabled: fields.enabled || '1',
					direct_dns: fields.direct_dns || '',
					transparent_proxy_ports: fields.transparent_proxy_ports || '',
					bypass_china: fields.bypass_china || '1',
					use_v2ray_dns: fields.use_v2ray_dns || '1',
					mosdns_enabled: fields.mosdns_enabled || '1',
					mosdns_domains: fields.mosdns_domains || '',
					mosdns_match_rules: rules.output
				}
			};
		}
	},

	service_action: {
		args: { action: '' },
		call: function(request) {
			let action = string_arg(request, 'action');
			if (!match(action, /^(start|stop|restart)$/))
				return { success: false, error: 'Unsupported service action' };

			let result = run(init_path, [ action ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	set_setting: {
		args: { key: '', value: '' },
		call: function(request) {
			let key = string_arg(request, 'key');
			let value = string_arg(request, 'value');
			if (key != 'service_enabled')
				return { success: false, error: 'Unsupported setting' };

			let result = ctl([ 'set-setting', key, value ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	apply_draft: {
		call: function() {
			let before = ctl([ 'status' ]);
			if (before.code != 0)
				return failed(before);

			let apply = ctl([ 'apply-draft' ]);
			if (apply.code != 0)
			{
				let rollback = ctl([ 'rollback-apply' ]);
				if (rollback.code == 0)
					ctl([ 'render-all' ]);
				return { success: false, error: apply.output || 'Draft could not be applied' };
			}

			function rollbackAppliedChange(message) {
				let rollback = ctl([ 'rollback-apply' ]);
				if (rollback.code != 0)
					return { success: false, error: message + '; rollback failed: ' + (rollback.output || 'unknown error') };
				let renderOld = ctl([ 'render-all' ]);
				if (renderOld.code != 0)
					return { success: false, error: message + '; database rolled back but old runtime configuration could not be rendered: ' + (renderOld.output || 'unknown error') };
				let wasProxy = match(before.output, /(^|\n)state=proxy(\n|$)/);
				let wasEnabled = match(before.output, /(^|\n)service_enabled=1(\n|$)/);
				let restoreBoot = run(init_path, [ wasEnabled ? 'enable' : 'disable' ]);
				if (restoreBoot.code != 0)
					return { success: false, error: message + '; database rolled back but boot state restoration failed: ' + (restoreBoot.output || 'unknown error') };
				let restored = run(init_path, [ wasProxy ? 'restart' : 'stop' ]);
				if (restored.code != 0)
					return { success: false, error: message + '; configuration rolled back but service restoration failed: ' + (restored.output || 'unknown error') };
				ctl([ 'clear-apply-backup' ]);
				return { success: false, error: message };
			}

			let render = ctl([ 'render-all' ]);
			if (render.code != 0)
				return rollbackAppliedChange(render.output || 'Applied configuration could not be rendered');

			let status = ctl([ 'status' ]);
			if (status.code != 0)
				return rollbackAppliedChange(status.output || 'Applied configuration status could not be read');

			let enabled = match(status.output, /(^|\n)service_enabled=1(\n|$)/);
			let boot = run(init_path, [ enabled ? 'enable' : 'disable' ]);
			if (boot.code != 0)
				return rollbackAppliedChange(boot.output || 'Applied, but boot state update failed');

			if (enabled) {
				let was_proxy = match(before.output, /(^|\n)state=proxy(\n|$)/);
				let action = was_proxy ? 'restart' : 'start';
				let current = run(init_path, [ action ]);
				if (current.code != 0)
					return rollbackAppliedChange(current.output || 'Applied, but service start failed');
			}
			else {
				let stop = run(init_path, [ 'stop' ]);
				if (stop.code != 0)
					return rollbackAppliedChange(stop.output || 'Applied, but service stop failed');
			}
			let after = ctl([ 'status' ]);
			if (after.code != 0)
				return rollbackAppliedChange(after.output || 'Applied service state could not be verified');
			let nowProxy = match(after.output, /(^|\n)state=proxy(\n|$)/);
			let nowNormal = match(after.output, /(^|\n)state=normal(\n|$)/);
			if ((enabled && !nowProxy) || (!enabled && !nowNormal))
				return rollbackAppliedChange('Service action returned without reaching the expected runtime state');
			ctl([ 'clear-apply-backup' ]);
			return { success: true };
		}
	},

	revert_draft: {
		call: function() {
			let result = ctl([ 'revert-draft' ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	select_profile: {
		args: { profile_id: '' },
		call: function(request) {
			let profile_id = string_arg(request, 'profile_id');
			if (!match(profile_id, /^[0-9]+$/))
				return { success: false, error: 'Invalid profile id' };

			let result = ctl([ 'select-profile', profile_id ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	add_node: {
		args: {
			name: '', protocol: '', server: '', port: '', data_json: ''
		},
		call: function(request) {
			let name = string_arg(request, 'name');
			let protocol = string_arg(request, 'protocol');
			let server = string_arg(request, 'server');
			let port = string_arg(request, 'port');
			let data_json = string_arg(request, 'data_json');
			let error = valid_node_fields(name, protocol, server, port, data_json);
			if (error != null)
				return { success: false, error: error };

			let result = ctl([ 'add-node', name, protocol, server, port, data_json ]);
			if (result.code != 0)
				return failed(result);

			let node_id = replace(result.output, /^\s+|\s+$/g, '');
			if (!match(node_id, /^[0-9]+$/))
				return { success: false, error: 'Node was saved but its id could not be read' };

			return { success: true, node_id: node_id };
		}
	},

	add_profile: {
		args: { name: '', node_id: '', direct_dns: '', transparent_proxy_ports: '', bypass_china: '1', use_v2ray_dns: '1', mosdns_enabled: '1', mosdns_domains: 'xn--ngstr-lra8j.com', mosdns_match_rules: '' },
		call: function(request) {
			let name = string_arg(request, 'name');
			let node_id = string_arg(request, 'node_id');
			let direct_dns = string_arg(request, 'direct_dns');
			let transparent_proxy_ports = string_arg(request, 'transparent_proxy_ports');
			let bypass_china = string_arg(request, 'bypass_china');
			let use_v2ray_dns = string_arg(request, 'use_v2ray_dns');
			let mosdns_enabled = string_arg(request, 'mosdns_enabled');
			let mosdns_domains = string_arg(request, 'mosdns_domains');
			let mosdns_match_rules = string_arg(request, 'mosdns_match_rules');
			if (length(name) > 64)
				return { success: false, error: 'Profile name is too long' };
			if (!match(node_id, /^[0-9]+$/))
				return { success: false, error: 'Select a valid primary node' };
			let policy_error = valid_profile_policy(direct_dns, transparent_proxy_ports, bypass_china,
				use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules);
			if (policy_error != null)
				return { success: false, error: policy_error };

			let profiles = ctl([ 'list-profiles' ]);
			if (profiles.code != 0)
				return failed(profiles);
			let profile_lines = split(profiles.output, '\n');
			for (let i = 0; i < length(profile_lines); i++) {
				let columns = split(profile_lines[i], '\t');
				if (columns[1] == name)
					return { success: false, error: 'A profile with this name already exists' };
			}

			let result = ctl([ 'add-profile', name, node_id, direct_dns, transparent_proxy_ports, bypass_china,
				use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules ]);
			if (result.code != 0)
				return failed(result);

			return { success: true, profile_id: replace(result.output, /^\s+|\s+$/g, '') };
		}
	},

	update_node: {
		args: { node_id: '', name: '', protocol: '', server: '', port: '', data_json: '' },
		call: function(request) {
			let node_id = string_arg(request, 'node_id');
			let name = string_arg(request, 'name');
			let protocol = string_arg(request, 'protocol');
			let server = string_arg(request, 'server');
			let port = string_arg(request, 'port');
			let data_json = string_arg(request, 'data_json');
			if (!valid_id(node_id))
				return { success: false, error: 'Invalid node id' };
			let error = valid_node_fields(name, protocol, server, port, data_json);
			if (error != null)
				return { success: false, error: error };
			let result = ctl([ 'update-node', node_id, name, protocol, server, port, data_json ]);
			return result.code == 0 ? { success: true, node_id: node_id } : failed(result);
		}
	},

	set_node_enabled: {
		args: { node_id: '', enabled: '' },
		call: function(request) {
			let node_id = string_arg(request, 'node_id');
			let enabled = string_arg(request, 'enabled');
			if (!valid_id(node_id) || !match(enabled, /^[01]$/))
				return { success: false, error: 'Invalid node state' };
			let result = ctl([ 'set-node-enabled', node_id, enabled ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	delete_node: {
		args: { node_id: '' },
		call: function(request) {
			let node_id = string_arg(request, 'node_id');
			if (!valid_id(node_id))
				return { success: false, error: 'Invalid node id' };
			let result = ctl([ 'delete-node', node_id ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	update_profile: {
		args: { profile_id: '', name: '', node_id: '', direct_dns: '', transparent_proxy_ports: '', bypass_china: '1', use_v2ray_dns: '1', mosdns_enabled: '1', mosdns_domains: 'xn--ngstr-lra8j.com', mosdns_match_rules: '' },
		call: function(request) {
			let profile_id = string_arg(request, 'profile_id');
			let name = string_arg(request, 'name');
			let node_id = string_arg(request, 'node_id');
			let direct_dns = string_arg(request, 'direct_dns');
			let transparent_proxy_ports = string_arg(request, 'transparent_proxy_ports');
			let bypass_china = string_arg(request, 'bypass_china');
			let use_v2ray_dns = string_arg(request, 'use_v2ray_dns');
			let mosdns_enabled = string_arg(request, 'mosdns_enabled');
			let mosdns_domains = string_arg(request, 'mosdns_domains');
			let mosdns_match_rules = string_arg(request, 'mosdns_match_rules');
			if (!valid_id(profile_id) || !valid_id(node_id))
				return { success: false, error: 'Invalid profile or node id' };
			if (name == '' || length(name) > 64)
				return { success: false, error: 'Invalid profile name' };
			let policy_error = valid_profile_policy(direct_dns, transparent_proxy_ports, bypass_china,
				use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules);
			if (policy_error != null)
				return { success: false, error: policy_error };
			let result = ctl([ 'update-profile', profile_id, name, node_id, direct_dns, transparent_proxy_ports, bypass_china,
				use_v2ray_dns, mosdns_enabled, mosdns_domains, mosdns_match_rules ]);
			return result.code == 0 ? { success: true, profile_id: profile_id } : failed(result);
		}
	},

	set_profile_enabled: {
		args: { profile_id: '', enabled: '' },
		call: function(request) {
			let profile_id = string_arg(request, 'profile_id');
			let enabled = string_arg(request, 'enabled');
			if (!valid_id(profile_id) || !match(enabled, /^[01]$/))
				return { success: false, error: 'Invalid profile state' };
			let result = ctl([ 'set-profile-enabled', profile_id, enabled ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	},

	delete_profile: {
		args: { profile_id: '' },
		call: function(request) {
			let profile_id = string_arg(request, 'profile_id');
			if (!valid_id(profile_id))
				return { success: false, error: 'Invalid profile id' };
			let result = ctl([ 'delete-profile', profile_id ]);
			return result.code == 0 ? { success: true } : failed(result);
		}
	}
};

return { 'luci.v2rayb': methods };
