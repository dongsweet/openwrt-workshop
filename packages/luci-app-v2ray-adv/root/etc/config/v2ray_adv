
config global 'main'
	option enabled '0'
	option log_level 'warning'

	option dns_port '5353'
	option access_log '/var/log/v2ray-acc.log'
	option error_log '/var/log/v2ray.log'
	option v2ray_path '/usr/bin/v2ray'

config server 'hk_server'
	option alias 'Hong Kong 1'
	option address 'hk.example.com'
	option port '443'
	option protocol 'vless'
	option uuid '00000000-0000-0000-0000-000000000000'
	option vless_encryption 'none'
	option security 'tls'
	list alpn 'h2'
	option sni 'hk.example.com'
	option transport 'h2'
	option h2_path '/updh2'
	option h2_host 'hk.example.com'
	option enabled '1'

config server 'jp_server'
	option alias 'Japan 1'
	option address 'jp.example.com'
	option port '443'
	option protocol 'vless'
	option uuid '00000000-0000-0000-0000-000000000000'
	option vless_encryption 'none'
	option security 'tls'
	list alpn 'h2'
	option sni 'jp.example.com'
	option transport 'h2'
	option h2_path '/updh2'
	option h2_host 'jp.example.com'
	option enabled '0'

config rule 'google_rule'
	option alias 'Google Traffic'
	list domain 'google.com'
	list domain 'youtube.com'
	option server 'hk_server'
	option enabled '1'

config inbound 'tproxy_in'
	option alias 'Transparent Proxy'
	option protocol 'dokodemo-door'
	option port '12345'
	option listen '0.0.0.0'
	option follow_redirect '1'
	option u_tproxy '1'
	option enabled '1'

config inbound 'vmess_in'
	option alias 'VMess Service'
	option protocol 'vmess'
	option port '10086'
	option listen '0.0.0.0'
	option uuid '11111111-1111-1111-1111-111111111111'
	option vmess_security 'auto'
	option enabled '0'

config routing 'routing'
	option default_server 'hk_server'

config transparent_proxy 'tproxy'
	option inbound 'tproxy_in'
	option bypass_china '1'
	option force_proxy_server 'hk_server'
	list force_proxy_domain 'google.com'
	list force_proxy_domain 'googleapis.com'
	list force_proxy_domain 'gstatic.com'
	list force_proxy_domain 'googleusercontent.com'
	list force_proxy_domain 'ggpht.com'
	list pass_ip '223.5.5.5'
	list pass_ip '119.29.29.29'

config data 'data'
	option geoip_url 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat'
	option geosite_url 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat'
	option cn_ips_url 'https://raw.githubusercontent.com/Loyalsoldier/geoip/release/text/cn.txt'
