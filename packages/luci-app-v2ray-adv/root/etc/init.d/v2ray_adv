#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
EXTRA_COMMANDS="print_config"

CONF_FILE="/var/etc/v2ray_adv/v2ray.json"
CONF_DIR="/var/etc/v2ray_adv"

# Load jshn for JSON generation
. /usr/share/libubox/jshn.sh

generate_json() {
	mkdir -p "$CONF_DIR"

	config_load v2ray_adv
	
	local override_config custom_json
	config_get_bool override_config "main" "override_config" 0
	config_get custom_json "main" "custom_json"

	if [ "$override_config" -eq 1 ] && [ -n "$custom_json" ]; then
		echo "$custom_json" > "$CONF_FILE"
		return 0
	fi

	local log_level access_log error_log
	config_get log_level "main" "log_level" "warning"
	config_get access_log "main" "access_log" "/var/log/v2ray-acc.log"
	config_get error_log "main" "error_log" "/var/log/v2ray.log"

	json_init
	
	# Log section
	json_add_object "log"
		json_add_string "loglevel" "$log_level"
		json_add_string "access" "$access_log"
		json_add_string "error" "$error_log"
	json_close_object

	# Inbounds section
	json_add_array "inbounds"
		config_foreach add_inbound_json "inbound"
	json_close_array

	# Outbounds section
	_first_server_tag=""
	json_add_array "outbounds"
		# Iterate through servers
		config_foreach add_outbound "server"

		# Direct outbound
		json_add_object
			json_add_string "tag" "direct"
			json_add_string "protocol" "freedom"
			json_add_object "settings"
			json_close_object
			json_add_object "streamSettings"
				json_add_object "sockopt"
					json_add_int "mark" 255
				json_close_object
			json_close_object
		json_close_object

		# Block outbound
		json_add_object
			json_add_string "tag" "block"
			json_add_string "protocol" "blackhole"
			json_add_object "settings"
			json_close_object
		json_close_object
	json_close_array

	# Routing section
	json_add_object "routing"
		json_add_string "domainStrategy" "IPIfNonMatch"
		json_add_array "rules"
			# Add rules from UCI
			config_foreach add_routing_rule "rule"

			# Default rules (Bypass China if enabled)
			local bypass_china
			config_get_bool bypass_china "tproxy" "bypass_china" 1
			if [ "$bypass_china" -eq 1 ]; then
				json_add_object
					json_add_string "type" "field"
					json_add_string "outboundTag" "direct"
					json_add_array "ip"
						json_add_string "" "geoip:cn"
						json_add_string "" "geoip:private"
					json_close_array
				json_close_object
				json_add_object
					json_add_string "type" "field"
					json_add_string "outboundTag" "direct"
					json_add_array "domain"
						json_add_string "" "geosite:cn"
					json_close_array
				json_close_object
			fi

			# Default catch-all rule: send remaining traffic to the configured default server
			local default_server
			config_get default_server "routing" "default_server" ""
			[ -z "$default_server" ] && default_server="$_first_server_tag"
			if [ -n "$default_server" ]; then
				json_add_object
					json_add_string "type" "field"
					json_add_string "outboundTag" "$default_server"
					json_add_string "port" "0-65535"
				json_close_object
			fi
		json_close_array
	json_close_object
	
	json_dump > "$CONF_FILE"
	chmod 644 "$CONF_FILE"
}

_add_array_string() {
	json_add_string "" "$1"
}

_add_ipset_pass() {
	ipset add pass "$1" 2>/dev/null
}

_add_server_to_pass() {
	local section="$1"
	local enabled address
	config_get_bool enabled "$section" "enabled" 0
	[ "$enabled" -eq 0 ] && return
	
	config_get address "$section" "address"
	[ -n "$address" ] && ipset add pass "$address" 2>/dev/null
}

print_config() {
	generate_json
	if [ -f "$CONF_FILE" ]; then
		cat "$CONF_FILE"
	else
		echo '{"error": "Failed to generate config"}'
	fi
}

add_inbound_json() {
	local section="$1"
	local enabled protocol port listen alias
	config_get_bool enabled "$section" "enabled" 0
	[ "$enabled" -eq 0 ] && return

	config_get protocol "$section" "protocol"
	config_get port "$section" "port"
	config_get listen "$section" "listen" "0.0.0.0"
	config_get alias "$section" "alias" "$section"

	json_add_object
		json_add_string "tag" "$alias"
		json_add_string "listen" "$listen"
		json_add_int "port" "$port"
		json_add_string "protocol" "$protocol"

		case "$protocol" in
			dokodemo-door)
				local follow_redirect u_tproxy
				config_get_bool follow_redirect "$section" "follow_redirect" 1
				config_get_bool u_tproxy "$section" "u_tproxy" 1
				json_add_object "settings"
					json_add_string "network" "tcp,udp"
					[ "$follow_redirect" -eq 1 ] && json_add_boolean "followRedirect" 1
				json_close_object
				# Enable sniffing to recover domain names from TLS SNI / HTTP Host
				json_add_object "sniffing"
					json_add_boolean "enabled" 1
					json_add_array "destOverride"
						json_add_string "" "http"
						json_add_string "" "tls"
					json_close_array
				json_close_object
				if [ "$u_tproxy" -eq 1 ]; then
					json_add_object "streamSettings"
						json_add_object "sockopt"
							json_add_string "tproxy" "redirect"
							json_add_int "mark" 255
						json_close_object
					json_close_object
				fi
			;;
			vmess)
				local uuid security
				config_get uuid "$section" "uuid"
				config_get security "$section" "vmess_security" "auto"
				json_add_object "settings"
					json_add_array "clients"
						json_add_object
							json_add_string "id" "$uuid"
							json_add_int "level" 0
							json_add_int "alterId" 0
							json_add_string "security" "$security"
						json_close_object
					json_close_array
				json_close_object
			;;
			shadowsocks)
				local password method
				config_get password "$section" "uuid"
				config_get method "$section" "method" "aes-256-gcm"
				json_add_object "settings"
					json_add_string "method" "$method"
					json_add_string "password" "$password"
					json_add_string "network" "tcp,udp"
				json_close_object
			;;
			*)
				json_add_object "settings"
				json_close_object
			;;
		esac
	json_close_object
}

add_outbound() {
	local section="$1"
	local enabled
	config_get_bool enabled "$section" "enabled" 0
	[ "$enabled" -eq 0 ] && return

	# Track the first enabled server for default routing
	[ -z "$_first_server_tag" ] && _first_server_tag="$section"

	local protocol address port uuid flow security transport
	config_get protocol "$section" "protocol"
	config_get address "$section" "address"
	config_get port "$section" "port"
	config_get uuid "$section" "uuid"
	config_get flow "$section" "flow"
	config_get security "$section" "security" "none"
	config_get transport "$section" "transport" "tcp"

	json_add_object
		json_add_string "tag" "$section"
		json_add_string "protocol" "$protocol"
		
		json_add_object "settings"
			case "$protocol" in
				vless)
					json_add_array "vnext"
						json_add_object
							json_add_string "address" "$address"
							json_add_int "port" "$port"
							json_add_array "users"
								json_add_object
									json_add_string "id" "$uuid"
									json_add_string "encryption" "none"
									[ -n "$flow" ] && json_add_string "flow" "$flow"
									json_add_int "level" 0
								json_close_object
							json_close_array
						json_close_object
					json_close_array
				;;
				vmess)
					json_add_array "vnext"
						json_add_object
							json_add_string "address" "$address"
							json_add_int "port" "$port"
							json_add_array "users"
								json_add_object
									json_add_string "id" "$uuid"
									json_add_int "alterId" 0
									json_add_int "level" 0
								json_close_object
							json_close_array
						json_close_object
					json_close_array
				;;
				shadowsocks)
					json_add_array "servers"
						json_add_object
							json_add_string "address" "$address"
							json_add_int "port" "$port"
							json_add_string "method" "aes-256-gcm"
							json_add_string "password" "$uuid"
						json_close_object
					json_close_array
				;;
				trojan)
					json_add_array "servers"
						json_add_object
							json_add_string "address" "$address"
							json_add_int "port" "$port"
							json_add_string "password" "$uuid"
						json_close_object
					json_close_array
				;;
			esac
		json_close_object

		# Stream Settings
		json_add_object "streamSettings"
			json_add_string "network" "$transport"
			
			json_add_object "sockopt"
				json_add_int "mark" 255
			json_close_object

			local insecure alpn
			config_get_bool insecure "$section" "insecure" 0
			config_get alpn "$section" "alpn"

			if [ "$security" = "tls" ]; then
				json_add_string "security" "tls"
				local sni
				config_get sni "$section" "sni"
				json_add_object "tlsSettings"
					[ -n "$sni" ] && json_add_string "serverName" "$sni"
					[ "$insecure" -eq 1 ] && json_add_boolean "allowInsecure" 1
					if [ -n "$alpn" ]; then
						json_add_array "alpn"
						for a in $alpn; do json_add_string "" "$a"; done
						json_close_array
					fi
				json_close_object
			elif [ "$security" = "reality" ]; then
				json_add_string "security" "reality"
				local sni fp pbk sid spx
				config_get sni "$section" "sni"
				config_get fp "$section" "fingerprint" "chrome"
				config_get pbk "$section" "public_key"
				config_get sid "$section" "short_id"
				config_get spx "$section" "spider_x"
				json_add_object "realitySettings"
					json_add_boolean "show" 0
					json_add_string "fingerprint" "$fp"
					[ -n "$sni" ] && json_add_string "serverName" "$sni"
					[ -n "$pbk" ] && json_add_string "publicKey" "$pbk"
					[ -n "$sid" ] && json_add_string "shortId" "$sid"
					[ -n "$spx" ] && json_add_string "spiderX" "$spx"
					[ "$insecure" -eq 1 ] && json_add_boolean "allowInsecure" 1
					if [ -n "$alpn" ]; then
						json_add_array "alpn"
						for a in $alpn; do json_add_string "" "$a"; done
						json_close_array
					fi
				json_close_object
			fi
			
			case "$transport" in
				tcp)
					local guise
					config_get guise "$section" "tcp_guise" "none"
					if [ "$guise" = "http" ]; then
						local path
						config_get path "$section" "http_path" "/"
						json_add_object "tcpSettings"
							json_add_object "header"
								json_add_string "type" "http"
								json_add_object "request"
									json_add_string "version" "1.1"
									json_add_string "method" "GET"
									json_add_array "path"
										json_add_string "$path"
									json_close_array
									json_add_object "headers"
										json_add_array "Host"
										config_list_foreach "$section" "http_host" _add_array_string
										json_close_array
										json_add_array "User-Agent"
											json_add_string "" "Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/108.0.0.0 Safari/537.36"
										json_close_array
									json_close_object
								json_close_object
							json_close_object
						json_close_object
					fi
				;;
				h2)
					local path host
					config_get path "$section" "h2_path" "/"
					config_get host "$section" "h2_host"
					json_add_object "httpSettings"
						[ -n "$path" ] && json_add_string "path" "$path"
						if [ -n "$host" ]; then
							json_add_array "host"
							for h in $host; do json_add_string "" "$h"; done
							json_close_array
						fi
					json_close_object
				;;
				ws)
					local path host
					config_get path "$section" "ws_path" "/"
					config_get host "$section" "ws_host"
					json_add_object "wsSettings"
						[ -n "$path" ] && json_add_string "path" "$path"
						[ -n "$host" ] && json_add_string "host" "$host"
					json_close_object
				;;
				grpc)
					local service
					config_get service "$section" "grpc_service_name"
					json_add_object "grpcSettings"
						[ -n "$service" ] && json_add_string "serviceName" "$service"
					json_close_object
				;;
			esac
		json_close_object
	json_close_object
}

add_routing_rule() {
	local section="$1"
	local enabled
	config_get_bool enabled "$section" "enabled" 0
	[ "$enabled" -eq 0 ] && return

	local server type
	config_get server "$section" "server"
	config_get type "$section" "type" "field"

	# Check if rule has any domain or ip entries
	local has_domain has_ip
	has_domain="$(uci -q get v2ray_adv.${section}.domain 2>/dev/null)"
	has_ip="$(uci -q get v2ray_adv.${section}.ip 2>/dev/null)"

	# Skip rules with no matching criteria
	[ -z "$has_domain" ] && [ -z "$has_ip" ] && return

	json_add_object
		json_add_string "type" "$type"
		json_add_string "outboundTag" "$server"

		if [ -n "$has_domain" ]; then
			json_add_array "domain"
			config_list_foreach "$section" "domain" _add_array_string
			json_close_array
		fi

		if [ -n "$has_ip" ]; then
			json_add_array "ip"
			config_list_foreach "$section" "ip" _add_array_string
			json_close_array
		fi
	json_close_object
}

setup_firewall() {
	stop_firewall

	local tproxy_inbound tproxy_port bypass_china proxy_ports
	config_get tproxy_inbound "tproxy" "inbound" ""

	# No transparent proxy configured
	[ -z "$tproxy_inbound" ] && return

	# Check if the selected inbound is enabled
	local inbound_enabled
	config_get_bool inbound_enabled "$tproxy_inbound" "enabled" 0
	[ "$inbound_enabled" -eq 0 ] && return

	# Read port from the selected inbound
	config_get tproxy_port "$tproxy_inbound" "port" "12345"
	config_get_bool bypass_china "tproxy" "bypass_china" 1
	config_get proxy_ports "tproxy" "proxy_ports" ""

	# IPSET setup
	if [ "$bypass_china" -eq 1 ]; then
		ipset -N cn hash:net 2>/dev/null
		# Try to load existing cn.ips if it exists, otherwise it might be empty until updated
		if [ -f "/etc/v2ray_adv/cn.ips" ]; then
			grep -v ':' /etc/v2ray_adv/cn.ips | sed 's/^/add cn /; s/$/ -exist/' | ipset restore 2>/dev/null
		fi
	fi
	ipset -N pass hash:net 2>/dev/null

	# Populate pass ipset from UCI config
	config_list_foreach "tproxy" "pass_ip" _add_ipset_pass

	# Automatically bypass all server addresses
	config_foreach _add_server_to_pass "server"

	# IPTABLES setup
	iptables -t nat -N V2RAY_ADV
	iptables -t nat -A V2RAY_ADV -m mark --mark 255 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 0.0.0.0/8 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 10.0.0.0/8 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 127.0.0.0/8 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 169.254.0.0/16 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 172.16.0.0/12 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 192.168.0.0/16 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 224.0.0.0/4 -j RETURN
	iptables -t nat -A V2RAY_ADV -d 240.0.0.0/4 -j RETURN

	# Direct rules from reference
	if [ "$bypass_china" -eq 1 ]; then
		iptables -t nat -A V2RAY_ADV -m set --match-set cn dst -j RETURN
	fi
	iptables -t nat -A V2RAY_ADV -m set --match-set pass dst -j RETURN

	# Redirect rules
	if [ -n "$proxy_ports" ]; then
		proxy_ports=$(echo "$proxy_ports" | tr '-' ':')
		iptables -t nat -A V2RAY_ADV -p tcp -m multiport --dports "$proxy_ports" -j REDIRECT --to-ports "$tproxy_port"
	else
		iptables -t nat -A V2RAY_ADV -p tcp -j REDIRECT --to-ports "$tproxy_port"
	fi
	
	iptables -t nat -A PREROUTING -p tcp -j V2RAY_ADV
	iptables -t nat -A OUTPUT -p tcp -j V2RAY_ADV
}

stop_firewall() {
	while iptables -t nat -D PREROUTING -p tcp -j V2RAY_ADV 2>/dev/null; do :; done
	while iptables -t nat -D OUTPUT -p tcp -j V2RAY_ADV 2>/dev/null; do :; done
	iptables -t nat -F V2RAY_ADV 2>/dev/null
	iptables -t nat -X V2RAY_ADV 2>/dev/null
	
	ipset flush cn 2>/dev/null
	ipset destroy cn 2>/dev/null
	ipset flush pass 2>/dev/null
	ipset destroy pass 2>/dev/null
}

start_service() {
	config_load v2ray_adv
	
	local enabled v2ray_path
	config_get_bool enabled "main" "enabled" 0
	config_get v2ray_path "main" "v2ray_path" "/usr/bin/v2ray"
	
	if [ "$enabled" -eq 0 ]; then
		stop_firewall
		return
	fi

	generate_json || return

	setup_firewall

	procd_open_instance
	procd_set_param command "$v2ray_path" run -c "$CONF_FILE"
	procd_set_param file /etc/config/v2ray_adv
	procd_set_param file "$CONF_FILE"
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	stop_firewall
}

service_triggers() {
	procd_add_reload_trigger "v2ray_adv"
}
